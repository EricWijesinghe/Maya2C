{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maya Chat",
  "version": "0.1.0",
  "identifier": "com.maya2c.chat",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Maya Chat",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Eric Wijesinghe",
    "copyright": "Copyright © 2026 Eric Wijesinghe. Apache License 2.0.",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
