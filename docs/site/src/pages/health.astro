---
// Live health of maya-testnet-1, from the public gateway. What the gateway does
// not expose is said on the page, not filled in. Halts come from
// public/health/incidents.json, which is committed by hand: the gateway has no
// halt-history method. Rendered at build, so the timeline needs no script.
// While the testnet is paused (data/network-state.ts) nothing is fetched: the
// page shows the last run from the stop report instead of a streak.
// U3 (2026-11-13): app-like layout on src/styles/app.css.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import SourceTip from "../components/SourceTip.astro";
import incidentsFile from "../../public/health/incidents.json";
import { testnet } from "../data/network-state";

type Incident = { id: string; start_utc: string; end_utc: string; start_kst: string; end_kst: string; cause: string; links: { label: string; href: string }[] };
const incidents = (incidentsFile as { incidents: Incident[] }).incidents;
const DAY = 86400;
const unix = (iso: string) => Math.floor(Date.parse(iso) / 1000);
const dur = (s: number) => `${Math.floor(s / DAY)} d ${Math.floor((s % DAY) / 3600)} h ${Math.floor((s % 3600) / 60)} min`;
const paused = testnet.paused;
const lastEnd = incidents.length ? unix(incidents[incidents.length - 1].end_utc) : 0;
const gateway = [["gHeight", "Height"], ["gAge", "Tip age"], ["gEpoch", "Epoch"], ["gRound", "Round"], ["gCommitted", "Committed round"], ["gCommittee", "Committee"]] as const;
const nav = [["now", "Now"], ["gateway", "Gateway"], ["incidents", "Incidents"]];
---

<StarlightPage frontmatter={{ title: paused ? "Testnet health (paused)" : "Live health", description: paused ? "maya-testnet-1's last recorded run and every halt, with what the public gateway does and does not show." : "Is maya-testnet-1 finalizing now, every halt since genesis, and what the public gateway does and does not show.", template: "splash" }}>
  <div class="not-content app" data-health data-paused={paused ? "" : undefined} data-last-end={lastEnd}>
    <nav class="app-subnav" aria-label="Sections">
      {nav.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      <p class="app-status"><span class={`app-dot${paused ? " warn" : ""}`} data-dot></span>{paused ? `Testnet paused since ${testnet.since}` : <span data-state>connecting…</span>}</p>
    </nav>

    <section class="app-section" id="now" aria-labelledby="h-now">
      {paused ? (
        <>
          <h2 id="h-now">Last run <SourceTip text="status.maya2c.dev /api/status before the stop, quoted in the stop report" href={testnet.report} /></h2>
          <dl class="app-grid">
            <div><dt>Ran for</dt><dd>{testnet.last.run}</dd></div>
            <div><dt>Halts in that run</dt><dd>{testnet.last.halts}</dd></div>
            <div><dt>Uptime</dt><dd>{(testnet.last.uptime * 100).toFixed(2)}%</dd></div>
            <div><dt>Last block</dt><dd>{testnet.last.height.toLocaleString("en-US")}</dd></div>
          </dl>
          <p class="app-note">Stopped on purpose at {testnet.last.at}. A streak counts again from the next genesis. <a href={testnet.report}>Stop report</a></p>
        </>
      ) : (
        <>
          <h2 id="h-now">No-halt streak</h2>
          <p class="streak" data-streak><span class="ui-skeleton app-skel" aria-label="loading"></span></p>
          <div class="streak-bar" aria-hidden="true"><span data-fill></span></div>
          <p class="app-note">Counted from the tip block's header timestamp back to the last recorded halt, not from your clock. {incidents.length ? `Last recorded halt ended ${incidents[incidents.length - 1].end_kst}.` : "No halts recorded."}</p>
        </>
      )}
    </section>

    <section class="app-section" id="gateway" aria-labelledby="h-gw">
      <h2 id="h-gw">What the gateway shows</h2>
      <dl class="app-grid">
        {gateway.map(([id, label]) => <div><dt>{label}</dt><dd data-k={id}>{paused ? "—" : <span class="ui-skeleton app-skel" aria-label="loading"></span>}</dd></div>)}
      </dl>
      <p class="app-note">This is the one node the gateway answers from (<code>get_bft_status</code>, <code>get_chain_info</code>). It is not a list of validators.{paused && " Paused: the gateway is down with the testnet."}</p>
      <p class="ui-state app-banner"><span class="ui-state__title">Per-validator state is not public</span><code>get_peers</code> returns <em>method not available through the gateway</em>, checked 2026-10-19. Until a public method exists, this page shows no validator list.</p>
    </section>

    <section class="app-section" id="incidents" aria-labelledby="h-inc">
      <h2 id="h-inc">Incident timeline</h2>
      <div class="ui-table-wrap app-table">
        <table class="ui-table">
          <thead><tr><th scope="col">Halt (KST)</th><th scope="col" class="ui-num">Lasted</th><th scope="col">Cause</th><th scope="col">Links</th></tr></thead>
          <tbody>
            {incidents.length === 0 && <tr><td colspan="4">No halts recorded.</td></tr>}
            {incidents.map((i) => (
              <tr>
                <td class="app-mono">{i.start_kst.replace(" KST", "")} to {i.end_kst.slice(11, 19)}</td>
                <td class="ui-num">{dur(unix(i.end_utc) - unix(i.start_utc))}</td>
                <td class="app-wrap">{i.cause}</td>
                <td class="app-wrap">{i.links.map((l, n) => <>{n > 0 && " · "}<a href={l.href}>{l.label}</a></>)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="app-note">Only halts recorded in <a href="/health/incidents.json">incidents.json</a> appear here. Full uptime history: status.maya2c.dev, back with the next genesis.</p>
    </section>
  </div>

  <script>
    import { RPC, fmt } from "../scripts/live";
    const root = document.querySelector<HTMLElement>("[data-health]");
    // Paused: the gateway is down on purpose; nothing to fetch.
    if (root && !root.hasAttribute("data-paused")) {
      const DAY = 86400;
      const lastEnd = Number(root.dataset.lastEnd) || 0;
      const set = (k: string, v: string) => { const el = root.querySelector(`[data-k="${k}"]`); if (el) el.textContent = v; };
      const dur = (s: number) => `${Math.floor(s / DAY)} d ${Math.floor((s % DAY) / 3600)} h ${Math.floor((s % 3600) / 60)} min ${Math.floor(s % 60)} s`;
      async function rpc<T>(method: string, params: unknown[] = []): Promise<T | null> {
        try {
          const r = await fetch(RPC, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ jsonrpc: "2.0", id: 1, method, params }), signal: AbortSignal.timeout(8000) });
          return (await r.json()).result ?? null;
        } catch { return null; }
      }
      const streak = root.querySelector("[data-streak]")!;
      const fill = root.querySelector<HTMLElement>("[data-fill]")!;
      async function load() {
        const info = await rpc<{ height: number }>("get_chain_info");
        const bft = await rpc<{ epoch: number; round: number; committed_round: number; committee: number }>("get_bft_status");
        root!.querySelector("[data-state]")!.textContent = info ? "live" : "gateway unreachable";
        root!.querySelector("[data-dot]")!.classList.toggle("ok", Boolean(info));
        if (info) {
          set("gHeight", fmt(info.height));
          const block = await rpc<{ header: { timestamp: number } }>("get_block_by_height", [info.height]);
          const tip = block?.header?.timestamp;
          if (tip) {
            const t0 = Date.now() / 1000;
            const tick = () => {
              const now = tip + (Date.now() / 1000 - t0);
              const s = Math.max(0, now - lastEnd);
              streak.textContent = dur(Math.floor(s));
              // The bar is the streak's share of one day, full once past a day.
              fill.style.width = `${Math.min(1, s / DAY) * 100}%`;
              set("gAge", `${Math.max(0, Math.round(Date.now() / 1000 - tip))} s`);
            };
            tick(); setInterval(tick, 1000);
          }
        }
        if (bft) { set("gEpoch", fmt(bft.epoch)); set("gRound", fmt(bft.round)); set("gCommitted", fmt(bft.committed_round)); set("gCommittee", fmt(bft.committee)); }
        if (!info) streak.textContent = "gateway unreachable";
        root!.querySelectorAll("[data-k] .app-skel").forEach((s) => { s.parentElement!.textContent = "—"; });
      }
      load();
    }
  </script>

  <style>
    .streak { margin: 0 0 var(--space-3); font: var(--weight-semibold) var(--type-display-2-size)/1.15 var(--font-sans); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--text); }
    .streak-bar { height: 4px; border-radius: var(--r-pill); background: var(--surface-3); overflow: hidden; }
    .streak-bar span { display: block; height: 100%; width: 0; background: var(--accent); transition: width var(--dur-3) var(--ease); }
  </style>
</StarlightPage>
