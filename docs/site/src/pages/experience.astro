---
// The "Experience Maya2C" hub: every part of the network as something to
// touch, one short line each, every item clickable through to the real
// thing (owner rule, 2026-10-04: graphics over text, click to learn more).
//
// Paused-aware (lane L04): while network-state.ts says the testnet is
// stopped, the page opens no socket and makes no call. The block orb shows
// the last block with its date, the playground shows a response recorded
// before the stop with its date, and the orbs that pointed at stopped hosts
// go to /stats/ and /health/, which carry the last reading. Nothing here is
// simulated, live or paused.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import DeliveryStates from "../components/DeliveryStates.astro";
import { testnet } from "../data/network-state.ts";
import { LOCAL_DEVNET_HREF, lastRun, recorded, runCaveats } from "../data/paused.ts";

const paused = testnet.paused;
const lastHeight = testnet.last.height.toLocaleString("en-US");
type Tone = "live" | "built" | "paused";
const live = (tone: Tone): Tone => (paused ? "paused" : tone);

const orbs: { title: string; line: string; href: string; tone: Tone }[] = [
  { title: "Fields", line: "Every field, and what is real in each", href: "/fields/", tone: "built" },
  paused
    ? { title: "Explorer", line: "Offline until next genesis; last figures here", href: "/stats/", tone: "paused" }
    : { title: "Explorer", line: "Every block, and what each transaction does", href: "https://explorer.maya2c.dev/", tone: "live" },
  paused
    ? { title: "Uptime", line: "The last recorded run, and every halt", href: "/health/", tone: "paused" }
    : { title: "Uptime", line: "Every halt, since genesis", href: "/health/", tone: "live" },
  { title: "Free test coins", line: paused ? "Offline until next genesis" : "Fund any address in one click", href: "/guides/testnet/#2-take-free-test-coins", tone: live("live") },
  { title: "Wallet", line: "Desktop and command line", href: "/guides/wallet/", tone: "built" },
  { title: "Maya2C Chat", line: "Post-quantum messenger; unaudited preview", href: "#xp-delivery", tone: "built" },
  { title: "API", line: paused ? "REST and JSON-RPC; public host paused" : "REST and JSON-RPC, public", href: "/guides/api/", tone: live("live") },
  { title: "Signatures", line: "How every transaction is signed", href: "/guides/signatures/", tone: "built" },
  { title: "Contracts", line: "WebAssembly on the chain", href: "/guides/contracts/", tone: "built" },
  { title: "Run a validator", line: "Join the committee", href: "/guides/validators/", tone: "built" },
  { title: "Invariants", line: "Rules the chain proves", href: "/reference/invariants/", tone: "built" },
  { title: "Source", line: "Every line, Apache-2.0", href: "https://github.com/EricWijesinghe/Maya2C", tone: "built" },
];

// Bytes. ML-DSA-65 and SLH-DSA-SHA2-128s from FIPS 204 / 205; Ed25519 from
// RFC 8032; the transfer is a one-output hybrid transfer as measured in
// docs/hybrid-signatures.md (13,215 B, the figure the README also gives).
const sizes = [
  { name: "Ed25519", note: "today's chains", bytes: 64 },
  { name: "ML-DSA-65", note: "post-quantum", bytes: 3309 },
  { name: "SLH-DSA", note: "hash-based backup", bytes: 7856 },
  { name: "Maya2C transfer", note: "both, signed", bytes: 13215 },
];
const maxBytes = Math.max(...sizes.map((s) => s.bytes));
// Keys tinted, values in the text colour. The body is our own constant from the
// stop report (no `<` or `&` in it), so building the spans here is safe.
const recordedHtml = JSON.stringify(JSON.parse(recorded.body), null, 2).replace(/"([a-z_]+)":/g, '<span class="k">"$1"</span>:');
---

<StarlightPage frontmatter={{ title: "Experience Maya2C", description: "Touch every part of the Maya2C network: blocks, real API responses, post-quantum signatures, wallet, chat and more.", template: "splash", prev: false, next: false }}>
  <div class="xp not-content" data-xp={paused ? "paused" : "live"}>
  <header class="xp-hero">
    <p class="xp-lede">A post-quantum layer-1 blockchain you can touch. Every part below opens the real thing in one tap.</p>
    <a class="xp-hero__orb" href="#xp-blocks" aria-label={paused ? `Last block ${lastHeight}, ${testnet.last.at}` : "Live blocks"}>
      <span class={`pulse-orb${paused ? " is-paused" : ""}`} id="blockOrb"><span id="blockNum">{paused ? lastHeight : "—"}</span></span>
      <span class="xp-hero__cap">{paused ? <>Last block · <time datetime={lastRun.stopIso}>{testnet.since}</time></> : "Each pulse is a finalized block"}</span>
    </a>
    <div class="xp-actions">
      {paused
        ? <a class="xp-cta" href={LOCAL_DEVNET_HREF}>Run a local devnet <span aria-hidden="true">→</span></a>
        : <a class="xp-cta" href="/guides/testnet/">Join the testnet <span aria-hidden="true">→</span></a>}
      {paused && <a class="xp-chip" href={testnet.report}><span class="xp-chip__dot" aria-hidden="true"></span>Testnet paused since {testnet.since}</a>}
    </div>
  </header>

  <section class="xp-live" aria-label={paused ? "Last reading" : "Live"}>
    <article class="orb-panel" id="xp-blocks">
      {paused ? (
        <>
          <h2>Last block</h2>
          <p>Block <b>{lastHeight}</b>, finalized at <time datetime={lastRun.stopIso}>{testnet.last.at}</time>. Paused on purpose; blocks pulse here again with the next genesis.</p>
          <figure class="run" aria-label="The last testnet run">
            <div class="run__figs"><b>{testnet.last.run}</b><span>{testnet.last.halts} halts · blocks 0 → {lastHeight}</span></div>
            <div class="run__bar" aria-hidden="true"></div>
            <div class="run__ends">
              <span><b>Genesis</b><time datetime={lastRun.genesisIso}>{lastRun.genesisAt}</time></span>
              <span><b>Stopped</b><time datetime={lastRun.stopIso}>{testnet.last.at}</time></span>
            </div>
            <figcaption>{runCaveats.halt[0].toUpperCase() + runCaveats.halt.slice(1)}; {lastRun.stopNote}.</figcaption>
          </figure>
          <a href={testnet.report}>Why it stopped →</a>
        </>
      ) : (
        <>
          <h2>Live blocks</h2>
          <p id="blockState">Connecting to maya-testnet-1…</p>
          <a href="https://explorer.maya2c.dev/">Open the explorer →</a>
        </>
      )}
    </article>

    <article class="orb-panel" id="xp-rpc">
      <h2>Call the network</h2>
      {paused ? (
        <>
          <p>Live calls return with the next genesis. This is the last answer the status service gave before the stop.</p>
          <figure class="rec">
            <figcaption class="rec-tag"><span class="rec-dot" aria-hidden="true"></span>Recorded {recorded.at.slice(0, 10)} · not live</figcaption>
            <pre id="rpcOut" tabindex="0" aria-label={`Response recorded ${recorded.at}`} set:html={recordedHtml} />
          </figure>
          <p class="rec-src">From <code>{recorded.source}</code>, {recorded.at}.</p>
          <a href={testnet.report}>Where this was recorded →</a>
        </>
      ) : (
        <>
          <div class="pills" role="group" aria-label="JSON-RPC method">
            <button type="button" data-m="get_chain_info">Chain info</button>
            <button type="button" data-m="get_bft_status">Consensus</button>
            <button type="button" data-m="get_checkpoint">Checkpoint</button>
          </div>
          <pre id="rpcOut" tabindex="0" aria-live="polite">Pick a call. It runs against rpc.maya2c.dev.</pre>
          <a href="/guides/api/">Learn more →</a>
        </>
      )}
    </article>
  </section>

  <section class="xp-sizes" aria-label="Signature sizes">
    <h2>Why post-quantum is heavier</h2>
    <div class="bubbles">
      {sizes.map((s) => (
        <figure class="size" style={`--d:${Math.max(18, Math.sqrt(s.bytes / maxBytes) * 180)}px`}>
          <span class="ball" aria-hidden="true"></span>
          <figcaption><b>{s.name}</b><span>{s.bytes.toLocaleString("en-US")} B</span><small>{s.note}</small></figcaption>
        </figure>
      ))}
    </div>
    <p class="xp-src">Sizes from FIPS 204, FIPS 205 and RFC 8032; the transfer from <a href="/reference/hybrid-signatures/">hybrid signatures</a>.</p>
    <a href="/guides/signatures/">How Maya2C signs →</a>
  </section>

  <section class="xp-delivery" id="xp-delivery" aria-label="Chat delivery">
    <h2>Did it arrive?</h2>
    <DeliveryStates />
  </section>

  <section class="xp-orbs" aria-label="Everything you can try">
    <h2>Try every part</h2>
    <div class="orb-grid">
      {orbs.map((o) => (
        <a class={`orb tone-${o.tone}`} href={o.href}>
          <span class="glow" aria-hidden="true"></span>
          {o.tone === "paused" && <svg class="orb-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.5" /><rect x="14" y="5" width="4" height="14" rx="1.5" /></svg>}
          <b>{o.title}</b>
          <span>{o.line}</span>
        </a>
      ))}
    </div>
    <p class="legend">
      {!paused && <span class="legend-item"><span class="sw tone-live" aria-hidden="true"></span>live now</span>}
      {paused && <span class="legend-item"><span class="sw tone-paused" aria-hidden="true"></span>paused until next genesis</span>}
      <span class="legend-item"><span class="sw tone-built" aria-hidden="true"></span>built and tested</span>
    </p>
  </section>
  </div>
</StarlightPage>

<script>
  // Runs only when the page was built live: a paused build has no #blockState
  // and no method buttons, and this returns before opening anything.
  const root = document.querySelector<HTMLElement>(".xp");
  if (root?.dataset.xp === "live") {
    const fmt = (n: number) => n.toLocaleString("en-US");
    const orb = document.getElementById("blockOrb");
    const num = document.getElementById("blockNum");
    const state = document.getElementById("blockState");

    // Real blocks only. When the stream drops, say so and retry; never invent.
    let retry = 1000;
    const stream = () => {
      const ws = new WebSocket("wss://explorer.maya2c.dev/ws/blocks");
      ws.onopen = () => { retry = 1000; if (state) state.textContent = "Live. Each pulse is a finalized block."; };
      ws.onmessage = (ev) => {
        try {
          const b = JSON.parse(ev.data);
          if (!b.height || !num || !orb) return;
          num.textContent = fmt(b.height);
          orb.classList.remove("beat");
          void orb.offsetWidth;
          orb.classList.add("beat");
        } catch { /* a malformed frame is skipped */ }
      };
      ws.onclose = () => {
        if (state) state.textContent = "Reconnecting…";
        setTimeout(stream, retry);
        retry = Math.min(retry * 2, 30000);
      };
      ws.onerror = () => ws.close();
    };
    stream();

    const out = document.getElementById("rpcOut");
    document.querySelectorAll<HTMLButtonElement>("#xp-rpc button").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!out) return;
        out.textContent = "Calling " + btn.dataset.m + "…";
        try {
          const r = await fetch("https://rpc.maya2c.dev/rpc", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: btn.dataset.m, params: [] }),
          });
          const body = await r.json();
          let text = JSON.stringify(body.result ?? body.error, null, 2);
          // Signatures are kilobytes of hex: show their start, not a wall.
          text = text.replace(/"([0-9a-f]{96})[0-9a-f]+"/g, '"$1…"');
          out.textContent = text;
        } catch {
          out.textContent = "The network did not answer. Try again in a moment.";
        }
      });
    });
  }
</script>

<style>
  /* Every colour here is a token or a mix of tokens (the literals check in
     paused-truth.test.ts). Depth is one recipe per theme: dark gets light (a
     lit rim and a halo), light gets depth (a white core, a saturated rim and a
     coloured drop shadow), because a halo on a white page reads as a smudge. */
  .xp {
    --xp-spec: color-mix(in srgb, var(--accent-grad-from) 45%, var(--text));
    --xp-glow: color-mix(in srgb, var(--accent) 70%, transparent);
    --xp-orb-shadow: 0 0 60px -10px var(--xp-glow);
    --xp-orb-shadow-beat: 0 0 90px -4px color-mix(in srgb, var(--bronze) 85%, transparent);
    --xp-wash: color-mix(in srgb, var(--accent) 7%, transparent);
    --xp-panel-edge: var(--glass-edge);
    /* Working orbs: a teal core that holds AA for text-2 at the centre. */
    --xp-orb-fill: radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--accent) 45%, var(--surface-1)) 0, color-mix(in srgb, var(--accent) 18%, var(--surface-1)) 40%, color-mix(in srgb, var(--accent) 8%, var(--surface-1)) 75%);
    --xp-orb-ring: 2px solid color-mix(in srgb, var(--accent) 55%, transparent);
    --xp-orb-rest: inset 0 1px 0 var(--accent-highlight), 0 0 32px -10px color-mix(in srgb, var(--accent) 60%, transparent);
    /* Paused orbs: bronze, a visible dashed ring and a pause glyph. */
    --xp-pause-fill: radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--bronze) 40%, var(--surface-1)) 0, color-mix(in srgb, var(--bronze) 16%, var(--surface-1)) 40%, color-mix(in srgb, var(--bronze) 7%, var(--surface-1)) 75%);
    --xp-pause-ring: 2px dashed var(--warn);
    --xp-pause-rest: inset 0 1px 0 var(--accent-highlight), 0 0 28px -12px color-mix(in srgb, var(--bronze) 70%, transparent);
    --xp-orb-line: color-mix(in srgb, var(--text) 80%, var(--text-2));
    min-width: 0;
  }
  :global(:root[data-theme="light"]) .xp {
    --xp-spec: color-mix(in srgb, var(--accent-grad-from) 45%, var(--surface-1));
    --xp-orb-shadow: 0 18px 40px -18px color-mix(in srgb, var(--accent) 55%, transparent), 0 2px 6px -2px color-mix(in srgb, var(--accent) 30%, transparent);
    --xp-orb-shadow-beat: 0 22px 48px -16px color-mix(in srgb, var(--bronze) 60%, transparent);
    --xp-wash: color-mix(in srgb, var(--accent) 14%, transparent);
    --xp-panel-edge: color-mix(in srgb, var(--accent) 22%, var(--border-strong));
    --xp-orb-fill: radial-gradient(circle at 30% 25%, var(--surface-1) 0 45%, color-mix(in srgb, var(--accent) 16%, var(--surface-1)) 100%);
    --xp-orb-ring: 2px solid var(--accent);
    --xp-orb-rest: 0 14px 28px -14px color-mix(in srgb, var(--accent) 65%, transparent), 0 2px 6px -2px color-mix(in srgb, var(--accent) 35%, transparent);
    --xp-pause-fill: radial-gradient(circle at 30% 25%, var(--surface-1) 0 45%, color-mix(in srgb, var(--bronze) 18%, var(--surface-1)) 100%);
    --xp-pause-ring: 2px dashed var(--bronze);
    --xp-pause-rest: 0 14px 28px -14px color-mix(in srgb, var(--bronze) 65%, transparent), 0 2px 6px -2px color-mix(in srgb, var(--bronze) 35%, transparent);
    --xp-orb-line: var(--text-2);
  }

  /* Hero: what this is, the last block as the first visual, and the one thing
     a visitor can do today. */
  .xp-hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); margin: 0 0 var(--space-8); }
  .xp-lede { margin: 0; max-width: 40rem; color: var(--text-2); font-size: clamp(var(--type-body-lg-size), 2.2vw, var(--type-title-3-size)); line-height: var(--line-body); }
  .xp-hero__orb { justify-self: center; display: grid; justify-items: center; gap: var(--space-2); color: var(--text-2); text-decoration: none; font-size: var(--type-body-sm-size); border-radius: var(--r-lg); padding: var(--space-2); }
  .xp-hero__orb:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .xp-hero__cap time { color: var(--text); font-variant-numeric: tabular-nums; }
  @media (min-width: 1024px) {
    .xp-hero { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "lede orb" "actions orb"; align-items: center; column-gap: var(--space-10); }
    .xp-lede { grid-area: lede; align-self: end; }
    .xp-actions { grid-area: actions; align-self: start; }
    .xp-hero__orb { grid-area: orb; }
  }
  .xp-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .xp-cta { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 48px; padding: 0 var(--space-5); border-radius: var(--r-pill); background: linear-gradient(180deg, var(--accent-grad-from), var(--accent-grad-to)); color: var(--on-accent); font-weight: var(--weight-semibold); font-size: var(--type-body-lg-size); text-decoration: none; box-shadow: var(--xp-orb-shadow); transition: transform var(--dur-2) var(--ease); }
  .xp-cta:hover { transform: translateY(-1px); }
  .xp-chip { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; padding: 0 var(--space-4); border-radius: var(--r-pill); border: 1px dashed color-mix(in srgb, var(--warn) 70%, transparent); background: color-mix(in srgb, var(--warn) 12%, transparent); color: var(--text); font-size: var(--type-body-size); font-weight: var(--weight-medium); text-decoration: none; }
  .xp-chip__dot { width: 8px; height: 8px; flex: none; border-radius: 50%; background: var(--warn); }
  .xp-cta:focus-visible, .xp-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  /* Equal-height cards; each card's link sits on its bottom edge. */
  .xp-live { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); align-items: stretch; }
  .orb-panel { background: linear-gradient(160deg, var(--xp-wash), transparent 60%), var(--glass); border: 1px solid var(--xp-panel-edge); border-radius: var(--r-l); padding: clamp(var(--space-5), 4vw, var(--space-8)); backdrop-filter: var(--glass-blur); min-width: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .orb-panel > a { margin-top: auto; }
  .orb-panel h2, .xp-sizes h2, .xp-delivery h2, .xp-orbs h2 { margin: 0; color: var(--text); font: var(--type-title-2-weight) clamp(var(--type-title-3-size), 2.6vw, var(--type-title-1-size))/var(--type-title-2-line) var(--font-sans); letter-spacing: var(--type-title-2-tracking); }
  .orb-panel p { margin: 0; color: var(--text-2); }
  .orb-panel > * { min-width: 0; }
  .orb-panel p time { white-space: nowrap; }
  .orb-panel p b { color: var(--text); font-variant-numeric: tabular-nums; }
  .orb-panel > a, .xp-sizes > a { color: var(--accent-text); font-weight: var(--weight-semibold); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }

  .pulse-orb { position: relative; width: clamp(132px, 36vw, 176px); aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; margin: var(--space-3);
    background: radial-gradient(circle at 34% 30%, var(--xp-spec) 0 12%, var(--accent-grad-from) 34%, var(--accent-grad-to) 72%, var(--accent) 100%);
    box-shadow: var(--xp-orb-shadow); }
  .pulse-orb span { position: relative; font: var(--weight-medium) clamp(var(--type-body-lg-size), 5vw, var(--type-title-3-size))/1 var(--font-mono); color: var(--on-accent); font-variant-numeric: tabular-nums; }
  /* Paused: the same full-colour orb, at rest. Rest is shown by form, not by
     greying the brand: an amber dashed ring and a slow breathing halo. No beat,
     because no block arrived. */
  .pulse-orb.is-paused::before { content: ""; position: absolute; inset: -10px; border-radius: 50%; border: 2px dashed var(--warn); }
  .pulse-orb.is-paused::after { content: ""; position: absolute; inset: -4px; border-radius: 50%; box-shadow: 0 0 0 8px color-mix(in srgb, var(--accent) 14%, transparent); animation: xp-breathe 4.8s ease-in-out infinite; }
  @keyframes xp-breathe { 0%, 100% { opacity: .25; } 50% { opacity: 1; } }
  .pulse-orb.beat { animation: beat 1.1s var(--spring); }
  @keyframes beat { 0% { transform: scale(1); } 30% { transform: scale(1.08); box-shadow: var(--xp-orb-shadow-beat); } 100% { transform: scale(1); } }

  /* The last run as a line from genesis to the stop, from committed data. */
  .run { margin: var(--space-2) 0 0; display: grid; gap: var(--space-3); padding: var(--space-4); border-radius: var(--r-m); background: var(--well); }
  .run__figs { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-1) var(--space-3); }
  .run__figs b { color: var(--text); font: var(--type-title-3-weight) var(--type-title-3-size)/var(--type-title-3-line) var(--font-sans); font-variant-numeric: tabular-nums; }
  .run__figs span { color: var(--text-2); font-size: var(--type-body-sm-size); font-variant-numeric: tabular-nums; }
  .run__bar { position: relative; height: 8px; margin-inline: 8px; border-radius: var(--r-pill); background: linear-gradient(90deg, var(--accent-grad-from), var(--accent-grad-to) 70%, var(--bronze)); }
  .run__bar::before, .run__bar::after { content: ""; position: absolute; top: 50%; width: 16px; height: 16px; margin-top: -8px; border-radius: 50%; box-sizing: border-box; }
  .run__bar::before { left: -8px; background: var(--accent-grad-from); box-shadow: 0 0 0 3px var(--well); }
  .run__bar::after { right: -8px; background: var(--well); border: 2px dashed var(--warn); }
  .run__ends { display: flex; justify-content: space-between; gap: var(--space-3); }
  .run__ends span { display: grid; gap: 2px; color: var(--text-2); font-size: var(--type-body-sm-size); }
  .run__ends span:last-child { text-align: right; }
  .run__ends b { color: var(--text); font-weight: var(--weight-semibold); }
  .run figcaption { color: var(--text-2); font-size: var(--type-body-sm-size); }

  .pills { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .pills button { font: var(--weight-semibold) var(--type-body-size)/1 var(--font-sans); color: var(--text); background: var(--accent-subtle); border: 1px solid var(--glass-edge); border-radius: var(--r-pill); min-height: 44px; padding: var(--space-3) var(--space-4); cursor: pointer; transition: transform var(--dur-3) var(--spring), background var(--dur-2); }
  .pills button:hover { transform: scale(1.05); background: color-mix(in srgb, var(--accent) 26%, transparent); }

  /* The recorded response wears its date on its own top edge, so nobody reads it as live. */
  .rec { margin: 0; display: grid; min-width: 0; }
  .rec-tag { justify-self: start; display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-1) var(--space-3); border: 1px solid color-mix(in srgb, var(--warn) 60%, transparent); border-bottom: 0; border-radius: var(--r-m) var(--r-m) 0 0; background: color-mix(in srgb, var(--warn) 16%, var(--well)); color: var(--text); font-size: var(--type-body-sm-size); font-weight: var(--weight-semibold); }
