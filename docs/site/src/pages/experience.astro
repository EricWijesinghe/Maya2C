---
// The "Experience Maya2C" hub: every part of the network as something to
// touch, one short line each, every item clickable through to the real
// thing (owner rule, 2026-10-04: graphics over text, click to learn more).
// All data is live from the public endpoints; nothing here is simulated.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const orbs = [
  { title: "Explorer", line: "Every block, as it finalizes", href: "https://explorer.maya2c.dev/", tone: "live" },
  { title: "Uptime", line: "Every halt, since genesis", href: "https://status.maya2c.dev/", tone: "live" },
  { title: "Free test coins", line: "Fund any address in one click", href: "/guides/testnet/#2-take-free-test-coins", tone: "live" },
  { title: "Wallet", line: "Desktop and command line", href: "/guides/wallet/", tone: "built" },
  { title: "Maya Chat", line: "Post-quantum messenger", href: "https://github.com/EricWijesinghe/Maya2C/releases/tag/node-v0.1.0-testnet.1", tone: "built" },
  { title: "API", line: "REST and JSON-RPC, public", href: "/guides/api/", tone: "live" },
  { title: "Signatures", line: "How every transaction is signed", href: "/guides/signatures/", tone: "built" },
  { title: "Contracts", line: "WebAssembly on the chain", href: "/guides/contracts/", tone: "built" },
  { title: "Run a validator", line: "Join the committee", href: "/guides/validators/", tone: "built" },
  { title: "Invariants", line: "Rules the chain proves", href: "/reference/invariants/", tone: "built" },
  { title: "Source", line: "Every line, Apache-2.0", href: "https://github.com/EricWijesinghe/Maya2C", tone: "built" },
];

// Bytes. ML-DSA-65 and SLH-DSA-SHA2-128s from FIPS 204 / 205; Ed25519 from
// RFC 8032; the hybrid transfer is the size the faucet budgets for.
const sizes = [
  { name: "Ed25519", note: "today's chains", bytes: 64 },
  { name: "ML-DSA-65", note: "post-quantum", bytes: 3309 },
  { name: "SLH-DSA", note: "hash-based backup", bytes: 7856 },
  { name: "Maya2C transfer", note: "both, signed", bytes: 13000 },
];
const maxBytes = Math.max(...sizes.map((s) => s.bytes));
---

<StarlightPage frontmatter={{ title: "Experience Maya2C", description: "Touch every part of the Maya2C network: live blocks, real API calls, post-quantum signatures, wallet, chat and more.", template: "splash" }}>
  <section class="xp-live" aria-label="Live">
    <article class="orb-panel" id="xp-blocks">
      <div class="pulse-orb" id="blockOrb" aria-hidden="true"><span id="blockNum">—</span></div>
      <h2>Live blocks</h2>
      <p id="blockState">Connecting to maya-testnet-1…</p>
      <a href="https://explorer.maya2c.dev/">Open the explorer →</a>
    </article>

    <article class="orb-panel" id="xp-rpc">
      <h2>Call the network</h2>
      <div class="pills" role="group" aria-label="JSON-RPC method">
        <button type="button" data-m="get_chain_info">Chain info</button>
        <button type="button" data-m="get_bft_status">Consensus</button>
        <button type="button" data-m="get_checkpoint">Checkpoint</button>
      </div>
      <pre id="rpcOut" aria-live="polite">Pick a call. It runs against rpc.maya2c.dev.</pre>
      <a href="/guides/api/">Learn more →</a>
    </article>
  </section>

  <section class="xp-sizes" aria-label="Signature sizes">
    <h2>Why post-quantum is heavier</h2>
    <div class="bubbles">
      {sizes.map((s) => (
        <figure class="size" style={`--d:${Math.max(18, Math.sqrt(s.bytes / maxBytes) * 180)}px`}>
          <span class="ball" aria-hidden="true"></span>
          <figcaption><b>{s.name}</b><span>{s.bytes.toLocaleString("en-US")} B</span><small>{s.note}</small></figcaption>
        </figure>
      ))}
    </div>
    <a href="/guides/signatures/">How Maya2C signs →</a>
  </section>

  <section class="xp-orbs" aria-label="Everything you can try">
    <h2>Try every part</h2>
    <div class="orb-grid">
      {orbs.map((o) => (
        <a class={`orb tone-${o.tone}`} href={o.href}>
          <span class="glow" aria-hidden="true"></span>
          <b>{o.title}</b>
          <span>{o.line}</span>
        </a>
      ))}
    </div>
    <p class="legend"><span class="tone-live"></span>live now <span class="tone-built"></span>built and tested</p>
  </section>
</StarlightPage>

<script>
  const fmt = (n: number) => n.toLocaleString("en-US");
  const orb = document.getElementById("blockOrb");
  const num = document.getElementById("blockNum");
  const state = document.getElementById("blockState");

  // Real blocks only. When the stream drops, say so and retry; never invent.
  let retry = 1000;
  function stream() {
    const ws = new WebSocket("wss://explorer.maya2c.dev/ws/blocks");
    ws.onopen = () => { retry = 1000; if (state) state.textContent = "Live. Each pulse is a finalized block."; };
    ws.onmessage = (ev) => {
      try {
        const b = JSON.parse(ev.data);
        if (!b.height || !num || !orb) return;
        num.textContent = fmt(b.height);
        orb.classList.remove("beat");
        void orb.offsetWidth;
        orb.classList.add("beat");
      } catch { /* a malformed frame is skipped */ }
    };
    ws.onclose = () => {
      if (state) state.textContent = "Reconnecting…";
      setTimeout(stream, retry);
      retry = Math.min(retry * 2, 30000);
    };
    ws.onerror = () => ws.close();
  }
  stream();

  const out = document.getElementById("rpcOut");
  document.querySelectorAll<HTMLButtonElement>("#xp-rpc button").forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!out) return;
      out.textContent = "Calling " + btn.dataset.m + "…";
      try {
        const r = await fetch("https://rpc.maya2c.dev/rpc", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: btn.dataset.m, params: [] }),
        });
        const body = await r.json();
        let text = JSON.stringify(body.result ?? body.error, null, 2);
        // Signatures are kilobytes of hex: show their start, not a wall.
        text = text.replace(/"([0-9a-f]{96})[0-9a-f]+"/g, '"$1…"');
        out.textContent = text;
      } catch {
        out.textContent = "The network did not answer. Try again in a moment.";
      }
    });
  });
</script>

<style>
  .xp-live { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 8px; }
  .orb-panel { background: var(--glass); border: 1px solid var(--glass-edge); border-radius: var(--r-l); padding: 28px; backdrop-filter: blur(16px); min-width: 0; display: grid; gap: 12px; align-content: start; }
  .orb-panel h2, .xp-sizes h2, .xp-orbs h2 { font: 300 clamp(24px, 3vw, 34px)/1.15 var(--display); letter-spacing: -0.02em; margin: 0; }
  .orb-panel p { margin: 0; color: var(--muted); }
  .orb-panel a, .xp-sizes > a { color: var(--accent-text); font-weight: 600; text-decoration: none; }
  .pulse-orb { width: 150px; height: 150px; border-radius: 50%; display: grid; place-items: center; margin-inline: auto;
    background: radial-gradient(circle at 34% 30%, #fff 0 6%, var(--cherenkov-hi) 18%, var(--cherenkov) 48%, var(--iris-a) 80%, transparent 82%);
    box-shadow: 0 0 60px -10px rgba(91,140,255,.7); }
  .pulse-orb span { font: 300 22px/1 var(--mono); color: #fff; text-shadow: 0 1px 8px rgba(0,0,0,.6); font-variant-numeric: tabular-nums; }
  .pulse-orb.beat { animation: beat 1.1s var(--spring); }
  @keyframes beat { 0% { transform: scale(1); } 30% { transform: scale(1.08); box-shadow: 0 0 90px -4px rgba(124,108,255,.9); } 100% { transform: scale(1); } }
  .pills { display: flex; gap: 8px; flex-wrap: wrap; }
  .pills button { font: 600 14px/1 var(--sans); color: var(--text); background: rgba(91,140,255,.14); border: 1px solid var(--glass-edge); border-radius: var(--r-pill); padding: 11px 16px; cursor: pointer; transition: transform .4s var(--spring), background .3s; }
  .pills button:hover { transform: scale(1.05); background: rgba(91,140,255,.26); }
  #rpcOut { margin: 0; min-height: 150px; max-height: 260px; overflow: auto; border-radius: var(--r-m); background: var(--well); padding: 16px; font: 400 12.5px/1.5 var(--mono); color: var(--accent-text); white-space: pre-wrap; overflow-wrap: anywhere; }
  .xp-sizes, .xp-orbs { margin-top: 56px; display: grid; gap: 22px; }
  .bubbles { display: flex; align-items: flex-end; justify-content: space-around; gap: 16px; flex-wrap: wrap; padding: 24px; border-radius: var(--r-l); background: var(--glass); border: 1px solid var(--glass-edge); }
  .size { margin: 0; display: grid; justify-items: center; gap: 12px; }
  .size .ball { width: var(--d); height: var(--d); border-radius: 50%; background: radial-gradient(circle at 34% 30%, #fff 0 5%, var(--cherenkov-hi) 16%, var(--cherenkov) 50%, var(--iris-a) 85%); box-shadow: 0 0 40px -12px rgba(91,140,255,.8); }
  .size:first-child .ball { background: radial-gradient(circle at 34% 30%, #fff 0 8%, #9aa1b8 40%, #4a5068); box-shadow: none; }
  .size figcaption { display: grid; justify-items: center; gap: 2px; text-align: center; }
  .size b { font: 400 15px var(--display); }
  .size span { font: 400 14px var(--mono); color: var(--accent-text); }
  .size small { color: var(--muted); font-size: 12.5px; }
  .orb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 18px; }
  .orb { position: relative; aspect-ratio: 1; border-radius: 50%; display: grid; place-content: center; text-align: center; gap: 6px; padding: 18px; color: var(--text); text-decoration: none; background: radial-gradient(circle at 34% 28%, var(--orb-hi), var(--orb-lo) 60%); border: 1.5px solid var(--glass-edge); transition: transform .5s var(--spring), border-color .3s; }
  .orb b { font: 400 17px/1.2 var(--display); }
  .orb span:not(.glow) { font-size: 13px; color: var(--muted); }
  .orb .glow { position: absolute; inset: -1px; border-radius: 50%; opacity: 0; box-shadow: 0 0 40px -6px rgba(91,140,255,.8); transition: opacity .3s; }
  .orb:hover, .orb:focus-visible { transform: scale(1.06); border-color: var(--cherenkov); }
  .orb:hover .glow, .orb:focus-visible .glow { opacity: 1; }
  .orb.tone-live { border-color: rgba(69,224,160,.55); }
  .legend { display: flex; gap: 18px; align-items: center; justify-content: center; color: var(--muted); font-size: 14px; margin: 0; }
  .legend span { display: inline-block; width: 12px; height: 12px; border-radius: 50%; margin-right: -10px; }
  .legend .tone-live { border: 2px solid var(--verified); }
  .legend .tone-built { border: 2px solid var(--glass-edge); }
  @media (max-width: 760px) { .xp-live { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .pulse-orb.beat, .orb, .pills button { animation: none; transition: none; } }
</style>
