---
// Interactive ecosystem: the chain in the centre, the apps around it. Tap an
// app to see what it does, whether it exists today, and what you can do with
// it now. One markup for both layouts: an orbit from 760 px, a tappable grid
// on phones. Statuses come from src/data/ecosystem-apps.ts.
import { ecoApps } from "../data/ecosystem-apps";
const count = (s: string) => ecoApps.filter((a) => a.status === s).length;
const placed = ecoApps.map((a, i) => {
  const t = (i / ecoApps.length) * Math.PI * 2 - Math.PI / 2;
  return { ...a, x: 50 + 40 * Math.cos(t), y: 50 + 40 * Math.sin(t) };
});
const label = { built: "Built", research: "Research", planned: "Planned" } as const;
---

<section class="not-content eco" data-eco aria-label="Explore the Maya2C ecosystem">
  <div class="eco-filters" role="group" aria-label="Show apps by status">
    <button type="button" data-filter="all" aria-pressed="true">All <b>{ecoApps.length}</b></button>
    <button type="button" data-filter="built" aria-pressed="false"><i class="dot built"></i>Built <b>{count("built")}</b></button>
    <button type="button" data-filter="research" aria-pressed="false"><i class="dot research"></i>Research <b>{count("research")}</b></button>
    <button type="button" data-filter="planned" aria-pressed="false"><i class="dot planned"></i>Planned <b>{count("planned")}</b></button>
  </div>

  <div class="eco-stage">
    <svg class="eco-spokes" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <circle cx="50" cy="50" r="40" class="orbit" />
      {placed.map((a) => <line x1="50" y1="50" x2={a.x} y2={a.y} class={`spoke ${a.status}`} data-spoke={a.id} />)}
    </svg>
    <div class="eco-core" aria-hidden="true"><strong>Maya2C</strong><span>post-quantum L1</span></div>
    <ul class="eco-apps">
      {placed.map((a) => (
        <li style={`--x:${a.x.toFixed(2)}%;--y:${a.y.toFixed(2)}%`}>
          <button type="button" class={`app ${a.status}`} data-app={a.id} aria-controls="eco-detail" aria-pressed="false">
            <span class="ic" aria-hidden="true">{a.icon}</span>
            <span class="nm">{a.name}</span>
            <span class="nt">{a.note}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <div id="eco-detail" class="eco-detail" aria-live="polite">
    <p class="hint">Tap any app to explore it. <span data-seen>0</span> of {ecoApps.length} explored.</p>
    {ecoApps.map((a) => (
      <article data-detail={a.id} hidden>
        <header><span class="ic big" aria-hidden="true">{a.icon}</span><h3>{a.name}</h3><span class={`chip ${a.status}`}>{label[a.status]}</span></header>
        <p>{a.what}</p>
        <p class="now"><strong>Today:</strong> {a.now}</p>
        <a class="go" href={a.href}>Open {a.name} →</a>
      </article>
    ))}
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-eco]")) {
    const apps = [...root.querySelectorAll<HTMLButtonElement>("[data-app]")];
    const details = [...root.querySelectorAll<HTMLElement>("[data-detail]")];
    const spokes = [...root.querySelectorAll<SVGLineElement>("[data-spoke]")];
    const filters = [...root.querySelectorAll<HTMLButtonElement>("[data-filter]")];
    const seenOut = root.querySelector<HTMLElement>("[data-seen]")!;
    const seen = new Set<string>();

    const select = (id: string) => {
      apps.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.app === id)));
      details.forEach((d) => (d.hidden = d.dataset.detail !== id));
      spokes.forEach((s) => s.classList.toggle("lit", s.dataset.spoke === id));
      // On phones the card sits below the grid: bring it into view.
      if (matchMedia("(max-width: 759px)").matches) root.querySelector("#eco-detail")!.scrollIntoView({ block: "nearest", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      seen.add(id);
      seenOut.textContent = String(seen.size);
      document.dispatchEvent(new CustomEvent("maya:quest", { detail: { id: "eco", count: seen.size } }));
    };
    apps.forEach((b) => b.addEventListener("click", () => select(b.dataset.app!)));

    filters.forEach((f) => f.addEventListener("click", () => {
      const want = f.dataset.filter!;
      filters.forEach((x) => x.setAttribute("aria-pressed", String(x === f)));
      apps.forEach((b) => b.classList.toggle("dim", want !== "all" && !b.classList.contains(want)));
    }));
  }
</script>

<style>
  .eco { margin: 1.5rem auto 2.5rem; max-width: 46rem; }
  .eco-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 1rem; }
  .eco-filters button { background: var(--glass); border: 1px solid var(--glass-edge); color: var(--text); border-radius: 999px; padding: 0.4rem 0.9rem; font: inherit; font-size: 0.85rem; cursor: pointer; min-height: 44px; }
  .eco-filters button[aria-pressed="true"] { border-color: var(--cherenkov); box-shadow: 0 0 0 1px var(--cherenkov) inset; }
  .eco-filters b { color: var(--cherenkov-hi); margin-left: 0.25rem; }
  .dot { display: inline-block; width: 0.6rem; height: 0.6rem; border-radius: 50%; margin-right: 0.4rem; border: 2px solid; }
  .dot.built { border-color: var(--cherenkov); background: var(--cherenkov); }
  .dot.research { border-color: var(--gold); border-style: dashed; }
  .dot.planned { border-color: var(--muted); border-style: dotted; }

  /* Phones: core on top, apps in a tappable grid. */
  .eco-stage { position: relative; }
  .eco-spokes { display: none; }
  .eco-core { margin: 0 auto 1rem; width: 8.5rem; height: 8.5rem; border-radius: 50%; display: grid; place-content: center; text-align: center;
    background: radial-gradient(circle, #9ff3f6 0%, #1fb5c2 58%, rgba(201, 168, 106, 0.25) 72%, transparent 73%); box-shadow: 0 0 2.5rem rgba(31, 181, 194, 0.35); animation: breathe 5s ease-in-out infinite; }
  .eco-core strong { font-size: 1.25rem; color: #02161a; }
  .eco-core span { font-size: 0.7rem; color: #053139; }
  .eco-apps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .eco-apps li { margin: 0; }
  .app { width: 100%; min-height: 6rem; display: grid; justify-items: center; align-content: center; gap: 0.15rem; padding: 0.5rem 0.25rem;
    background: var(--glass); border: 2px solid var(--glass-edge); border-radius: 1rem; color: var(--text); font: inherit; cursor: pointer;
    transition: transform 0.3s cubic-bezier(.34,1.56,.64,1), box-shadow 0.3s, opacity 0.3s; }
  .app.built { border-color: rgba(31, 181, 194, 0.55); }
  .app.research { border-style: dashed; border-color: rgba(201, 168, 106, 0.6); }
  .app.planned { border-style: dotted; border-color: var(--muted); }
  .app:hover, .app:focus-visible { transform: translateY(-2px) scale(1.04); box-shadow: 0 0 1.25rem rgba(31, 181, 194, 0.45); }
  .app[aria-pressed="true"] { box-shadow: 0 0 0 2px var(--cherenkov-hi), 0 0 1.5rem rgba(31, 181, 194, 0.6); }
  .app.dim { opacity: 0.25; }
  .ic { font-size: 1.5rem; line-height: 1; }
  .nm { font-weight: 700; font-size: 0.85rem; }
  .nt { font-size: 0.68rem; color: var(--muted); text-align: center; }

  .eco-detail { margin-top: 1rem; padding: 1rem 1.1rem; border-radius: 1rem; background: var(--glass); border: 1px solid var(--glass-edge); min-height: 7rem; }
  .eco-detail .hint { color: var(--muted); margin: 0; }
  .eco-detail article { animation: rise 0.35s ease-out; }
  .eco-detail header { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .eco-detail h3 { margin: 0; font-size: 1.2rem; }
  .ic.big { font-size: 2rem; }
  .chip { font-size: 0.72rem; padding: 0.15rem 0.6rem; border-radius: 999px; border: 1px solid; }
  .chip.built { color: var(--verified); border-color: var(--verified); }
  .chip.research { color: var(--gold); border-color: var(--gold); }
  .chip.planned { color: var(--muted); border-color: var(--muted); }
  .now { color: var(--lede); }
  .eco-detail a.go { display: inline-block; margin-top: 0.25rem; padding: 0.55rem 1rem; border-radius: 999px; background: var(--accent-fill); color: var(--on-accent) !important; font-weight: 700; text-decoration: none; min-height: 44px; line-height: 1.9; }

  /* Wide screens: the same buttons placed on an orbit. */
  @media (min-width: 760px) {
    .eco-stage { aspect-ratio: 1; max-width: 40rem; margin: 0 auto; }
    .eco-spokes { display: block; position: absolute; inset: 0; width: 100%; height: 100%; }
    .orbit { fill: none; stroke: var(--sl-color-hairline); stroke-width: 0.15; stroke-dasharray: 0.6 1.4; }
    .spoke { stroke-width: 0.3; stroke-dasharray: 1 1.8; animation: flow 4s linear infinite; }
    .spoke.built { stroke: var(--cherenkov); }
    .spoke.research { stroke: var(--gold); opacity: 0.6; }
    .spoke.planned { stroke: var(--muted); opacity: 0.35; animation: none; }
    .spoke.lit { stroke: var(--cherenkov-hi); stroke-width: 0.7; opacity: 1; animation-duration: 0.8s; }
    .eco-core { position: absolute; left: 50%; top: 50%; translate: -50% -50%; margin: 0; width: 26%; height: 26%; }
    .eco-apps { display: block; }
    .eco-apps li { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; width: 19%; }
    .app { aspect-ratio: 1; min-height: 0; border-radius: 50%; }
  }
  @keyframes flow { to { stroke-dashoffset: -5.6; } }
  @keyframes breathe { 50% { transform: scale(1.05); } }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { .eco-core, .spoke, .eco-detail article { animation: none !important; } .app { transition: none; } }
</style>
