---
// A 3D map of the project's health, drawn from /health.json (emitted by
// scripts/gen-health.mjs from features.toml and the launch gates). Each point
// is one subsystem, placed in a shell by tier (core inner, extended, frontier
// outer) and coloured by status. Hover or arrow-key across a point to name it;
// click (or Enter) to pin its detail. Without WebGL the same subsystems are a
// keyboard-reachable grid of dots, so nothing is lost to the missing canvas.
// The headline numbers are the reality ledger, counted live at build; the test
// figure carries its own as-of date.
---

<section class="health" aria-label="Project health">
  <p class="maya-eyebrow">Proof, not promises</p>
  <h2 class="maya-section-title">The whole system, by what a test can prove</h2>

  <div class="stats" id="health-stats" aria-live="polite">
    <div class="stat big"><span class="n" data-k="tests">—</span><span class="l">tests passing</span><span class="s" id="tests-asof"></span></div>
    <div class="stat"><span class="n" data-k="verified">—</span><span class="l">verified subsystems</span><span class="s">backed by a named test</span></div>
    <div class="stat"><span class="n" data-k="working">—</span><span class="l">working</span><span class="s">built, test pending verify</span></div>
    <div class="stat"><span class="n" data-k="planned">—</span><span class="l">planned</span><span class="s">designed, no code yet</span></div>
    <div class="stat"><span class="n" data-k="gates">—</span><span class="l">launch gates passed</span><span class="s">of <b id="gates-total">—</b>, before mainnet</span></div>
  </div>

  <div class="stage" id="health-3d">
    <canvas id="health-canvas" tabindex="0" role="img" aria-label="Subsystem map. Move between subsystems with the arrow keys, open one with Enter, close with Escape."></canvas>
    <div class="tip" id="health-tip" hidden></div>
  </div>
  <ul class="flat-grid" id="health-flat" aria-label="Subsystems by status" hidden></ul>
  <div class="detail" id="health-detail" aria-live="polite" hidden></div>

  <ul class="legend" aria-hidden="true">
    <li><i class="d verified"></i>verified</li>
    <li><i class="d working"></i>working</li>
    <li><i class="d planned"></i>planned</li>
    <li class="sep"><i class="ring core"></i>core</li>
    <li><i class="ring extended"></i>extended</li>
    <li><i class="ring frontier"></i>frontier</li>
  </ul>
  <p class="asof" id="health-generated"></p>
</section>

<script>
  // three.js loads when this section nears the viewport, so the rest of the
  // page never downloads it.
  type Sub = { name: string; domain: string; tier: string; class: string; status: string };

  const STATUS = {
    verified: "#22d3ee", working: "#a78bfa", planned: "#64748b", stub: "#f59e0b",
  } as Record<string, string>;
  const TIER_R = { core: 1.15, extended: 1.95, frontier: 2.75 } as Record<string, number>;
  // The register itself: every subsystem is one entry in this file.
  const REGISTER = "https://github.com/EricWijesinghe/Maya2C/blob/master/features.toml";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function webgl(): boolean {
    try { const c = document.createElement("canvas"); return !!(c.getContext("webgl2") || c.getContext("webgl")); }
    catch { return false; }
  }

  function countTo(el: HTMLElement, end: number) {
    if (reduce) { el.textContent = end.toLocaleString("en-US"); return; }
    const start = performance.now();
    const step = (t: number) => {
      const k = Math.min(1, (t - start) / 1000);
      el.textContent = Math.round(end * (1 - (1 - k) ** 3)).toLocaleString("en-US");
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // Built with DOM calls, not innerHTML: names come from the build's data.
  function fillDetail(el: HTMLElement, x: Sub) {
    const title = document.createElement("b");
    title.textContent = x.name;
    const meta = document.createElement("span");
    meta.textContent = `${x.status} · ${x.tier} · ${x.class}`;
    const domain = document.createElement("span");
    domain.textContent = x.domain;
    const more = document.createElement("a");
    more.href = REGISTER; more.target = "_blank"; more.rel = "noopener";
    more.textContent = "Learn more in the register →";
    el.replaceChildren(title, meta, domain, more);
    el.hidden = false;
  }

  function buildFlatGrid(list: HTMLElement, subs: Sub[], pin: (i: number) => void) {
    subs.forEach((x, i) => {
      const li = document.createElement("li");
      const b = document.createElement("button");
      b.type = "button";
      b.className = `dot ${x.status}`;
      b.title = x.name;
      b.setAttribute("aria-label", `${x.name}, ${x.status}, ${x.tier}`);
      b.addEventListener("click", () => pin(i));
      li.append(b);
      list.append(li);
    });
    list.hidden = false;
  }

  (async () => {
    let h: any;
    try { h = await (await fetch("/health.json")).json(); } catch { return; }

    // Headline numbers (always, even without WebGL).
    const set = (k: string, v: number) => {
      const el = document.querySelector<HTMLElement>(`.health .n[data-k="${k}"]`);
      if (el) countTo(el, v);
    };
    const s = h.ledger.by_status;
    set("tests", h.tests.passed);
    set("verified", s.verified || 0);
    set("working", s.working || 0);
    set("planned", s.planned || 0);
    set("gates", h.gates.passed);
    const gt = document.getElementById("gates-total"); if (gt) gt.textContent = h.gates.total;
    const asof = document.getElementById("tests-asof");
    if (asof) asof.textContent = `measured ${h.tests.as_of}`;
    const gen = document.getElementById("health-generated");
    if (gen) gen.textContent = `Ledger counted live from features.toml at build · ${new Date(h.generated).toISOString().slice(0, 10)}`;

    const subs = h.subsystems as Sub[];
    const detail = document.getElementById("health-detail") as HTMLElement;
    const host = document.getElementById("health-3d");
    const canvas = document.getElementById("health-canvas") as HTMLCanvasElement;
    const flat = document.getElementById("health-flat") as HTMLElement;

    if (!host || !canvas || !webgl()) {
      host?.setAttribute("hidden", "");
      if (flat) buildFlatGrid(flat, subs, (i) => fillDetail(detail, subs[i]));
      return;
    }

    await new Promise<void>((resolve) => {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((en) => en.isIntersecting)) { io.disconnect(); resolve(); }
      }, { rootMargin: "400px 0px" });
      io.observe(host);
    });
    const {
      AdditiveBlending, BufferGeometry, Clock, Color, Float32BufferAttribute,
      PerspectiveCamera, Points, PointsMaterial, Raycaster, Scene, Vector2, Vector3,
      WebGLRenderer,
    } = await import("three");

    // Build the point cloud: one point per subsystem, shell by tier, colour by
    // status, a stable pseudo-random spread so the map is the same every load.
    const pos = new Float32Array(subs.length * 3);
    const col = new Float32Array(subs.length * 3);
    const golden = Math.PI * (3 - Math.sqrt(5));
    const perTier: Record<string, number> = {};
    subs.forEach((x) => (perTier[x.tier] = (perTier[x.tier] || 0) + 1));
    const seen: Record<string, number> = {};
    subs.forEach((x, idx) => {
      const n = perTier[x.tier] || 1;
      const i = seen[x.tier] = (seen[x.tier] || 0);
      seen[x.tier]++;
      const y = 1 - (i / Math.max(1, n - 1)) * 2;
      const r = Math.sqrt(Math.max(0, 1 - y * y));
      const t = golden * i;
      const radius = (TIER_R[x.tier] || 2) * (0.92 + 0.16 * ((idx * 2654435761) % 1000) / 1000);
      pos.set([Math.cos(t) * r * radius, y * radius, Math.sin(t) * r * radius], idx * 3);
      const c = new Color(STATUS[x.status] || "#94a3b8");
      col.set([c.r, c.g, c.b], idx * 3);
    });
    const geo = new BufferGeometry();
    geo.setAttribute("position", new Float32BufferAttribute(pos, 3));
    geo.setAttribute("color", new Float32BufferAttribute(col, 3));
    const mat = new PointsMaterial({ size: 0.11, vertexColors: true, transparent: true, opacity: 0.95, blending: AdditiveBlending, depthWrite: false });
    const cloud = new Points(geo, mat);

    const scene = new Scene();
    scene.add(cloud);
    const camera = new PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.set(0, 0, 7.2);
    const renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: "low-power" });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const resize = () => {
      const w = host.clientWidth || 600, hgt = host.clientHeight || 420;
      renderer.setSize(w, hgt, false);
      camera.aspect = w / hgt; camera.updateProjectionMatrix();
    };
    resize();
    window.addEventListener("resize", resize);

    // Selection is shared by hover, arrow keys and taps. The tip follows the
    // selected point in screen space, so it stays put when the cloud turns.
    const ray = new Raycaster();
    (ray.params.Points as any).threshold = 0.14;
    const ndc = new Vector2();
    const anchor = new Vector3();
    const tip = document.getElementById("health-tip") as HTMLElement;
    let selected = -1;
    const select = (i: number) => {
      selected = i;
      if (i < 0) { tip.hidden = true; return; }
      const x = subs[i];
      tip.replaceChildren();
      const b = document.createElement("b"); b.textContent = x.name;
      const sp = document.createElement("span"); sp.textContent = `${x.status} · ${x.tier}`;
      tip.append(b, sp);
      tip.hidden = false;
    };
    const pin = (i: number) => { select(i); fillDetail(detail, subs[i]); };

    canvas.addEventListener("pointermove", (e) => {
      const rect = canvas.getBoundingClientRect();
      ndc.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      ndc.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      ray.setFromCamera(ndc, camera);
      const hit = ray.intersectObject(cloud)[0];
      const next = hit ? (hit.index ?? -1) : -1;
      if (next !== selected) select(next);
    });
    canvas.addEventListener("pointerleave", () => select(-1));

    // A click pins the detail; a drag (rotating the map) does not.
    let downAt: { x: number; y: number } | null = null;
    canvas.addEventListener("pointerdown", (e) => { downAt = { x: e.clientX, y: e.clientY }; });
    canvas.addEventListener("pointerup", (e) => {
      const moved = downAt ? Math.hypot(e.clientX - downAt.x, e.clientY - downAt.y) : 99;
      if (moved < 6 && selected >= 0) pin(selected);
      downAt = null;
    });

    canvas.addEventListener("keydown", (e) => {
      const step: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
      if (e.key in step) {
        e.preventDefault();
        select((((selected < 0 ? -1 : selected) + step[e.key]) + subs.length) % subs.length);
      } else if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        if (selected >= 0) pin(selected);
      } else if (e.key === "Escape") {
        detail.hidden = true; select(-1);
      }
    });

    const pointer = { x: 0, y: 0 };
    host.addEventListener("pointermove", (e) => {
      const rect = host.getBoundingClientRect();
      pointer.x = ((e.clientX - rect.left) / rect.width - 0.5) * 2;
      pointer.y = ((e.clientY - rect.top) / rect.height - 0.5) * 2;
    });

    let visible = true;
    new IntersectionObserver(([en]) => (visible = en.isIntersecting)).observe(host);
    const clock = new Clock();
    const placeTip = () => {
      if (selected < 0) return;
      anchor.set(pos[selected * 3], pos[selected * 3 + 1], pos[selected * 3 + 2])
        .applyMatrix4(cloud.matrixWorld).project(camera);
      const rect = canvas.getBoundingClientRect();
      tip.style.left = `${((anchor.x + 1) / 2) * rect.width}px`;
      tip.style.top = `${((1 - anchor.y) / 2) * rect.height}px`;
    };
    const draw = () => {
      const t = clock.getElapsedTime();
      if (!reduce) { cloud.rotation.y = t * 0.12; cloud.rotation.x = Math.sin(t * 0.25) * 0.12; }
      scene.rotation.y += (pointer.x * 0.4 - scene.rotation.y) * 0.05;
      scene.rotation.x += (pointer.y * 0.3 - scene.rotation.x) * 0.05;
      renderer.render(scene, camera);
      placeTip();
    };
    const frame = () => { requestAnimationFrame(frame); if (visible && !document.hidden) draw(); };
    draw(); frame();
  })();
</script>

<style>
  .health { margin: 3rem 0 1.5rem; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: 0.75rem; margin: 1.5rem 0; }
  .stat { display: flex; flex-direction: column; gap: 0.15rem; padding: 1rem 1.1rem; border-radius: 0.9rem;
    border: 1px solid var(--sl-color-hairline); background: linear-gradient(160deg, rgb(34 211 238 / 0.07), rgb(167 139 250 / 0.03)); }
  .stat .n { font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums;
    background: linear-gradient(100deg, #22d3ee, #a78bfa 60%, #f472b6); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .stat.big .n { font-size: clamp(2rem, 4vw, 2.9rem); }
  .stat .l { font-weight: 600; color: var(--sl-color-white); font-size: 0.9rem; }
  .stat .s { font-size: 0.72rem; color: var(--sl-color-gray-4); }

  .stage { position: relative; height: clamp(22rem, 46vw, 30rem); border-radius: 1.1rem; overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    background: radial-gradient(60% 60% at 50% 40%, rgb(34 211 238 / 0.08), transparent 70%), rgb(5 8 14 / 0.5); }
  .stage canvas { width: 100%; height: 100%; display: block; cursor: grab; }
  .stage canvas:focus-visible { outline: 2px solid #22d3ee; outline-offset: -2px; }
  .stage[hidden] { display: none; }
  .tip { position: absolute; transform: translate(-50%, -140%); pointer-events: none; white-space: nowrap;
    background: rgb(8 12 22 / 0.92); border: 1px solid var(--sl-color-hairline); border-radius: 0.5rem;
    padding: 0.35rem 0.6rem; font-size: 0.8rem; z-index: 2; backdrop-filter: blur(6px); }
  .tip :global(b) { display: block; color: var(--sl-color-white); }
  .tip :global(span) { color: var(--sl-color-gray-3); text-transform: capitalize; font-size: 0.72rem; }

  .flat-grid { display: flex; flex-wrap: wrap; gap: 0.45rem; list-style: none; padding: 1rem; margin: 0;
    border-radius: 1.1rem; border: 1px solid var(--sl-color-hairline); background: rgb(5 8 14 / 0.5); }
  /* Children are built in the script, so they carry no scope attribute: :global. */
  .flat-grid[hidden] { display: none; }
  .flat-grid :global(li) { display: block; list-style: none; }
  .flat-grid :global(li::before), .flat-grid :global(li::marker) { content: none; }
  .flat-grid :global(button) { width: 1.1rem; height: 1.1rem; border-radius: 50%; border: 0; padding: 0; cursor: pointer; }
  .flat-grid :global(button:focus-visible) { outline: 2px solid #22d3ee; outline-offset: 2px; }
  .flat-grid :global(.dot.verified) { background: #22d3ee; }
  .flat-grid :global(.dot.working) { background: #a78bfa; }
  .flat-grid :global(.dot.planned) { background: #64748b; }

  .detail { margin-top: 0.9rem; padding: 0.9rem 1.1rem; border-radius: 0.9rem; display: flex; flex-direction: column; gap: 0.2rem;
    border: 1px solid var(--sl-color-hairline); background: rgb(5 8 14 / 0.6); }
  .detail[hidden] { display: none; }
  .detail :global(b) { color: var(--sl-color-white); font-size: 1rem; }
  .detail :global(span) { color: var(--sl-color-gray-3); font-size: 0.8rem; text-transform: capitalize; }
  .detail :global(a) { margin-top: 0.4rem; color: var(--sl-color-text-accent); font-size: 0.85rem; }
  .detail :global(a:focus-visible) { outline: 2px solid #22d3ee; outline-offset: 2px; }

  .legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.1rem; list-style: none; padding: 0; margin: 0.9rem 0 0.3rem;
    font-size: 0.8rem; color: var(--sl-color-gray-3); }
  .legend li { display: flex; align-items: center; gap: 0.4rem; }
  .legend .sep { margin-left: 0.6rem; }
  .legend .d { width: 0.7rem; height: 0.7rem; border-radius: 50%; }
  .legend .d.verified { background: #22d3ee; } .legend .d.working { background: #a78bfa; } .legend .d.planned { background: #64748b; }
  .legend .ring { width: 0.8rem; height: 0.8rem; border-radius: 50%; border: 2px solid; }
  .legend .ring.core { border-color: #22d3ee; } .legend .ring.extended { border-color: #a78bfa; } .legend .ring.frontier { border-color: #f472b6; }
  .asof { font-size: 0.72rem; color: var(--sl-color-gray-4); font-family: var(--sl-font-mono); margin: 0.4rem 0 0; }
</style>
