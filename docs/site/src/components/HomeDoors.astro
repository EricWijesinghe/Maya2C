---
// Three doors under the hero, one per audience. Each is a whole-card link to
// a page that works today, whatever the testnet is doing. Each door carries a
// small drawing of what is behind it (graphics over text): the split two-
// signature badge, code brackets with the three SDKs, a committee seat. The
// arrow sits next to the title, where the eye already is.
interface Props { label?: string }
const { label = "Where to start" } = Astro.props;
const doors = [
  { kicker: "Try it", title: "Watch a signature check", tone: "teal", art: "sig", line: "Step through both post-quantum checks in your browser.", href: "/learn/signatures-live/" },
  { kicker: "Build on it", title: "SDKs and the gateway", tone: "bronze", art: "code", line: "Rust, TypeScript and Python clients, and an MCP server.", href: "/reference/sdk/" },
  { kicker: "Run a node", title: "Validator guide", tone: "steel", art: "seat", line: "Commands in order, penalties, and what gates open registration.", href: "/guides/validators/" },
];
// The committee drawing: seven seats on a ring, the one you would run in bronze.
const seats = Array.from({ length: 7 }, (_, i) => {
  const a = (i / 7) * Math.PI * 2 - Math.PI / 2;
  return { x: 60 + 22 * Math.cos(a), y: 32 + 22 * Math.sin(a), you: i === 2 };
});
---

<nav class="not-content doors" aria-label={label}>
  <ul>
    {doors.map((d) => (
      <li>
        <a href={d.href} class={`door door-${d.tone}`}>
          <svg class="art" viewBox="0 0 120 64" width="120" height="64" aria-hidden="true">
            {d.art === "sig" && (
              <g>
                <rect class="doc" x="8" y="14" width="44" height="36" rx="6" />
                <path class="doc-l" d="M16 26h28M16 34h20M16 42h24" />
                <path class="half-a" d="M84 12 A20 20 0 0 0 84 52 Z" />
                <path class="half-b" d="M84 12 A20 20 0 0 1 84 52 Z" />
                <path class="tick" d="M75 32.5l6 6 12-13" />
              </g>
            )}
            {d.art === "code" && (
              <g>
                <path class="br" d="M22 10q-10 0-10 10v6q0 6-6 6 6 0 6 6v6q0 10 10 10M98 10q10 0 10 10v6q0 6 6 6-6 0-6 6v6q0 10-10 10" />
                <rect class="chip-a" x="26" y="22" width="20" height="20" rx="5" /><text class="ct" x="36" y="36">rs</text>
                <rect class="chip-b" x="50" y="22" width="20" height="20" rx="5" /><text class="ct" x="60" y="36">ts</text>
                <rect class="chip-c" x="74" y="22" width="20" height="20" rx="5" /><text class="ct" x="84" y="36">py</text>
              </g>
            )}
            {d.art === "seat" && (
              <g>
                <circle class="ring" cx="60" cy="32" r="22" />
                {seats.map((s) => <circle class={s.you ? "you" : "seat"} cx={s.x} cy={s.y} r={s.you ? 7 : 4.5} />)}
              </g>
            )}
          </svg>
          <span class="k">{d.kicker}</span>
          <span class="t">{d.title}<span class="go" aria-hidden="true">→</span></span>
          <span class="l">{d.line}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .doors { margin: var(--space-8) 0 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); grid-template-columns: minmax(0, 1fr); }
  li { margin: 0; display: flex; }
  .door { --tone: var(--accent); position: relative; flex: 1; display: grid; grid-template-columns: auto minmax(0, 1fr); grid-template-areas: "art k" "art t" "art l"; column-gap: var(--space-4); row-gap: var(--space-1); align-content: start; min-height: 44px; padding: var(--space-5); border: 1px solid color-mix(in srgb, var(--tone) 35%, var(--border)); border-radius: var(--r-lg); background: radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--tone) 24%, transparent), transparent 70%), linear-gradient(160deg, color-mix(in srgb, var(--tone) 12%, var(--surface-1)), var(--surface-1) 75%); color: inherit; text-decoration: none; overflow: hidden; transition: border-color var(--dur-2) var(--ease), transform var(--dur-2) var(--ease), box-shadow var(--dur-2) var(--ease); }
  .door::before { content: ""; position: absolute; inset: 0 0 auto; height: 3px; background: linear-gradient(90deg, var(--tone), color-mix(in srgb, var(--tone) 20%, transparent)); }
  .door-bronze { --tone: var(--bronze); }
  /* Steel mixed toward teal so the third door reads as active, not disabled. */
  .door-steel { --tone: color-mix(in srgb, var(--steel) 55%, var(--accent)); }
  :global([data-theme="light"]) .door { background: linear-gradient(160deg, color-mix(in srgb, var(--tone) 8%, var(--surface-1)), var(--surface-1) 70%); }
  .door:hover, .door:focus-visible { border-color: var(--tone); box-shadow: 0 16px 40px -18px color-mix(in srgb, var(--tone) 75%, transparent); transform: translateY(-2px); }
  .door:focus-visible { outline: 2px solid var(--tone); outline-offset: 2px; }

  .art { grid-area: art; align-self: center; width: 64px; height: auto; overflow: visible; }
  .doc { fill: color-mix(in srgb, var(--accent) 12%, var(--surface-1)); stroke: color-mix(in srgb, var(--accent) 55%, transparent); stroke-width: 2; }
  .doc-l { stroke: color-mix(in srgb, var(--text) 45%, transparent); stroke-width: 2.5; stroke-linecap: round; }
  .half-a { fill: var(--accent); }
  .half-b { fill: var(--bronze); }
  .tick { fill: none; stroke: var(--bg); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  :global([data-theme="light"]) .tick { stroke: var(--surface-1); }
  .br { fill: none; stroke: var(--bronze); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .chip-a, .chip-b, .chip-c { fill: color-mix(in srgb, var(--accent) 22%, var(--surface-1)); stroke: var(--accent); stroke-width: 1.5; }
  .chip-b { fill: color-mix(in srgb, var(--bronze) 22%, var(--surface-1)); stroke: var(--bronze); }
  .ct { font: 700 10px var(--font-mono, monospace); text-anchor: middle; fill: var(--text); }
  .ring { fill: none; stroke: color-mix(in srgb, var(--tone) 70%, transparent); stroke-width: 2.5; }
  .seat { fill: var(--tone); }
  .you { fill: var(--bronze); stroke: var(--bg); stroke-width: 2; }

  .k { grid-area: k; font: var(--weight-semibold) var(--type-label-size)/1.4 var(--font-sans); letter-spacing: .06em; text-transform: uppercase; color: var(--text); }
  .t { grid-area: t; display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-2); font: var(--weight-semibold) var(--type-title-3-size)/1.25 var(--font-sans); letter-spacing: -0.01em; color: var(--text); }
  .l { grid-area: l; font-size: var(--type-body-size); line-height: 1.5; color: var(--text-2); }
  .go { color: var(--tone); transition: transform var(--dur-2) var(--ease); }
  .door:hover .go, .door:focus-visible .go { transform: translateX(4px); }
  @media (prefers-reduced-motion: reduce) { .door, .go { transition: none; } .door:hover, .door:focus-visible, .door:hover .go { transform: none; } }
  @media (min-width: 760px) {
    ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .door { grid-template-columns: minmax(0, 1fr); grid-template-areas: "art" "k" "t" "l"; }
    .art { justify-self: start; width: 120px; margin-bottom: var(--space-2); }
  }
</style>
