---
// The slim trust row under the hero buttons: what a reviewer checks first.
// Gates and proof counts are the numbers this build read into
// public/progress.json (gates from docs/mainnet-v1-plan.md, proofs from
// proof-ratchet.txt, which CI refuses to let fall: ADR-078 O3). A count the
// build could not read says MISSING; it is never hidden or guessed. The audit
// state stays visible in every network state.
import progress from "../../public/progress.json";

const repo = "https://github.com/EricWijesinghe/Maya2C";
const p = progress as { gates?: { met: number; total: number }; proofs?: Record<string, number> | null };
const n = (v: unknown) => (typeof v === "number" ? v.toLocaleString("en-US") : "MISSING");
const gates = p.gates ? `${p.gates.met} / ${p.gates.total}` : "MISSING";
const proofs = p.proofs ?? {};
const items = [
  { value: gates, label: "mainnet gates met", href: "/reference/mainnet-v1-plan/" },
  { value: n(proofs.kani_harnesses), label: "Kani proofs", href: `${repo}/blob/master/proof-ratchet.txt` },
  { value: n(proofs.conformance_vectors), label: "conformance vectors", href: `${repo}/blob/master/proof-ratchet.txt` },
  { value: "Apache-2.0", label: "open source", href: repo },
];
---

<ul class="trust" aria-label="Project facts">
  {items.map((i) => (
    <li><a href={i.href}><b>{i.value}</b> {i.label}</a></li>
  ))}
  <li><a class="audit" href="/guides/faq/#is-the-code-open-source-and-is-it-audited"><span class="mark" aria-hidden="true"></span>External audit pending</a></li>
</ul>

<style>
  .trust { list-style: none; margin: var(--space-5) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 var(--space-5); }
  .trust li { margin: 0; }
  .trust a { display: inline-flex; align-items: center; gap: var(--space-1); min-height: 44px; padding: 0; font-size: var(--type-body-sm-size); color: var(--text-2); text-decoration: none; transition: color var(--dur-1) var(--ease); }
  .trust a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 4px; }
  .trust b { font-weight: var(--weight-semibold); font-variant-numeric: tabular-nums; color: var(--text); }
  .audit { color: var(--text) !important; }
  .mark { width: 8px; height: 8px; border-radius: var(--r-pill); background: var(--bronze); box-shadow: 0 0 0 3px color-mix(in srgb, var(--bronze) 22%, transparent); }
</style>
