---
// The homepage hero (2026-10-20): the validator committee in 3D around the
// Maya2C core, and every real finalized block, from the explorer's WebSocket,
// as a crystal on a spiral chain (src/scripts/hero3d.ts). Drag to orbit; tap a
// validator or a block for its card. Nothing is simulated: if the stream
// drops, no crystal is born and the chip says so. Without WebGL, the still
// poster behind the canvas stays.
import { getImage } from "astro:assets";
import emblem from "../assets/emblem.png";

const badge = await getImage({ src: emblem, width: 256, format: "png" });
---

<section class="stage not-content" aria-label="Maya2C, live">
  <div class="poster" aria-hidden="true"></div>
  <canvas id="field" data-emblem={badge.src} aria-label="The validator committee and the live chain in 3D. Drag to orbit; tap a validator or a block for details."></canvas>
  <div class="card-pop" id="pop" hidden role="status"></div>
  <div class="ui">
    <div class="copy">
      <p class="chip"><span class="dot" aria-hidden="true"></span>maya-testnet-1 · <b id="chip-state">connecting…</b> · block <b id="hHeight">—</b> · <b id="hAgo">—</b> s ago</p>
      <h1>The ledger for the <span>post-quantum</span> century.</h1>
      <p class="lede">Every transaction carries two NIST post-quantum signatures. Every claim links to the test that proves it.</p>
      <div class="cta">
        <a class="btn primary" href="/experience/">Experience Maya2C</a>
        <a class="btn" href="https://explorer.maya2c.dev/">Watch it finalize</a>
      </div>
      <p class="hint">Drag to orbit. Tap the core, a validator or a block for its numbers.</p>
    </div>
    <dl class="tiles">
      <div class="tile"><dt>Height</dt><dd id="tHeight">—</dd></div>
      <div class="tile"><dt>Block time</dt><dd id="tBlock">—</dd></div>
      <div class="tile"><dt>Signature</dt><dd>ML-DSA-65</dd></div>
      <div class="tile"><dt>Validators</dt><dd><span id="tValidators">—</span><a class="note" id="tValNote" href="/guides/validators/">project-run</a></dd></div>
    </dl>
  </div>
</section>

<script>
  import { whenIdle } from "../scripts/idle";
  import type { Hero3D, Pick } from "../scripts/hero3d";
  const canvas = document.getElementById("field") as HTMLCanvasElement;
  const stage = canvas.parentElement as HTMLElement;
  const pop = document.getElementById("pop") as HTMLElement;
  const fmt = (n: number) => n.toLocaleString("en-US");
  const $ = (id: string) => document.getElementById(id);

  // Blocks that arrive before the scene loads wait here, so none is lost.
  let scene: Hero3D | null = null;
  const early: { h: number; txs: number }[] = [];
  let height = 0, lastBlockAt = 0, live = false, committee = 0;
  const gaps: number[] = [];

  function show(h: number) { $("hHeight")!.textContent = fmt(h); $("tHeight")!.textContent = fmt(h); }

  function onBlock(h: number, txs = 0, animate = true) {
    if (!h || h <= height) return;
    // Measured, never quoted: the mean gap between the last live blocks.
    if (animate && lastBlockAt) { gaps.push(performance.now() - lastBlockAt); if (gaps.length > 20) gaps.shift(); $("tBlock")!.textContent = (gaps.reduce((a, b) => a + b, 0) / gaps.length / 1000).toFixed(1) + " s"; }
    height = h; lastBlockAt = performance.now(); show(h);
    if (scene) scene.addBlock(h, txs, animate); else early.push({ h, txs });
  }
  setInterval(() => {
    $("hAgo")!.textContent = live && lastBlockAt ? ((performance.now() - lastBlockAt) / 1000).toFixed(1) : "—";
  }, 100);

  async function status() {
    try {
      const r = await fetch("https://rpc.maya2c.dev/rpc", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "get_bft_status", params: [] }),
      });
      const { result } = await r.json();
      if (!result) return;
      committee = result.committee;
      $("tValidators")!.textContent = fmt(committee);
      scene?.setValidators(committee);
      // Every validator today is run by the project (ADR-042): say so, and
      // never let a bigger number read as independent operators.
      $("tValNote")!.textContent = committee > 1 ? "project-run · one machine" : "project-run";
    } catch { /* gateway unreachable: tiles keep their last real values */ }
  }
  status(); setInterval(status, 3000);

  // No simulated activity, ever: a dropped stream births nothing and says so.
  let retry = 1000;
  function stream() {
    const ws = new WebSocket("wss://explorer.maya2c.dev/ws/blocks");
    ws.onopen = () => { live = true; retry = 1000; $("chip-state")!.textContent = "live"; stage.classList.add("live"); };
    ws.onmessage = (ev) => { try { const b = JSON.parse(ev.data); onBlock(b.height, b.tx_count ?? 0); } catch { /* skip */ } };
    ws.onclose = () => {
      live = false; stage.classList.remove("live"); $("chip-state")!.textContent = "reconnecting…";
      setTimeout(stream, retry); retry = Math.min(retry * 2, 30000);
    };
    ws.onerror = () => ws.close();
  }
  stream();

  // Open on the last real blocks, so the chain is never empty and never
  // invented: the explorer lists them newest first.
  fetch("https://explorer.maya2c.dev/api/blocks?limit=24")
    .then((r) => r.json())
    .then((blocks: { height: number; tx_count?: number }[]) => {
      // Older than a live block that beat this reply: straight onto the chain.
      blocks.slice().reverse().forEach((b) => {
        if (b.height > height) onBlock(b.height, b.tx_count ?? 0, false);
        else if (scene) scene.addBlock(b.height, b.tx_count ?? 0, false);
        else early.push({ h: b.height, txs: b.tx_count ?? 0 });
      });
    })
    .catch(() => { /* empty chain until the first live block */ });

  let popTimer = 0;
  function card(p: Pick | null) {
    if (!p) { pop.hidden = true; return; }
    // Every card is the chain's own numbers; a quorum is n - f, f = floor((n - 1) / 3).
    const n = committee || 4, quorum = n - Math.floor((n - 1) / 3);
    const avg = $("tBlock")!.textContent;
    if (p.kind === "chain") {
      pop.innerHTML = `<b>maya-testnet-1</b>Height ${fmt(height)} · block every ${avg}<br>${n} validators · ${quorum} must sign to finalize<br>Signatures ML-DSA-65 + SLH-DSA<br><a href="https://status.maya2c.dev/">Uptime and halts →</a>`;
    } else if (p.kind === "validator") {
      pop.innerHTML = `<b>Validator ${p.index + 1} of ${n}</b>Signs every block it votes for (ML-DSA-65)<br>Finality needs ${quorum} of ${n}; survives ${n - quorum} down<br>Project-run, one machine (ADR-042)<br><a href="/guides/validators/">Run a validator →</a>`;
    } else {
      const h = p.height;
      pop.innerHTML = `<b>Block ${fmt(h)}</b>loading…`;
      fetch(`https://explorer.maya2c.dev/api/blocks/${h}`)
        .then((r) => r.json())
        .then((b: { id: string; timestamp: number; tx_count?: number; state_root: string }) => {
          const ago = Math.max(0, Math.round(Date.now() / 1000 - b.timestamp));
          pop.innerHTML = `<b>Block ${fmt(h)}</b>${fmt(b.tx_count ?? 0)} transactions · ${fmt(ago)} s ago<br>id ${b.id.slice(0, 16)}…<br>state ${b.state_root.slice(0, 16)}…<br><a href="https://explorer.maya2c.dev/blocks/${h}">Open in explorer →</a>`;
        })
        .catch(() => { pop.innerHTML = `<b>Block ${fmt(h)}</b>${fmt(p.txs)} transactions<br><a href="https://explorer.maya2c.dev/blocks/${h}">Open in explorer →</a>`; });
    }
    const sr = stage.getBoundingClientRect();
    pop.style.left = Math.max(8, Math.min(p.x + 18, sr.width - 260)) + "px";
    pop.style.top = Math.max(8, Math.min(p.y + 18, sr.height - 150)) + "px";
    pop.hidden = false;
    clearTimeout(popTimer);
    popTimer = window.setTimeout(() => { pop.hidden = true; }, 6000);
  }

  // three.js loads only once the page has painted and gone idle; until then,
  // and without WebGL, the poster stays.
  whenIdle(async () => {
    try {
      const { mountHero3D } = await import("../scripts/hero3d");
      scene = mountHero3D(canvas, stage, card, canvas.dataset.emblem);
      stage.classList.add("gl");
      if (committee) scene.setValidators(committee);
      early.splice(0).forEach((b) => scene!.addBlock(b.h, b.txs, false));
    } catch { /* no WebGL: the poster stays */ }
  });
</script>

<style>
  /* Full-bleed: the hero spans the window, whatever column Starlight puts it in. */
  .stage { position: relative; width: 100vw; margin: 0 0 0 calc(50% - 50vw); min-height: calc(100svh - var(--sl-nav-height, 64px)); overflow: hidden; border-radius: 0 0 var(--r-l) var(--r-l); background: var(--void); }
  .poster { position: absolute; inset: 0; background:
    radial-gradient(22rem 22rem at 72% 45%, rgba(201, 168, 106,.30), transparent 70%),
    radial-gradient(14rem 14rem at 64% 60%, rgba(63,210,224,.22), transparent 70%), var(--void); }
  .stage.gl .poster { display: none; }
  #field { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; cursor: grab; }
  .ui { position: relative; z-index: 2; max-width: 1180px; margin-inline: auto; padding: clamp(40px, 8vh, 96px) max(16px, 4vw) 32px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; min-height: inherit; align-content: space-between; pointer-events: none; }
  .ui a, .ui button { pointer-events: auto; }
  .copy { max-width: min(680px, 52vw); min-width: 0; }
  .chip { white-space: nowrap; max-width: 100%; overflow: hidden; display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 8px 14px 8px 10px; border-radius: var(--r-pill); background: var(--glass); border: 1px solid var(--glass-edge); backdrop-filter: blur(14px); font: 500 12.5px/1 var(--mono); color: var(--muted); }
  .chip b { display: inline !important; margin: 0 !important; color: var(--text); font-weight: 500; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--muted); }
  .stage.live .dot { background: var(--signal); animation: beat 1.1s var(--glide) infinite; }
  @keyframes beat { 0% { box-shadow: 0 0 0 0 rgba(255,181,71,.55); } 100% { box-shadow: 0 0 0 12px rgba(255,181,71,0); } }
  h1 { font: 760 clamp(42px, 6vw, 84px)/1.02 var(--display); letter-spacing: -0.04em; margin: 24px 0 20px; color: var(--text); text-wrap: balance; }
  h1 span { white-space: nowrap; font-weight: 300; background: var(--title-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { max-width: 46ch; color: var(--lede); font-size: clamp(16px, 1.5vw, 19px); margin: 0; }
  .cta { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .btn { font: 600 15px/1 var(--sans); padding: 16px 24px; border-radius: var(--r-pill); color: var(--text); text-decoration: none; background: var(--glass); border: 1px solid var(--glass-edge); backdrop-filter: blur(14px); transition: transform .45s var(--spring), box-shadow .45s var(--glide); }
  .btn:hover { transform: translateY(-2px) scale(1.03); color: var(--text); }
  .btn.primary { background: linear-gradient(120deg, var(--cherenkov), var(--iris-a)); border-color: transparent; color: #fff; box-shadow: 0 14px 40px -12px rgba(31, 181, 194,.75); }
  .hint { margin: 16px 0 0; font: 400 12.5px/1.4 var(--mono); color: var(--muted); }
  .tiles { display: flex; gap: 12px; flex-wrap: wrap; margin: 0; }
  .tile { flex: 1 1 150px; min-width: 0; padding: 16px 20px; border-radius: var(--r-m); background: var(--glass); border: 1px solid var(--glass-edge); backdrop-filter: blur(16px); }
  .tile dt { font: 500 11.5px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .tile dd { margin: 10px 0 0; font: 300 26px/1 var(--display); font-variant-numeric: tabular-nums; color: var(--text); }
  .tile .note { font: 500 12px var(--sans); color: var(--signal); margin-left: 8px; text-decoration: none; }
  .card-pop { position: absolute; z-index: 3; min-width: 230px; padding: 16px 18px; border-radius: var(--r-m); background: var(--pop-bg); border: 1px solid var(--glass-edge); backdrop-filter: blur(18px); box-shadow: var(--shadow); font: 400 13px/1.55 var(--mono); color: var(--muted); transition: opacity .35s var(--glide), transform .5s var(--spring); }
  .card-pop[hidden] { display: block !important; opacity: 0; transform: scale(.6); pointer-events: none; }
  .card-pop :global(b) { display: block; font: 300 22px/1.2 var(--display); color: var(--text); margin-bottom: 4px; }
  .card-pop :global(a) { color: var(--accent-text); font-weight: 600; }
  /* The hero is the page title; Starlight's own h1 would repeat "Maya2C". */
  :global(main h1#_top) { display: none; }
  @media (prefers-reduced-motion: reduce) { .stage.live .dot { animation: none; } .btn { transition: none; } }
  /* The live chip outgrows one line below desktop widths (the layout audit
     caught it clipped at 768 px): let it wrap from there, not only on phones. */
  @media (max-width: 1023px) {
    .chip { white-space: normal; flex-wrap: wrap; row-gap: 4px; }
  }
  @media (max-width: 759px) {
    /* Bubbles above, words below: nothing sits on top of the headline. */
    .ui { padding-top: 34svh; gap: 28px; }
    .copy { max-width: none; }
    .chip { white-space: normal; flex-wrap: wrap; row-gap: 4px; }
    h1 { font-size: clamp(38px, 11vw, 56px); margin: 18px 0 14px; }
    .btn { padding: 14px 20px; }
    .tile { flex-basis: calc(50% - 6px); }
  }
</style>
