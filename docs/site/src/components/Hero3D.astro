---
// The landing page's 3D hero: a sphere of lattice points (the structure
// ML-DSA and ML-KEM rest on) around a live DAG of four validators, new
// rounds rising, each vertex certifying a quorum of the round below, anchors
// pulsing. It mounts into the `#maya-3d` element the hero frontmatter puts in
// place of the image, and replaces the SVG fallback there only once WebGL is
// running. No WebGL, or reduced motion requested: the SVG stays.
---

<script>
  import {
    AdditiveBlending,
    BufferAttribute,
    BufferGeometry,
    Clock,
    Color,
    Float32BufferAttribute,
    FogExp2,
    Group,
    LineBasicMaterial,
    LineSegments,
    Mesh,
    MeshBasicMaterial,
    PerspectiveCamera,
    Points,
    PointsMaterial,
    Scene,
    SphereGeometry,
    Vector3,
    WebGLRenderer,
  } from "three";

  const host = document.getElementById("maya-3d");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function webgl(): boolean {
    try {
      const c = document.createElement("canvas");
      return !!(c.getContext("webgl2") || c.getContext("webgl"));
    } catch {
      return false;
    }
  }

  if (host && !reduce && webgl()) mount(host);

  function lattice(count: number, radius: number): Points {
    // A Fibonacci sphere: evenly spread points, coloured cyan to violet by
    // height so the sphere reads as one object.
    const pos = new Float32Array(count * 3);
    const col = new Float32Array(count * 3);
    const cyan = new Color("#22d3ee");
    const violet = new Color("#a78bfa");
    const golden = Math.PI * (3 - Math.sqrt(5));
    for (let i = 0; i < count; i++) {
      const y = 1 - (i / (count - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const t = golden * i;
      pos.set([Math.cos(t) * r * radius, y * radius, Math.sin(t) * r * radius], i * 3);
      const c = cyan.clone().lerp(violet, (y + 1) / 2);
      col.set([c.r, c.g, c.b], i * 3);
    }
    const g = new BufferGeometry();
    g.setAttribute("position", new BufferAttribute(pos, 3));
    g.setAttribute("color", new BufferAttribute(col, 3));
    const m = new PointsMaterial({
      size: 0.055,
      vertexColors: true,
      transparent: true,
      opacity: 1,
      blending: AdditiveBlending,
      depthWrite: false,
    });
    return new Points(g, m);
  }

  type Dag = { group: Group; nodes: Mesh[]; edges: LineSegments; step: (t: number) => void };

  function dag(): Dag {
    // Four validators (columns) by six rounds (rows). Each vertex links to
    // three of the four vertices in the round below: a quorum of 2f+1.
    const group = new Group();
    const cols = 4;
    const rows = 6;
    const gapX = 0.42;
    const gapY = 0.34;
    const nodeGeo = new SphereGeometry(0.07, 20, 20);
    const nodes: Mesh[] = [];
    const points: number[] = [];
    const at = (c: number, r: number) =>
      new Vector3((c - (cols - 1) / 2) * gapX, (r - (rows - 1) / 2) * gapY, 0);
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const anchor = r % 2 === 0 && c === (r / 2) % cols;
        const mat = new MeshBasicMaterial({ color: anchor ? "#f472b6" : "#22d3ee" });
        const n = new Mesh(nodeGeo, mat);
        n.position.copy(at(c, r));
        n.userData = { anchor, phase: Math.random() * Math.PI * 2 };
        group.add(n);
        nodes.push(n);
        if (r > 0) {
          for (let k = 0; k < 3; k++) {
            const below = at((c + k) % cols, r - 1);
            const here = at(c, r);
            points.push(here.x, here.y, here.z, below.x, below.y, below.z);
          }
        }
      }
    }
    const lg = new BufferGeometry();
    lg.setAttribute("position", new Float32BufferAttribute(points, 3));
    const edges = new LineSegments(
      lg,
      new LineBasicMaterial({ color: "#a78bfa", transparent: true, opacity: 0.7, blending: AdditiveBlending }),
    );
    group.add(edges);
    const step = (t: number) => {
      // Rounds rise and wrap: the DAG keeps growing without end.
      group.position.y = ((t * 0.12) % gapY) - gapY / 2;
      for (const n of nodes) {
        const { anchor, phase } = n.userData as { anchor: boolean; phase: number };
        const s = anchor ? 1.25 + 0.35 * Math.sin(t * 3 + phase) : 1 + 0.12 * Math.sin(t * 2 + phase);
        n.scale.setScalar(s);
      }
      (edges.material as LineBasicMaterial).opacity = 0.55 + 0.2 * Math.sin(t * 1.5);
    };
    return { group, nodes, edges, step };
  }

  function mount(el: HTMLElement) {
    const renderer = new WebGLRenderer({ antialias: true, alpha: true, powerPreference: "low-power" });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    const scene = new Scene();
    scene.fog = new FogExp2(0x05070f, 0.1);
    const camera = new PerspectiveCamera(42, 1, 0.1, 50);
    camera.position.set(0, 0, 5.2);

    const sphere = lattice(1400, 1.75);
    const ring = lattice(420, 2.25);
    ring.rotation.x = Math.PI / 2.6;
    (ring.material as PointsMaterial).size = 0.035;
    const core = dag();
    scene.add(sphere, ring, core.group);

    const canvas = renderer.domElement;
    canvas.setAttribute("aria-hidden", "true");
    canvas.style.width = "100%";
    canvas.style.height = "100%";
    canvas.style.display = "block";

    const resize = () => {
      const w = el.clientWidth || 480;
      const h = el.clientHeight || w;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };

    const pointer = { x: 0, y: 0 };
    window.addEventListener("pointermove", (e) => {
      pointer.x = (e.clientX / window.innerWidth - 0.5) * 2;
      pointer.y = (e.clientY / window.innerHeight - 0.5) * 2;
    });

    let visible = true;
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(el);
    const clock = new Clock();
    const draw = (t: number) => {
      sphere.rotation.y = t * 0.12;
      sphere.rotation.x = Math.sin(t * 0.2) * 0.15;
      ring.rotation.z = -t * 0.08;
      core.step(t);
      scene.rotation.y += (pointer.x * 0.35 - scene.rotation.y) * 0.05;
      scene.rotation.x += (pointer.y * 0.25 - scene.rotation.x) * 0.05;
      renderer.render(scene, camera);
    };
    const frame = () => {
      requestAnimationFrame(frame);
      if (!visible || document.hidden) return;
      draw(clock.getElapsedTime());
    };
    // The first frame is drawn now, not on the first animation frame: a tab
    // opened in the background gets no animation frames until it is shown,
    // and the scene should be in place when it is.
    el.replaceChildren(canvas);
    resize();
    draw(0);
    window.addEventListener("resize", resize);
    frame();
  }
</script>
