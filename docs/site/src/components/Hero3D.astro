---
// Living Light bubble field hero: interactive canvas with spring physics.
// Shows real blocks from the chain. Falls back to a static poster.
---

<div class="hero">
  <div class="hero-fallback" aria-hidden="true"></div>
  <canvas id="field" aria-label="Interactive field of bubbles, one per recent block"></canvas>
  <div class="card-pop" id="pop" hidden role="status"></div>
  <div class="hero-ui wrap">
    <nav class="hero-nav" aria-label="Prototype navigation">
      <a class="hero-lockup" href="/">
        <svg width="34" height="34" viewBox="0 0 64 64" aria-hidden="true">
          <use href="/brand/orb.svg#orb" />
        </svg>
        <b>maya2c</b>
      </a>
      <div class="nav-pill">
        <a href="/guides/testnet">Testnet</a>
        <a href="/guides/api">API</a>
        <a href="/experience">Experience</a>
        <a href="/guides/signatures">Signatures</a>
      </div>
    </nav>
    <div class="hero-copy">
      <div class="chip-live">
        <span class="dot" aria-hidden="true"></span>
        <span>maya-testnet-1 · block <b id="hHeight">—</b> · <b id="hAgo">—</b></span>
      </div>
      <h1>The ledger for the <span>post-quantum</span> century.</h1>
      <p class="hero-lede">Every transaction carries two NIST post-quantum signatures. Every claim on this site links to the test that proves it.</p>
      <div class="hero-cta">
        <a class="btn primary" href="https://explorer.maya2c.dev">Watch it finalize</a>
        <a class="btn" href="/experience">Experience Maya2C</a>
      </div>
      <p class="hero-hint">Drag the bubbles. Tap one to open its block.</p>
    </div>
    <div>
      <dl class="telemetry">
        <div class="tile">
          <dt>Height</dt>
          <dd id="tHeight">—</dd>
        </div>
        <div class="tile">
          <dt>Block time</dt>
          <dd>1.1 s</dd>
        </div>
        <div class="tile">
          <dt>Signature</dt>
          <dd>ML-DSA-65</dd>
        </div>
        <div class="tile">
          <dt>Validators</dt>
          <dd>1<span class="note">seeking 4</span></dd>
        </div>
      </dl>
      <p class="sim-note" id="sim-note" style="display:none">Fallback: WebSocket down. Showing simulated blocks at 1.1s cadence.</p>
    </div>
  </div>
</div>

<script>
  (function () {
    "use strict";
    const canvas = document.getElementById("field");
    const stage = canvas.parentElement;
    const pop = document.getElementById("pop");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const MAX = 14;
    const fmt = (n) => n.toLocaleString("en-US");
    const hH = document.getElementById("hHeight");
    const tH = document.getElementById("tHeight");
    const hAgo = document.getElementById("hAgo");

    let height = 0;
    let lastBlockAt = performance.now();
    let lastCommittedRound = 0;
    let W = 1, H = 1;
    let wsConnected = false;
    let simulationActive = false;

    const balls = [];
    function home() { return { x: W * (W < 700 ? 0.62 : 0.7), y: H * 0.46 }; }

    function spawn(h, opts) {
      const c = home();
      // Check if this block is a committed anchor from BFT status
      const anchor = h && lastCommittedRound > 0 && h >= lastCommittedRound - 1;
      const base = Math.min(W, H) * (W < 700 ? 0.055 : 0.05);
      const b = {
        x: (opts && opts.x != null) ? opts.x : c.x + (Math.random() - 0.5) * 120,
        y: (opts && opts.y != null) ? opts.y : H * 0.98,
        vx: (opts && opts.vx) || (Math.random() - 0.5) * 40,
        vy: (opts && opts.vy) || -220,
        r: 0, vr: 0,
        rt: (opts && opts.rt) || base * (0.7 + Math.random() * 0.6),
        hue: anchor ? 1 : 0,
        h: h,
        leaving: false,
      };
      balls.push(b);
      if (balls.filter((x) => !x.leaving).length > MAX - 2) {
        const old = balls.find((x) => !x.leaving);
        if (old) { old.leaving = true; old.rt = 0; old.vy -= 60; }
      }
      while (balls.length > MAX) balls.shift();
    }

    function onBlock(now, h) {
      if (!h) return;
      height = h; lastBlockAt = now;
      hH.textContent = fmt(height); tH.textContent = fmt(height);
      spawn(height);
    }

    function updateAgo() {
      hAgo.textContent = wsConnected ? ((performance.now() - lastBlockAt) / 1000).toFixed(1) : '—';
    }
    setInterval(updateAgo, 100);

    // Fetch BFT status to get committed_round (anchors)
    async function refreshBFT() {
      try {
        const r = await fetch('https://rpc.maya2c.dev/rpc', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'get_bft_status', params: [] }),
        });
        const data = await r.json();
        if (data.result && data.result.committed_round) {
          lastCommittedRound = data.result.committed_round;
        }
      } catch (e) {
        // RPC down, continue with simulation
      }
    }

    // Real WebSocket: one bubble per finalized block
    function streamBlocks() {
      let ws;
      try {
        ws = new WebSocket('wss://explorer.maya2c.dev/ws/blocks');
      } catch (e) {
        console.log('WebSocket not available, using simulation');
        simulationActive = true;
        document.getElementById('sim-note').style.display = 'block';
        return;
      }
      ws.onopen = () => {
        wsConnected = true;
        simulationActive = false;
        document.getElementById('sim-note').style.display = 'none';
      };
      ws.onmessage = (ev) => {
        try {
          const block = JSON.parse(ev.data);
          if (block.height) onBlock(performance.now(), block.height);
        } catch (e) { /* skip malformed frames */ }
      };
      ws.onclose = () => {
        wsConnected = false;
        // Fall back to simulation
        if (!simulationActive) {
          simulationActive = true;
          document.getElementById('sim-note').style.display = 'block';
          startSimulation();
        } else {
          setTimeout(streamBlocks, 5000);
        }
      };
      ws.onerror = () => {
        ws.close();
      };
    }

    // Fallback simulation (when WebSocket is down)
    let simInterval;
    function startSimulation() {
      if (!height) height = 36254;
      simInterval = setInterval(() => {
        if (simulationActive) {
          onBlock(performance.now(), height + 1);
          height += 1;
        }
      }, 1100);
    }

    // Start: try WebSocket first, refresh BFT status periodically
    refreshBFT();
    setInterval(refreshBFT, 30000);
    streamBlocks();

    let ptr = { x: -9999, y: -9999, down: false, grab: null, moved: 0, sx: 0, sy: 0 };
    function local(e) { const r = canvas.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; }
    function hit(p) {
      let best = null, bd = 1e9;
      balls.forEach(function (b) { const d = Math.hypot(b.x - p.x, b.y - p.y); if (!b.leaving && d < b.r * 1.1 && d < bd) { bd = d; best = b; } });
      return best;
    }
    canvas.addEventListener("pointerdown", function (e) {
      const p = local(e); ptr.down = true; ptr.moved = 0; ptr.sx = p.x; ptr.sy = p.y;
      ptr.grab = hit(p);
      if (ptr.grab) { canvas.setPointerCapture(e.pointerId); canvas.classList.add("dragging"); }
    });
    canvas.addEventListener("pointermove", function (e) {
      const p = local(e); ptr.x = p.x; ptr.y = p.y;
      if (ptr.down) ptr.moved = Math.max(ptr.moved, Math.hypot(p.x - ptr.sx, p.y - ptr.sy));
    });
    function release(e) {
      const p = local(e);
      if (ptr.grab && ptr.moved < 6) popBall(ptr.grab, p);
      ptr.down = false; ptr.grab = null; canvas.classList.remove("dragging");
    }
    canvas.addEventListener("pointerup", release);
    canvas.addEventListener("pointercancel", function () { ptr.down = false; ptr.grab = null; canvas.classList.remove("dragging"); });
    canvas.addEventListener("pointerleave", function () { if (!ptr.down) { ptr.x = -9999; ptr.y = -9999; } });

    let popTimer = null;
    function popBall(b, p) {
      b.leaving = true; b.rt = 0;
      for (let i = 0; i < 3; i++) {
        const a = (i / 3) * Math.PI * 2 + Math.random();
        spawn(b.h, { x: b.x, y: b.y, vx: Math.cos(a) * 420, vy: Math.sin(a) * 420, rt: b.rt0 || Math.max(18, b.r * 0.42) });
        balls[balls.length - 1].hue = b.hue;
      }
      const anchor = b.hue > 0.5;
      pop.innerHTML = "<b>Block " + fmt(b.h) + "</b>" + (anchor ? "Anchor committed" : "Finalized by DAG-BFT") + "<br>Signed ML-DSA-65 + SLH-DSA";
      const sr = stage.getBoundingClientRect();
      const x = Math.min(p.x + 18, sr.width - 250);
      const y = Math.min(p.y + 18, sr.height - 130);
      pop.style.left = x + "px"; pop.style.top = y + "px";
      pop.hidden = false;
      clearTimeout(popTimer);
      popTimer = setTimeout(function () { pop.hidden = true; }, 3200);
    }

    function step(dt) {
      const c = home();
      const k = 1.1, damp = 0.82;
      for (let i = 0; i < balls.length; i++) {
        const b = balls[i];
        b.vr += ((b.rt - b.r) * 120 - b.vr * 12) * dt;
        b.r = Math.max(0, b.r + b.vr * dt);
        let ax = 0, ay = 0;
        if (b.leaving) {
          ay -= 90;
        } else {
          ax += (c.x - b.x) * k; ay += (c.y - b.y) * k;
          ax += Math.sin(performance.now() / 1700 + i) * 18;
        }
        for (let j = 0; j < balls.length; j++) {
          if (i === j) continue;
          const o = balls[j];
          const dx = b.x - o.x, dy = b.y - o.y;
          const d = Math.hypot(dx, dy) || 1;
          const want = (b.r + o.r) * 1.35;
          if (d < want) { const f = (want - d) * 14; ax += (dx / d) * f; ay += (dy / d) * f; }
        }
        const pd = Math.hypot(b.x - ptr.x, b.y - ptr.y);
        if (ptr.grab === b) {
          ax += (ptr.x - b.x) * 2.2; ay += (ptr.y - b.y) * 2.2;
        } else if (pd < 120) {
          ax -= (ptr.x - b.x) * 0.22; ay -= (ptr.y - b.y) * 0.22;
        }
        b.vx += ax * dt; b.vy += ay * dt;
        b.vx *= Math.pow(damp, dt); b.vy *= Math.pow(damp, dt);
        b.x += b.vx * dt; b.y += b.vy * dt;
      }
    }

    function draw(ctx) {
      ctx.clearRect(0, 0, W, H);
      for (let i = 0; i < balls.length; i++) {
        const b = balls[i];
        if (b.r < 0.5) continue;
        const h = b.hue === 0 ? `hsl(220, 100%, ${50 + b.r * 0.5}%)` : `hsl(45, 100%, ${50 + b.r * 0.3}%)`;
        ctx.fillStyle = h;
        ctx.beginPath();
        ctx.arc(b.x, b.y, b.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    let lastTime = performance.now();
    function frame(now) {
      const dt = Math.min((now - lastTime) / 1000, 0.033);
      lastTime = now;
      W = canvas.offsetWidth; H = canvas.offsetHeight;
      canvas.width = W * devicePixelRatio; canvas.height = H * devicePixelRatio;
      const ctx = canvas.getContext("2d");
      if (ctx) { ctx.scale(devicePixelRatio, devicePixelRatio); step(dt); draw(ctx); }
      requestAnimationFrame(frame);
    }

    if (!reduce) {
      requestAnimationFrame(frame);
      // WebSocket + simulation started above
    }
  })();
</script>
