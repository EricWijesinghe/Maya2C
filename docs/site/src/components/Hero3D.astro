---
// The homepage hero: one block finalizing, drawn from the same model the
// renderer uses (src/scripts/propagation-model.ts). The emblem stays in the
// header only. The static poster is the model frozen mid-sweep, so phones and
// reduced-motion visitors see the wave travelling, not the end state.
//
// The numbers in the chip and tiles are the chain's own: the tip height from
// get_chain_info, the tip's header timestamp from get_block_by_height, and the
// committee from get_bft_status. The scene's counts (validators, quorum) are
// illustrative and the caption does not present them as chain parameters.
import { buildModel, PHASES, phaseAt, project as projectRaw, frontRadius, liftAt, nodeLevel, beamAt, cameraPosition, ringAt } from "../scripts/propagation-model.ts";

const M = buildModel();
const POSTER_T = 2.3; // mid-sweep: the crest is about halfway across the field
const cam = cameraPosition(M, POSTER_T);
const POSTER_PHASE = phaseAt(M, POSTER_T); // the caption on the still frame matches the sweep it shows
// SVG y grows downward; the model projects y up.
const project = (p: readonly [number, number, number], c: readonly [number, number, number]): [number, number] => { const q = projectRaw(p, c); return [q[0], -q[1]]; };
const pts = M.points.map((p, i) => project([p[0], p[1] + liftAt(M, i, POSTER_T), p[2]], cam));
const xs = pts.map((p) => p[0]), ys = pts.map((p) => p[1]);
const pad = 0.4;
const [x0, x1] = [Math.min(...xs) - pad, Math.max(...xs) + pad];
const [y0, y1] = [Math.min(...ys) - pad, Math.max(...ys) + pad];
const f = (v: number) => +v.toFixed(3);
const isVal = new Set(M.validators);
const core = pts[M.core];
const ring = ringAt(M, POSTER_T);
const ringPts = Array.from({ length: 96 }, (_, k) => {
  const a = (k / 96) * Math.PI * 2;
  return project([M.points[M.core][0] + Math.cos(a) * ring.r, 0, M.points[M.core][2] + Math.sin(a) * ring.r], cam);
}).map((p) => `${f(p[0])},${f(p[1])}`).join(" ");
const beams = M.validators.flatMap((v, k) => [0, 1].map((kind) => {
  const b = beamAt(M, k, kind as 0 | 1, POSTER_T);
  if (b.p <= 0) return null;
  const a = pts[v], c = core;
  const h = [a[0] + (c[0] - a[0]) * b.p, a[1] + (c[1] - a[1]) * b.p];
  return { x1: f(a[0]), y1: f(a[1]), x2: f(h[0]), y2: f(h[1]), kind, alpha: b.alpha };
})).filter(Boolean) as { x1: number; y1: number; x2: number; y2: number; kind: number; alpha: number }[];
---

<section class="stage not-content" aria-label="How one Maya2C block finalizes">
  <div class="ui">
    <div class="copy">
      <p class="chip"><span class="dot" aria-hidden="true"></span>maya-testnet-1 · <b id="chip-state">connecting…</b> · height <b id="hHeight">—</b> · tip <b id="hAgo">—</b> s old</p>
      <h1>The ledger for the <span>post-quantum</span> century.</h1>
      <p class="lede">Every transaction carries two NIST post-quantum signatures. Every claim links to the test that proves it.</p>
      <div class="cta">
        <a class="btn primary" href="/experience/">Experience Maya2C</a>
        <a class="btn" href="/health/">Live health</a>
      </div>
    </div>
    <dl class="tiles">
      <div class="tile"><dt>Height</dt><dd id="tHeight">—</dd></div>
      <div class="tile"><dt>Tip age</dt><dd id="tAge">—</dd></div>
      <div class="tile"><dt>Signatures</dt><dd>ML-DSA-65 + SLH-DSA</dd></div>
      <div class="tile"><dt>Validators</dt><dd><span id="tValidators">—</span><a class="note" id="tValNote" href="/guides/validators/">project-run</a></dd></div>
    </dl>
  </div>

  <figure class="scene">
    <svg class="poster" viewBox={`${f(x0)} ${f(y0)} ${f(x1 - x0)} ${f(y1 - y0)}`} aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="pcore"><stop offset="0" stop-color="#fff3d6" /><stop offset="0.4" stop-color="#7eeaf0" stop-opacity="0.5" /><stop offset="1" stop-color="#7eeaf0" stop-opacity="0" /></radialGradient>
      </defs>
      <path d={M.edges.map(([a, b]) => `M${f(pts[a][0])} ${f(pts[a][1])}L${f(pts[b][0])} ${f(pts[b][1])}`).join("")} fill="none" stroke="#7eeaf0" stroke-opacity="0.3" stroke-width="0.02" />
      <polyline points={ringPts} fill="none" stroke="#fff3d6" stroke-opacity={f(0.18 * ring.a)} stroke-width="0.16" />
      <polyline points={ringPts} fill="none" stroke="#fff3d6" stroke-opacity={f(0.7 * ring.a)} stroke-width="0.035" />
      {beams.map((bm) => (
        <line x1={bm.x1} y1={bm.y1} x2={bm.x2} y2={bm.y2} stroke={bm.kind === 0 ? "#2fd9e6" : "#e6b260"} stroke-opacity={f(0.85 * bm.alpha)} stroke-width="0.035" />
      ))}
      {M.points.map((_, i) => (
        <circle cx={f(pts[i][0])} cy={f(pts[i][1])} r={isVal.has(i) ? 0.085 : 0.045} fill={isVal.has(i) ? "#e6b260" : "#7eeaf0"} fill-opacity={f(0.2 + 0.8 * nodeLevel(M, i, POSTER_T))} />
      ))}
      <circle cx={f(core[0])} cy={f(core[1])} r="0.6" fill="url(#pcore)" />
      <circle cx={f(core[0])} cy={f(core[1])} r="0.13" fill="#fff3d6" />
    </svg>
    <canvas id="field" aria-hidden="true"></canvas>
    <figcaption class="caption" id="caption">
      {PHASES.map((p, i) => (
        <>
          <span data-phase={i} class:list={[i === POSTER_PHASE && "on", i < POSTER_PHASE && "done"]}>{p}</span>
          {i < PHASES.length - 1 && <span class="arrow" aria-hidden="true"> → </span>}
        </>
      ))}
    </figcaption>
  </figure>
</section>

<script>
  import { whenIdle } from "../scripts/idle";
  const RPC = "https://rpc.maya2c.dev/rpc";
  const $ = (id: string) => document.getElementById(id) as HTMLElement;
  const fmt = (n: number) => n.toLocaleString("en-US");
  const canvas = document.getElementById("field") as HTMLCanvasElement;
  const spans = Array.from(document.querySelectorAll<HTMLElement>("#caption [data-phase]"));

  // Only the poster shows on phones and for reduced motion. Three is imported
  // lazily, so those visitors never download it.
  const phones = window.matchMedia("(max-width: 759px)");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  function onPhase(i: number) {
    spans.forEach((el, k) => { el.classList.toggle("on", k === i); el.classList.toggle("done", k < i); });
  }
  if (!phones.matches && !reduce.matches) {
    whenIdle(() => {
      import("../scripts/propagation")
        .then(({ startPropagation }) => startPropagation(canvas, onPhase))
        .catch(() => { /* no WebGL: the poster stays */ });
    });
  }

  // Chain facts, read from the public gateway. A failed read keeps the last value.
  async function rpc<T>(method: string, params: unknown[] = []): Promise<T | null> {
    try {
      const r = await fetch(RPC, {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ jsonrpc: "2.0", id: 1, method, params }),
      });
      const { result } = await r.json();
      return result ?? null;
    } catch { return null; }
  }

  let height = 0;
  let tipTs = 0;
  async function poll() {
    const info = await rpc<{ height: number }>("get_chain_info");
    if (!info) { $("chip-state").textContent = "gateway unreachable"; return; }
    $("chip-state").textContent = "live";
    if (info.height !== height) {
      height = info.height;
      $("hHeight").textContent = fmt(height); $("tHeight").textContent = fmt(height);
      const b = await rpc<{ header: { timestamp: number } }>("get_block_by_height", [height]);
      if (b?.header?.timestamp) tipTs = b.header.timestamp;
    }
    const bft = await rpc<{ committee: number }>("get_bft_status");
    if (bft) $("tValidators").textContent = fmt(bft.committee);
  }
  function tick() {
    $("hAgo").textContent = tipTs ? Math.max(0, Math.round(Date.now() / 1000 - tipTs)).toString() : "—";
    $("tAge").textContent = tipTs ? `${Math.max(0, Math.round(Date.now() / 1000 - tipTs))} s` : "—";
  }
  poll();
  setInterval(poll, 4000);
  setInterval(tick, 1000);
</script>

<style>
  /* Desktop: copy left, the scene fills the right side. Phones: the poster
     sits above the copy, in normal flow. */
  .stage { position: relative; width: 100vw; margin: 0 0 0 calc(50% - 50vw); min-height: calc(100svh - var(--sl-nav-height, 64px)); overflow: hidden; border-radius: 0 0 var(--r-l) var(--r-l); background: var(--void); }
  .scene { position: absolute; inset: 0; width: 100%; margin: 0; pointer-events: none; }
  /* The field fades out under the copy so the headline stays readable. */
  .scene { -webkit-mask-image: linear-gradient(90deg, transparent 18%, #000 48%); mask-image: linear-gradient(90deg, transparent 18%, #000 48%); }
  .poster { position: absolute; left: 71%; top: 46%; width: min(100%, 68vh); height: auto; aspect-ratio: 1; transform: translate(-50%, -50%); }
  #field { position: absolute; inset: 0; width: 100%; height: 100%; display: none; }
  .scene.gl #field { display: block; }
  .scene.gl .poster { display: none; }
  .ui { position: relative; z-index: 2; max-width: 1180px; margin-inline: auto; padding: clamp(40px, 8vh, 96px) max(16px, 4vw) 32px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; min-height: inherit; align-content: space-between; pointer-events: none; }
  .ui a, .ui button { pointer-events: auto; }
  .copy { max-width: min(600px, 46vw); min-width: 0; }
  .chip { white-space: nowrap; max-width: 100%; overflow: hidden; display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 8px 14px 8px 10px; border-radius: var(--r-pill); background: var(--glass); border: 1px solid var(--glass-edge); backdrop-filter: blur(14px); font: 500 12.5px/1 var(--mono); color: var(--muted); }
  .chip b { display: inline !important; margin: 0 !important; color: var(--text); font-weight: 500; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--muted); }
  .stage .chip .dot { background: var(--signal); }
  h1 { font: 760 clamp(42px, 6vw, 84px)/1.02 var(--display); letter-spacing: -0.04em; margin: 24px 0 20px; color: var(--text); text-wrap: balance; }
  h1 span { white-space: nowrap; font-weight: 300; background: var(--title-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { max-width: 46ch; color: var(--lede); font-size: clamp(16px, 1.5vw, 19px); margin: 0; }
  .cta { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .btn { font: 600 15px/1 var(--sans); padding: 16px 24px; border-radius: var(--r-pill); color: var(--text); text-decoration: none; background: var(--glass); border: 1px solid var(--glass-edge); backdrop-filter: blur(14px); transition: transform .45s var(--spring), box-shadow .45s var(--glide); }
  .btn:hover { transform: translateY(-2px) scale(1.03); color: var(--text); }
  .btn.primary { background: linear-gradient(120deg, var(--cherenkov), var(--iris-a)); border-color: transparent; color: #fff; box-shadow: 0 14px 40px -12px rgba(31, 181, 194,.75); }
  .caption { position: absolute; right: 5%; top: 96px; max-width: 46vw; margin: 0; white-space: nowrap; font: 500 13px/1.4 var(--mono); color: var(--muted); letter-spacing: .02em; }
  .caption [data-phase] { transition: color .9s var(--glide); color: var(--muted); }
  .caption [data-phase].done { color: var(--lede); }
  .caption [data-phase].on { color: var(--text); text-shadow: 0 0 18px rgba(126, 234, 240, .55); }
  .tiles { display: flex; gap: 12px; flex-wrap: wrap; margin: 0; max-width: min(600px, 46vw); }
  .tile { flex: 1 1 150px; min-width: 0; padding: 16px 20px; border-radius: var(--r-m); background: var(--glass); border: 1px solid var(--glass-edge); backdrop-filter: blur(16px); }
  .tile dt { font: 500 11.5px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .tile dd { margin: 10px 0 0; font: 300 26px/1 var(--display); font-variant-numeric: tabular-nums; color: var(--text); }
  .tile .note { font: 500 12px var(--sans); color: var(--signal); margin-left: 8px; text-decoration: none; }

  @media (max-width: 759px) {
    .stage { min-height: 0; display: flex; flex-direction: column; }
    .scene { order: -1; }
    .scene { position: relative; width: 100%; height: auto; padding: 56px 16px 0; }
    .scene { -webkit-mask-image: none; mask-image: none; }
    .poster { position: relative; left: auto; top: auto; transform: none; width: min(100%, 360px); margin: 0 auto; display: block; }
    .caption { position: static; display: block; white-space: normal; text-align: center; margin: 14px 16px 0; font-size: 12px; }
    .copy { max-width: none; }
    .chip { display: block; white-space: normal; border-radius: var(--r-m); line-height: 1.6; padding: 10px 14px; }
    .chip .dot { display: inline-block; vertical-align: middle; margin-right: 8px; }
    .ui { padding-top: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caption [data-phase] { transition: none; }
    .btn { transition: none; }
  }
</style>
