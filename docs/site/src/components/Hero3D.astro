---
// The homepage hero (art direction "Living Light", 2026-10-04): one glass
// bubble per real finalized block, from the explorer's WebSocket. Bubbles
// merge, drift and answer the pointer; tap one to open its block. Nothing is
// simulated: if the stream drops, no bubble is born and the chip says so.
// WebGL draws the thin-film bubbles; without it, or with reduced motion,
// the still poster behind the canvas stays.
---

<section class="stage" aria-label="Maya2C, live">
  <div class="poster" aria-hidden="true"></div>
  <canvas id="field" aria-label="Live bubbles, one per finalized block. Drag them, or tap one to open its block."></canvas>
  <div class="card-pop" id="pop" hidden role="status"></div>
  <div class="ui">
    <div class="copy">
      <p class="chip"><span class="dot" aria-hidden="true"></span>maya-testnet-1 · <b id="chip-state">connecting…</b> · block <b id="hHeight">—</b> · <b id="hAgo">—</b> s ago</p>
      <h1>The ledger for the <span>post-quantum</span> century.</h1>
      <p class="lede">Every transaction carries two NIST post-quantum signatures. Every claim links to the test that proves it.</p>
      <div class="cta">
        <a class="btn primary" href="/experience/">Experience Maya2C</a>
        <a class="btn" href="https://explorer.maya2c.dev/">Watch it finalize</a>
      </div>
      <p class="hint">Drag the bubbles. Tap one to open its block.</p>
    </div>
    <dl class="tiles">
      <div class="tile"><dt>Height</dt><dd id="tHeight">—</dd></div>
      <div class="tile"><dt>Block time</dt><dd>1.1 s</dd></div>
      <div class="tile"><dt>Signature</dt><dd>ML-DSA-65</dd></div>
      <div class="tile"><dt>Validators</dt><dd><span id="tValidators">—</span><span class="note">seeking 4</span></dd></div>
    </dl>
  </div>
</section>

<script>
  const canvas = document.getElementById("field") as HTMLCanvasElement;
  const stage = canvas.parentElement as HTMLElement;
  const pop = document.getElementById("pop") as HTMLElement;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const MAX = 14;
  const fmt = (n: number) => n.toLocaleString("en-US");
  const $ = (id: string) => document.getElementById(id);

  type Ball = { x: number; y: number; vx: number; vy: number; r: number; vr: number; rt: number; hue: number; h: number; leaving: boolean };
  const balls: Ball[] = [];
  let W = 1, H = 1, height = 0, lastBlockAt = 0, live = false;

  const home = () => ({ x: W * (W < 700 ? 0.66 : 0.72), y: H * 0.42 });

  function spawn(h: number, o: Partial<Ball> = {}) {
    const c = home();
    const base = Math.min(W, H) * (W < 700 ? 0.06 : 0.05);
    balls.push({
      x: o.x ?? c.x + (Math.random() - 0.5) * 120, y: o.y ?? H * 0.98,
      vx: o.vx ?? (Math.random() - 0.5) * 40, vy: o.vy ?? -220,
      r: 0, vr: 0, rt: o.rt ?? base * (0.7 + Math.random() * 0.6),
      hue: o.hue ?? 0, h, leaving: false,
    });
    if (balls.filter((b) => !b.leaving).length > MAX - 2) {
      const old = balls.find((b) => !b.leaving);
      if (old) { old.leaving = true; old.rt = 0; old.vy -= 60; }
    }
    while (balls.length > MAX) balls.shift();
  }

  // One bubble per real block. Gold when the block carries transactions:
  // every DAG-BFT block comes from a committed anchor, so gold-for-anchor
  // would colour them all and say nothing.
  function onBlock(h: number, txs = 0) {
    if (!h || h <= height) return;
    height = h; lastBlockAt = performance.now();
    $("hHeight")!.textContent = fmt(h); $("tHeight")!.textContent = fmt(h);
    spawn(h, { hue: txs > 0 ? 1 : 0 });
  }
  setInterval(() => {
    $("hAgo")!.textContent = live && lastBlockAt ? ((performance.now() - lastBlockAt) / 1000).toFixed(1) : "—";
  }, 100);

  async function status() {
    try {
      const r = await fetch("https://rpc.maya2c.dev/rpc", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: "get_bft_status", params: [] }),
      });
      const { result } = await r.json();
      if (!result) return;
      $("tValidators")!.textContent = fmt(result.committee);
    } catch { /* gateway unreachable: tiles keep their last real values */ }
  }
  status(); setInterval(status, 3000);

  // No simulated activity, ever: a dropped stream births nothing and says so.
  let retry = 1000;
  function stream() {
    const ws = new WebSocket("wss://explorer.maya2c.dev/ws/blocks");
    ws.onopen = () => { live = true; retry = 1000; $("chip-state")!.textContent = "live"; stage.classList.add("live"); };
    ws.onmessage = (ev) => { try { const b = JSON.parse(ev.data); onBlock(b.height, b.tx_count ?? 0); } catch { /* skip */ } };
    ws.onclose = () => {
      live = false; stage.classList.remove("live"); $("chip-state")!.textContent = "reconnecting…";
      setTimeout(stream, retry); retry = Math.min(retry * 2, 30000);
    };
    ws.onerror = () => ws.close();
  }
  stream();

  // Open on the last few real blocks, so the field is never empty and
  // never invented: the explorer lists them newest first.
  fetch("https://explorer.maya2c.dev/api/blocks?limit=9")
    .then((r) => r.json())
    .then((blocks: { height: number; tx_count?: number }[]) => {
      if (height) return;
      const c = home();
      blocks.slice().reverse().forEach((b, i) => {
        const a = (i / blocks.length) * Math.PI * 2;
        spawn(b.height, { x: c.x + Math.cos(a) * 70, y: c.y + Math.sin(a) * 55, vx: 0, vy: 0, hue: (b.tx_count ?? 0) > 0 ? 1 : 0 });
      });
      height = Math.max(height, ...blocks.map((b) => b.height));
      $("hHeight")!.textContent = fmt(height); $("tHeight")!.textContent = fmt(height);
    })
    .catch(() => { /* empty field until the first live block */ });

  // Pointer: repel on hover, spring-follow on drag, pop on tap.
  const ptr = { x: -9999, y: -9999, down: false, grab: null as Ball | null, moved: 0, sx: 0, sy: 0 };
  const local = (e: PointerEvent) => { const r = canvas.getBoundingClientRect(); return { x: e.clientX - r.left, y: e.clientY - r.top }; };
  const hit = (p: { x: number; y: number }) => balls.find((b) => !b.leaving && Math.hypot(b.x - p.x, b.y - p.y) < b.r * 1.1) ?? null;
  canvas.addEventListener("pointerdown", (e) => {
    const p = local(e); ptr.down = true; ptr.moved = 0; ptr.sx = p.x; ptr.sy = p.y; ptr.grab = hit(p);
    if (ptr.grab) canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener("pointermove", (e) => {
    const p = local(e); ptr.x = p.x; ptr.y = p.y;
    if (ptr.down) ptr.moved = Math.max(ptr.moved, Math.hypot(p.x - ptr.sx, p.y - ptr.sy));
  });
  canvas.addEventListener("pointerup", (e) => { if (ptr.grab && ptr.moved < 6) popBall(ptr.grab, local(e)); ptr.down = false; ptr.grab = null; });
  canvas.addEventListener("pointerleave", () => { if (!ptr.down) { ptr.x = -9999; ptr.y = -9999; } });

  let popTimer = 0;
  function popBall(b: Ball, p: { x: number; y: number }) {
    b.leaving = true;
    const r0 = Math.max(16, b.r * 0.42);
    b.rt = 0;
    for (let i = 0; i < 3; i++) {
      const a = (i / 3) * Math.PI * 2 + Math.random();
      spawn(b.h, { x: b.x, y: b.y, vx: Math.cos(a) * 420, vy: Math.sin(a) * 420, rt: r0, hue: b.hue });
    }
    pop.innerHTML = `<b>Block ${fmt(b.h)}</b>${b.hue > 0.5 ? "Carries transactions" : "Finalized by DAG-BFT"}<br>Signed ML-DSA-65 + SLH-DSA<br><a href="https://explorer.maya2c.dev/blocks/${b.h}">Open in explorer →</a>`;
    const sr = stage.getBoundingClientRect();
    pop.style.left = Math.min(p.x + 18, sr.width - 260) + "px";
    pop.style.top = Math.min(p.y + 18, sr.height - 150) + "px";
    pop.hidden = false;
    clearTimeout(popTimer);
    popTimer = window.setTimeout(() => { pop.hidden = true; }, 4000);
  }

  function step(dt: number) {
    const c = home();
    for (let i = 0; i < balls.length; i++) {
      const b = balls[i];
      b.vr += ((b.rt - b.r) * 120 - b.vr * 12) * dt;
      b.r = Math.max(0, b.r + b.vr * dt);
      let ax = 0, ay = 0;
      if (b.leaving) ay -= 90;
      else { ax += (c.x - b.x) * 1.1; ay += (c.y - b.y) * 1.1; ax += Math.sin(performance.now() / 1700 + i) * 18; }
      for (let j = 0; j < balls.length; j++) {
        if (i === j) continue;
        const o = balls[j], dx = b.x - o.x, dy = b.y - o.y, d = Math.hypot(dx, dy) || 1, want = (b.r + o.r) * 1.35;
        if (d < want) { const f = (want - d) * 14; ax += (dx / d) * f; ay += (dy / d) * f; }
      }
      const pd = Math.hypot(b.x - ptr.x, b.y - ptr.y);
      if (ptr.grab === b) { ax += (ptr.x - b.x) * 60 - b.vx * 9; ay += (ptr.y - b.y) * 60 - b.vy * 9; }
      else if (pd < 160 && pd > 0) { const f = (160 - pd) * 9; ax += ((b.x - ptr.x) / pd) * f; ay += ((b.y - ptr.y) / pd) * f; }
      const damp = Math.pow(0.82, dt * 6);
      b.vx = (b.vx + ax * dt) * damp; b.vy = (b.vy + ay * dt) * damp;
      b.x += b.vx * dt; b.y += b.vy * dt;
    }
    for (let i = balls.length - 1; i >= 0; i--) if (balls[i].leaving && balls[i].r < 0.5) balls.splice(i, 1);
  }

  const gl = (() => { try { return canvas.getContext("webgl", { antialias: false }); } catch { return null; } })();
  const FS = `precision highp float;
uniform vec2 uRes; uniform float uT; uniform float uDpr; uniform vec4 uB[${MAX}];
float hash(vec2 p){ return fract(sin(dot(p, vec2(12.9898,78.233))) * 43758.5453); }
vec3 film(float t){ return vec3(0.52,0.52,0.62) + vec3(0.42,0.42,0.38) * cos(6.28318 * (t + vec3(0.0,0.12,0.26))); }
void main(){
  vec2 p = vec2(gl_FragCoord.x, uRes.y - gl_FragCoord.y) / uDpr;
  float f = 0.0; vec2 g = vec2(0.0); float hue = 0.0; float ws = 0.0;
  for (int i = 0; i < ${MAX}; i++){
    vec4 b = uB[i]; if (b.z < 0.5) continue;
    vec2 d = p - b.xy; float R2 = 4.0 * b.z * b.z; float q = dot(d, d) / R2;
    if (q >= 1.0) continue;
    float t = 1.0 - q; float w = t * t * t / 0.421875;
    f += w; g += -6.0 * t * t * d / (R2 * 0.421875); hue += w * b.w; ws += w;
  }
  hue = ws > 0.0 ? hue / ws : 0.0;
  float aa = length(g) * 1.2 + 1e-4;
  float inside = smoothstep(-aa, aa, f - 1.0);
  vec2 gg = g / max(f, 1.0);
  vec3 n = normalize(vec3(-gg * 30.0, 1.0));
  float fres = pow(1.0 - n.z, 1.6);
  float rim = exp(-(f - 1.0) * 4.0) * inside;
  vec3 L = normalize(vec3(-0.5, -0.6, 0.7));
  float spec = pow(max(dot(reflect(-L, n), vec3(0.0, 0.0, 1.0)), 0.0), 40.0);
  vec3 tint = mix(film(0.35 + 0.55 * n.x + 0.4 * n.y + uT * 0.04), vec3(1.0, 0.78, 0.45), smoothstep(0.2, 0.8, hue));
  vec2 uv = gl_FragCoord.xy / uRes;
  vec3 bg = vec3(0.020, 0.024, 0.051) + vec3(0.33, 0.30, 0.95) * 0.05 * exp(-length(uv - vec2(0.72, 0.55)) * 2.2);
  vec3 body = bg * 1.3 + tint * (0.10 + fres * 0.95) + tint * rim * 0.55 + vec3(1.0) * spec * 0.9;
  vec3 col = mix(bg, body, inside);
  col += tint * exp(-abs(f - 1.0) * 3.0) * (1.0 - inside) * 0.22 * smoothstep(0.0, 0.6, f);
  col += (hash(gl_FragCoord.xy + fract(uT) * 37.0) - 0.5) * 0.02;
  gl_FragColor = vec4(col, 1.0);
}`;

  function start() {
    if (!gl) return;
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error("shader"); return s; };
    const prog = gl.createProgram()!;
    try {
      gl.attachShader(prog, sh(gl.VERTEX_SHADER, "attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }"));
      gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FS));
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) throw new Error("link");
    } catch { return; } // the poster stays
    stage.classList.add("gl");
    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, "p");
    gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const u = (n: string) => gl.getUniformLocation(prog, n);
    const uRes = u("uRes"), uT = u("uT"), uDpr = u("uDpr"), uB = u("uB");
    const data = new Float32Array(MAX * 4);
    let dpr = 1, last = performance.now(), visible = true;
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      W = Math.max(1, canvas.clientWidth); H = Math.max(1, canvas.clientHeight);
      const w = Math.floor(W * dpr), h = Math.floor(H * dpr);
      if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; gl.viewport(0, 0, w, h); }
    };
    const draw = (now: number) => {
      data.fill(0);
      balls.forEach((b, i) => { if (i < MAX) data.set([b.x, b.y, b.r, b.hue], i * 4); });
      gl.uniform2f(uRes, canvas.width, canvas.height); gl.uniform1f(uT, now / 1000);
      gl.uniform1f(uDpr, dpr); gl.uniform4fv(uB, data);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    resize(); window.addEventListener("resize", resize);
    const loop = (now: number) => {
      if (!visible) return;
      step(Math.min(0.033, (now - last) / 1000)); last = now;
      draw(now); requestAnimationFrame(loop);
    };
    document.addEventListener("visibilitychange", () => { visible = !document.hidden; if (visible) { last = performance.now(); requestAnimationFrame(loop); } });
    new IntersectionObserver(([e]) => { const was = visible; visible = e.isIntersecting && !document.hidden; if (visible && !was) { last = performance.now(); requestAnimationFrame(loop); } }).observe(stage);
    requestAnimationFrame(loop);
  }
  if (!reduce) start();
</script>

<style>
  .stage { position: relative; min-height: min(86vh, 840px); margin: 0; overflow: hidden; border-radius: 0 0 var(--r-l) var(--r-l); background: var(--void); }
  .poster { position: absolute; inset: 0; background:
    radial-gradient(22rem 22rem at 72% 45%, rgba(124,108,255,.30), transparent 70%),
    radial-gradient(14rem 14rem at 64% 60%, rgba(63,210,224,.22), transparent 70%), var(--void); }
  .stage.gl .poster { display: none; }
  #field { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: pan-y; cursor: grab; }
  .ui { position: relative; z-index: 2; max-width: 1180px; margin-inline: auto; padding: clamp(40px, 8vh, 96px) max(16px, 4vw) 32px; display: grid; gap: 40px; min-height: inherit; align-content: space-between; pointer-events: none; }
  .ui a, .ui button { pointer-events: auto; }
  .copy { max-width: 640px; }
  .chip { white-space: nowrap; max-width: 100%; overflow: hidden; display: inline-flex; align-items: center; gap: 10px; margin: 0; padding: 8px 14px 8px 10px; border-radius: var(--r-pill); background: var(--glass); border: 1px solid var(--glass-edge); backdrop-filter: blur(14px); font: 500 12.5px/1 var(--mono); color: var(--muted); }
  .chip b { display: inline !important; margin: 0 !important; color: var(--text); font-weight: 500; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--muted); }
  .stage.live .dot { background: var(--signal); animation: beat 1.1s var(--glide) infinite; }
  @keyframes beat { 0% { box-shadow: 0 0 0 0 rgba(255,181,71,.55); } 100% { box-shadow: 0 0 0 12px rgba(255,181,71,0); } }
  h1 { font: 200 clamp(42px, 7vw, 96px)/1.0 var(--display); letter-spacing: -0.035em; margin: 24px 0 20px; color: var(--text); text-wrap: balance; }
  h1 span { font-weight: 300; background: linear-gradient(95deg, var(--cherenkov-hi), var(--iris-a) 45%, var(--iris-b)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { max-width: 46ch; color: #c8cde0; font-size: clamp(16px, 1.5vw, 19px); margin: 0; }
  .cta { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .btn { font: 600 15px/1 var(--sans); padding: 16px 24px; border-radius: var(--r-pill); color: var(--text); text-decoration: none; background: var(--glass); border: 1px solid var(--glass-edge); backdrop-filter: blur(14px); transition: transform .45s var(--spring), box-shadow .45s var(--glide); }
  .btn:hover { transform: translateY(-2px) scale(1.03); color: var(--text); }
  .btn.primary { background: linear-gradient(120deg, var(--cherenkov), var(--iris-a)); border-color: transparent; color: #fff; box-shadow: 0 14px 40px -12px rgba(91,140,255,.75); }
  .hint { margin: 16px 0 0; font: 400 12.5px/1.4 var(--mono); color: var(--muted); }
  .tiles { display: flex; gap: 12px; flex-wrap: wrap; margin: 0; }
  .tile { flex: 1 1 150px; min-width: 0; padding: 16px 20px; border-radius: var(--r-m); background: var(--glass); border: 1px solid var(--glass-edge); backdrop-filter: blur(16px); }
  .tile dt { font: 500 11.5px/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .tile dd { margin: 10px 0 0; font: 300 26px/1 var(--display); font-variant-numeric: tabular-nums; color: var(--text); }
  .tile .note { font: 500 12px var(--sans); color: var(--signal); margin-left: 8px; }
  .card-pop { position: absolute; z-index: 3; min-width: 230px; padding: 16px 18px; border-radius: var(--r-m); background: rgba(16,20,40,.88); border: 1px solid var(--glass-edge); backdrop-filter: blur(18px); box-shadow: var(--shadow); font: 400 13px/1.55 var(--mono); color: var(--muted); transition: opacity .35s var(--glide), transform .5s var(--spring); }
  .card-pop[hidden] { display: block !important; opacity: 0; transform: scale(.6); pointer-events: none; }
  .card-pop :global(b) { display: block; font: 300 22px/1.2 var(--display); color: var(--text); margin-bottom: 4px; }
  .card-pop :global(a) { color: var(--cherenkov-hi); font-weight: 600; }
  /* The hero is the page title; Starlight's own h1 would repeat "Maya2C". */
  :global(main h1#_top) { display: none; }
  @media (prefers-reduced-motion: reduce) { .stage.live .dot { animation: none; } .btn { transition: none; } }
</style>
