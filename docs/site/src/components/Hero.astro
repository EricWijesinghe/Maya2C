---
// The homepage hero (L03, 2026-11-14): the benefit in checkable words, one
// line under it, two honest doors and the trust row; the emblem in a still
// committee orbit beside it. Acronyms live in the transaction graphic below,
// not in the headline.
//
// Motion: two aurora washes ease into place once (transform only, so the
// compositor moves them and nothing repaints; none under reduced motion, and
// nothing drifts forever). While the testnet runs, a pulse crosses the dot
// grid for each REAL finalized block (hero-pulses.ts, loaded only then). While
// it is paused (data/network-state.ts) no socket opens, no canvas script
// loads, and the chip states the finished run in bronze: a fact, not a warning.
import { Picture } from "astro:assets";
import emblem from "../assets/emblem.png";
import TrustStrip from "./TrustStrip.astro";
import { testnet } from "../data/network-state";
import { heroCtas } from "../data/home";

const { primary, secondary } = heroCtas(testnet.paused);
const halts = testnet.last.halts;
// Committee seats on the orbit: decoration, not a validator count.
const SEATS = [0, 1, 2, 3, 4, 5].map((i) => {
  const a = (i / 6) * Math.PI * 2 - Math.PI / 2;
  return { x: 200 + 150 * Math.cos(a), y: 200 + 150 * Math.sin(a), bronze: i % 2 === 1 };
});
---

<section class="hero not-content" aria-labelledby="hero-title" data-paused={testnet.paused ? "" : undefined}>
  <div class="bg" aria-hidden="true">
    <div class="aurora aurora-teal"></div>
    <div class="aurora aurora-bronze"></div>
    <div class="dots"></div>
    {!testnet.paused && <canvas class="pulses"></canvas>}
  </div>
  <div class="inner">
    <div class="copy">
      <p class="chip">
        <span class="dot" aria-hidden="true"></span>
        {testnet.paused ? (
          <span>Pre-mainnet · 7-day testnet run finished <span class="nw">{testnet.since}</span> · {halts} {halts === 1 ? "halt" : "halts"} · <a href={testnet.report}>report</a></span>
        ) : (
          <span>Pre-mainnet · maya-testnet-1 <b data-hero-state>connecting…</b><span data-hero-tip hidden> · block <b data-hero-height>—</b></span></span>
        )}
      </p>
      <h1 id="hero-title">Every transaction signed twice, so one broken algorithm cannot forge it.</h1>
      <p class="sub">Maya2C is a <span class="nw">layer-1</span> blockchain in Rust. Each payment carries two NIST post-quantum signatures, and a block, once final, is never reorganised. Claims link to their source.</p>
      <div class="cta">
        <a class="ui-btn ui-btn--primary" href={primary.href}>{primary.label}</a>
        <a class="ui-btn ui-btn--secondary" href={secondary.href}>{secondary.label}</a>
      </div>
      <TrustStrip />
    </div>
    <div class="art" aria-hidden="true">
      <svg viewBox="0 0 400 400" class="orbit">
        <defs>
          <linearGradient id="hero-ring" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" class="stop-teal" />
            <stop offset="1" class="stop-bronze" />
          </linearGradient>
          <radialGradient id="hero-core">
            <stop offset="0" class="core-in" />
            <stop offset="1" class="core-out" />
          </radialGradient>
        </defs>
        <circle cx="200" cy="200" r="118" class="core" />
        <circle cx="200" cy="200" r="190" class="ring ring-far" />
        <circle cx="200" cy="200" r="150" class="ring ring-main" />
        <circle cx="200" cy="200" r="104" class="ring ring-near" />
        {SEATS.map((s) => <line x1="200" y1="200" x2={s.x} y2={s.y} class="spoke" />)}
        {SEATS.map((s) => (
          <g class={s.bronze ? "seat seat-bronze" : "seat"}>
            <circle cx={s.x} cy={s.y} r="14" class="seat-halo" />
            <circle cx={s.x} cy={s.y} r="6" class="seat-dot" />
          </g>
        ))}
      </svg>
      <Picture src={emblem} formats={["avif", "webp"]} widths={[132, 264]} sizes="132px" width={132} height={132} alt="" class="emblem" loading="eager" />
    </div>
  </div>
</section>

<script>
  // Paused: nothing to show, so the canvas module is never fetched.
  const hero = document.querySelector<HTMLElement>(".hero");
  if (hero && !hero.hasAttribute("data-paused")) import("./hero-pulses").then((m) => m.mountPulses(hero));
</script>

<style>
  /* Full-bleed band; the copy sits in the page column. */
  .hero { position: relative; isolation: isolate; width: 100vw; margin: 0 0 0 calc(50% - 50vw); padding: var(--space-12) var(--gutter) var(--space-12); overflow: hidden; border-bottom: 1px solid var(--border); background: var(--grad-hero, linear-gradient(180deg, var(--surface-1), var(--bg))); }
  .bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .dots, .pulses { position: absolute; inset: 0; width: 100%; height: 100%; }
  .dots {
    background-image: radial-gradient(circle at 1px 1px, var(--border-strong) 1px, transparent 0);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 60% 40%, black 30%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 80% at 60% 40%, black 30%, transparent 75%);
  }
  /* The aurora: teal and bronze from the palette, settling once. */
  .aurora { position: absolute; border-radius: 50%; will-change: transform; animation: settle 1.6s var(--ease) both; }
  .aurora-teal { width: 52rem; height: 34rem; top: -16rem; right: -14rem; background: radial-gradient(closest-side, var(--deco-teal, color-mix(in srgb, var(--accent) 30%, transparent)), transparent); }
  .aurora-bronze { width: 40rem; height: 28rem; top: 4rem; right: 8rem; background: radial-gradient(closest-side, var(--deco-bronze, color-mix(in srgb, var(--bronze) 20%, transparent)), transparent); animation-delay: .15s; }
  @keyframes settle { from { transform: translate3d(3rem, -2rem, 0) scale(.9); } to { transform: none; } }
  /* Light: a warm paper wash of its own, no cloud. */
  :global([data-theme="light"]) .hero { background: linear-gradient(180deg, color-mix(in srgb, var(--bronze) 7%, var(--bg)) 0%, var(--bg) 100%); }
  :global([data-theme="light"]) .aurora-teal { opacity: .7; }
  :global([data-theme="light"]) .aurora-bronze { opacity: .9; }

  .inner { max-width: var(--content-max); margin: 0 auto; display: grid; gap: var(--space-8); align-items: center; }
  .copy { min-width: 0; }
  .chip { display: inline-flex; align-items: center; gap: var(--space-2); max-width: 100%; margin: 0; padding: var(--space-2) var(--space-3); border: 1px solid color-mix(in srgb, var(--bronze) 45%, transparent); border-radius: var(--r-lg); background: color-mix(in srgb, var(--bronze) 10%, var(--surface-1)); font-size: var(--type-body-sm-size); line-height: 1.4; color: var(--text); }
  .chip b { font-weight: var(--weight-semibold); }
  .chip a { color: var(--text); font-weight: var(--weight-semibold); text-decoration-color: var(--bronze); text-underline-offset: 3px; }
  .dot { flex: none; width: 8px; height: 8px; border-radius: var(--r-pill); background: var(--bronze); box-shadow: 0 0 0 3px color-mix(in srgb, var(--bronze) 25%, transparent); }
  .hero.live .dot { background: var(--success); box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 25%, transparent); }
  h1 { margin: var(--space-6) 0 var(--space-4); max-width: 21ch; font: 700 clamp(2.125rem, 1.2rem + 4.2vw, 4rem)/1.06 var(--type-display-1-font); letter-spacing: -0.035em; color: var(--text); text-wrap: balance; }
  .nw { white-space: nowrap; }
  .sub { margin: 0; max-width: 38rem; font-size: clamp(18px, 16px + .5vw, 20px); line-height: 1.5; color: var(--text-2); text-wrap: pretty; }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-8); }
  /* Full-width thumbs on a phone, side by side once there is room. */
  .cta .ui-btn { flex: 1 1 13rem; min-height: 48px; padding: 0 var(--space-6); font-size: var(--type-body-lg-size); text-decoration: none; }
  .cta .ui-btn--primary { color: var(--on-accent); }
  .cta .ui-btn--secondary { color: var(--text); }

  /* The orbit: still, and sized from the column so it never pushes the page wider. */
  .art { position: relative; justify-self: center; width: min(100%, 14rem); aspect-ratio: 1; }
  .orbit { width: 100%; height: 100%; overflow: visible; }
  .stop-teal { stop-color: var(--accent); }
  .stop-bronze { stop-color: var(--bronze); }
  .core-in { stop-color: color-mix(in srgb, var(--accent) 26%, transparent); }
  .core-out { stop-color: transparent; }
  .core { fill: url(#hero-core); }
  .ring { fill: none; }
  .ring-main { stroke: url(#hero-ring); stroke-width: 2; }
  .ring-far { stroke: var(--border-strong); stroke-width: 1; stroke-dasharray: 2 8; }
  .ring-near { stroke: color-mix(in srgb, var(--accent) 35%, transparent); stroke-width: 1; }
  .spoke { stroke: color-mix(in srgb, var(--accent) 18%, transparent); stroke-width: 1; }
  .seat-halo { fill: color-mix(in srgb, var(--accent) 18%, transparent); }
  .seat-dot { fill: var(--accent); }
  .seat-bronze .seat-halo { fill: color-mix(in srgb, var(--bronze) 22%, transparent); }
  .seat-bronze .seat-dot { fill: var(--bronze); }
  .art :global(.emblem) { position: absolute; top: 50%; left: 50%; width: 33%; height: auto; transform: translate(-50%, -50%); filter: drop-shadow(0 0 24px color-mix(in srgb, var(--accent) 45%, transparent)); }

  @media (min-width: 640px) { .cta .ui-btn { flex: 0 0 auto; } }
  @media (min-width: 960px) {
    .hero { padding-block: var(--space-20) var(--space-16); }
    .inner { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
    .art { width: min(100%, 26rem); }
  }
  @media (prefers-reduced-motion: reduce) { .aurora { animation: none; } }
</style>
