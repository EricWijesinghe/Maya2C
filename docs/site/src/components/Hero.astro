---
// The homepage hero (L03, 2026-11-14): the benefit in checkable words, one
// line under it, two honest doors and the trust row; the emblem in a committee
// orbit beside it. Acronyms live in the transaction graphic below, not in the
// headline.
//
// Colour: the whole band is a teal-to-ink wash (the og-card treatment), with
// the aurora glowing behind the orbit rather than in a corner. Light theme
// gets its own warm paper wash; the emblem sits on a deep teal disc in both,
// because the emblem artwork carries a dark smoke edge.
//
// Motion: once, on load, the committee seats light one by one and the ring
// closes; the aurora eases into place (transform and opacity only). The seats
// are an illustration, not validators, and the caption says so. While the
// testnet is paused, a comet then replays the finished run from the stop
// report: one lap per 24 h of it, 7.65 laps, then it rests where the run
// stopped. It is pausable (WCAG 2.2.2), never loops, and nothing runs under
// reduced motion. While the testnet runs, a pulse crosses
// the dot grid for each REAL finalized block (hero-pulses.ts, loaded only
// then). While it is paused (data/network-state.ts) no socket opens, no canvas
// script loads, and the chip states the finished run in bronze: a fact, not a
// warning.
import { Picture } from "astro:assets";
import emblem from "../assets/emblem.png";
import TrustStrip from "./TrustStrip.astro";
import { testnet } from "../data/network-state";
import { heroCtas, runLaps } from "../data/home";

const { primary, secondary } = heroCtas(testnet.paused);
const halts = testnet.last.halts;
const ended = testnet.last.to;
const runDays = `${parseInt(testnet.last.run, 10)}-day`;
const laps = runLaps(testnet.last.startUnix, testnet.last.endUnix);
const haltWord = halts === 1 ? "halt" : "halts";
// Seven seats, the committee size the mainnet plan names; drawn, not read from a network.
const N_SEATS = 7;
const SEATS = Array.from({ length: N_SEATS }, (_, i) => {
  const a = (i / N_SEATS) * Math.PI * 2 - Math.PI / 2;
  return { x: 200 + 150 * Math.cos(a), y: 200 + 150 * Math.sin(a), bronze: i % 2 === 1, i };
});
---

<section class="hero not-content" aria-labelledby="hero-title" data-paused={testnet.paused ? "" : undefined}>
  <div class="bg" aria-hidden="true">
    <div class="dots"></div>
    {!testnet.paused && <canvas class="pulses"></canvas>}
  </div>
  <div class="inner">
    <div class="copy">
      <p class="chip">
        <span class="dot" aria-hidden="true"></span>
        {testnet.paused ? (
          /* Phones: two lines in a rounded box, "Pre-mainnet" then the short fact; no separator ever ends a line. */
          <span class="chip-t"><span class="c1">Pre-mainnet</span> <span class="c2"><span class="wide">testnet run ended {ended}</span><span class="narrow">{runDays} run complete</span> · <span class="nw">{halts} {haltWord} · <a href={testnet.report}>report</a></span></span></span>
        ) : (
          <span>Pre-mainnet · maya-testnet-1 <b data-hero-state>connecting…</b><span data-hero-tip hidden> · block <b data-hero-height>—</b></span></span>
        )}
      </p>
      <h1 id="hero-title">Two post-quantum signatures on every transaction.</h1>
      <p class="sub"><b>A forger has to break both.</b> Maya2C is a <span class="nw">layer-1</span> blockchain, written in Rust and open source.</p>
      <div class="cta">
        <a class="ui-btn ui-btn--primary" href={primary.href}>{primary.label}</a>
        <a class="ui-btn ui-btn--secondary" href={secondary.href}>{secondary.label}</a>
      </div>
    </div>
    <figure class="art-wrap">
    <div class="art" aria-hidden="true">
      <div class="aurora aurora-teal"></div>
      <div class="aurora aurora-bronze"></div>
      <svg viewBox="0 0 400 400" class="orbit">
        <defs>
          <linearGradient id="hero-ring" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" class="stop-teal" />
            <stop offset="1" class="stop-bronze" />
          </linearGradient>
          <radialGradient id="hero-seat" cx=".5" cy=".42" r=".6">
            <stop offset="0" class="seat-in" />
            <stop offset="1" class="seat-out" />
          </radialGradient>
        </defs>
        <circle cx="200" cy="200" r="190" class="ring ring-far" />
        {SEATS.map((s) => <line x1="200" y1="200" x2={s.x} y2={s.y} class="spoke" style={`--i:${s.i}`} />)}
        <circle cx="200" cy="200" r="150" class="ring ring-main" pathLength="100" />
        <circle cx="200" cy="200" r="104" class="ring ring-near" />
        <circle cx="200" cy="200" r="98" class="seat-disc" />
        {SEATS.map((s) => (
          <g class={s.bronze ? "seat seat-bronze" : "seat"} style={`--i:${s.i}`}>
            <circle cx={s.x} cy={s.y} r="16" class="seat-halo" />
            <circle cx={s.x} cy={s.y} r="7" class="seat-dot" />
          </g>
        ))}
        {testnet.paused && (
          <g class="lap" style={`--laps:${laps}`} data-rp-lap>
            <path class="trail" d="M103.6 85.1 A150 150 0 0 1 200 50" />
            <circle cx="200" cy="50" r="13" class="blk-halo" />
            <circle cx="200" cy="50" r="6" class="blk" />
          </g>
        )}
      </svg>
      <Picture src={emblem} formats={["avif", "webp"]} widths={[180, 360]} sizes="(min-width: 960px) 168px, 28vw" width={180} height={180} alt="" class="emblem" loading="eager" />
    </div>
    {testnet.paused && (
      <figcaption class="replay">
        <span class="rp-still">Illustration of a committee. The {testnet.last.from} to {ended} run: <span class="nw">{halts} {haltWord}.</span></span>
        <span class="rp-on">Replay of the {testnet.last.from} to {ended} run, one lap per day: <span class="nw">{halts} {haltWord}.</span> The seats are drawn, not validators.</span>
        <span class="rp-day" aria-hidden="true" data-rp-day></span>
        <button type="button" class="rp-btn" data-rp-toggle>Pause replay</button>
      </figcaption>
    )}
    </figure>
    <div class="trust-row"><TrustStrip /></div>
  </div>
</section>

<script>
  // Paused: nothing to show, so the canvas module is never fetched.
  const hero = document.querySelector<HTMLElement>(".hero");
  if (hero && !hero.hasAttribute("data-paused")) import("./hero-pulses").then((m) => m.mountPulses(hero));
  // The one-shot seat walk only when motion is welcome; otherwise every seat is simply lit.
  if (hero && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    hero.classList.add("armed");
    // The replay: one lap per 24 h of the finished run; the day counter follows the laps.
    const lap = hero.querySelector<SVGGElement>("[data-rp-lap]");
    const day = hero.querySelector<HTMLElement>("[data-rp-day]");
    const btn = hero.querySelector<HTMLButtonElement>("[data-rp-toggle]");
    let n = 1;
    if (lap && day && btn) {
      lap.addEventListener("animationstart", () => { day.textContent = `day ${n}`; });
      lap.addEventListener("animationiteration", () => { day.textContent = `day ${++n}`; });
      lap.addEventListener("animationend", () => { day.textContent = "run complete"; btn.hidden = true; });
      btn.addEventListener("click", () => {
        const paused = hero.classList.toggle("rp-paused");
        btn.textContent = paused ? "Play replay" : "Pause replay";
      });
    }
  }
</script>

<style>
  /* Full-bleed band; the copy sits in the same column as the page below. */
  .hero {
    --ink: var(--bg);
    --wash-1: color-mix(in srgb, var(--accent) 30%, var(--ink));
    --wash-2: color-mix(in srgb, var(--accent) 12%, var(--ink));
    position: relative; isolation: isolate; width: 100vw; margin: 0 0 0 calc(50% - 50vw);
    padding: var(--space-6) var(--sl-content-pad-x, var(--gutter)) var(--space-8);
    overflow: hidden;
    --hero-bg:
      radial-gradient(90% 70% at 100% 0%, color-mix(in srgb, var(--accent) 34%, transparent), transparent 70%),
      radial-gradient(70% 60% at 0% 100%, color-mix(in srgb, var(--bronze) 16%, transparent), transparent 70%),
      linear-gradient(165deg, var(--wash-1) 0%, var(--wash-2) 55%, transparent 100%);
  }
  /* The page below keeps a perceptible tint, so the hero does not end in a flat black slab; each section adds its own band (maya.css .home-band). */
  /* Never below a visibly teal ink, top to foot; bronze stays an accent on teal, never a wash over near-black (it read brown-black). */
  :global(body:has(.hero)) { background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 14%, var(--bg)) 0, color-mix(in srgb, var(--accent) 9%, var(--bg)) 60rem, color-mix(in srgb, var(--accent) 8%, var(--bg)) 100%); }
  /* Light: a mint paper wash under the whole page, not neutral grey-white; sections add their own mint bands. */
  :global([data-theme="light"] body:has(.hero)) { background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 9%, var(--surface-1)) 0, color-mix(in srgb, var(--accent) 4%, var(--surface-1)) 50rem, color-mix(in srgb, var(--accent) 5%, var(--surface-1)) 100%); }
  :global([data-theme="light"]) .hero {
    --ink: var(--text);
    --hero-bg:
      radial-gradient(45% 55% at 100% 100%, color-mix(in srgb, var(--bronze) 22%, transparent), transparent 70%),
      linear-gradient(160deg, color-mix(in srgb, var(--accent) 26%, var(--surface-1)) 0%, color-mix(in srgb, var(--accent) 10%, var(--surface-1)) 50%, var(--surface-1) 100%);
  }
  .bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  /* The wash fades into the page tint instead of ending on a hard edge. */
  .bg::before { content: ""; position: absolute; inset: 0; background: var(--hero-bg); -webkit-mask-image: linear-gradient(180deg, black 65%, transparent); mask-image: linear-gradient(180deg, black 65%, transparent); }
  .dots, .pulses { position: absolute; inset: 0; width: 100%; height: 100%; }
  .dots {
    background-image: radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--accent) 30%, transparent) 1px, transparent 0);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 70% 40%, black 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 80% at 70% 40%, black 20%, transparent 75%);
  }

  .inner { max-width: var(--sl-content-width, var(--content-max)); margin: 0 auto; display: grid; gap: var(--space-6); align-items: center; }
  .copy { min-width: 0; }
  .hero .chip { display: inline-flex; align-items: center; gap: var(--space-2); max-width: 100%; margin: 0; padding: var(--space-2) var(--space-3); border: 1px solid color-mix(in srgb, var(--bronze) 50%, transparent); border-radius: var(--r-pill); background: color-mix(in srgb, var(--bronze) 14%, var(--surface-1)); font-size: var(--type-body-size); line-height: 1.4; color: var(--text); }
  .chip b { font-weight: var(--weight-semibold); }
  /* Phones: a two-line rounded box, never a pill wrapped to three lines with a dangling separator. */
  .chip-t { display: grid; }
  .c1 { font-weight: var(--weight-semibold); }
  .wide { display: none; }
  @media (max-width: 639.98px) { .hero .chip { align-items: flex-start; border-radius: var(--r-md); font-size: var(--type-body-sm-size); } .hero .chip .dot { margin-top: .45em; } }
  @media (min-width: 640px) { .chip-t { display: inline; } .c1::after { content: " ·"; } .wide { display: inline; } .narrow { display: none; } }
  .chip a { color: var(--text); font-weight: var(--weight-semibold); text-decoration-color: var(--bronze); text-underline-offset: 3px; }
  .dot { flex: none; width: 8px; height: 8px; border-radius: var(--r-pill); background: var(--bronze); box-shadow: 0 0 0 3px color-mix(in srgb, var(--bronze) 25%, transparent); }
  .hero.live .dot { background: var(--success); box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 25%, transparent); }
  h1 { margin: var(--space-5) 0 var(--space-4); max-width: 18ch; font: 700 clamp(2rem, 1.25rem + 3.4vw, 3.5rem)/1.1 var(--type-display-1-font); letter-spacing: -0.02em; color: var(--text); text-wrap: balance; }
  .nw { white-space: nowrap; }
  /* The second beat of the headline in full text colour; the rest one step down, mixed toward --text so it holds 4.5:1 on the teal wash. */
  .hero .sub { margin: 0; max-width: 36rem; font-size: clamp(18px, 16px + .5vw, 20px); line-height: 1.5; color: color-mix(in srgb, var(--text) 80%, var(--text-2)); text-wrap: pretty; }
  .sub b { font-weight: var(--weight-semibold); color: var(--text); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
  /* Full-width thumbs on a phone, side by side once there is room. */
  .cta .ui-btn { flex: 1 1 13rem; min-height: 48px; padding: 0 var(--space-6); font-size: var(--type-body-lg-size); text-decoration: none; }
  .cta .ui-btn--primary { color: var(--on-accent); box-shadow: 0 10px 30px -12px color-mix(in srgb, var(--accent) 80%, transparent); }
  .cta .ui-btn--secondary { color: var(--text); }
  .trust-row { min-width: 0; }

  /* The orbit: on a phone it follows the buttons, so chip, headline and the primary button fit a 360x640 screen, and its top
     slice shows on that first screen; at least 70vw wide, sized from the column so it never pushes the page wider. */
  .art-wrap { margin: 0; min-width: 0; display: grid; justify-items: center; gap: var(--space-3); }
  .art { position: relative; width: min(76vw, 22rem); aspect-ratio: 1; }
  .orbit { position: relative; width: 100%; height: 100%; overflow: visible; }
  .aurora { position: absolute; border-radius: 50%; pointer-events: none; will-change: transform; }
  .aurora-teal { inset: -30%; background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 50%, transparent), transparent); }
  .aurora-bronze { inset: -10% -40% -40% -10%; background: radial-gradient(closest-side, color-mix(in srgb, var(--bronze) 30%, transparent), transparent); }
  :global([data-theme="light"]) .aurora-teal { opacity: .6; }
  /* Light: the bronze lives in the corner wash and the ring, not over the teal glow, where it turned muddy. */
  :global([data-theme="light"]) .aurora-bronze { display: none; }
  .stop-teal { stop-color: var(--accent); }
  .stop-bronze { stop-color: var(--bronze); }
  .seat-in { stop-color: color-mix(in srgb, var(--accent) 34%, var(--ink)); }
  .seat-out { stop-color: color-mix(in srgb, var(--accent) 10%, var(--ink)); }
  .seat-disc { fill: url(#hero-seat); stroke: color-mix(in srgb, var(--accent) 45%, transparent); stroke-width: 1.5; }
  .ring { fill: none; }
  .ring-main { stroke: url(#hero-ring); stroke-width: 3; }
  .ring-far { stroke: color-mix(in srgb, var(--accent) 28%, transparent); stroke-width: 1; stroke-dasharray: 2 8; }
  .ring-near { stroke: color-mix(in srgb, var(--accent) 45%, transparent); stroke-width: 1; }
  .spoke { stroke: color-mix(in srgb, var(--accent) 30%, transparent); stroke-width: 1; }
  .seat-halo { fill: color-mix(in srgb, var(--accent) 24%, transparent); }
  .seat-dot { fill: var(--accent); }
  .seat-bronze .seat-halo { fill: color-mix(in srgb, var(--bronze) 28%, transparent); }
  .seat-bronze .seat-dot { fill: var(--bronze); }
  /* The replay comet: one lap per 24 h of the finished run, then it rests where the run stopped. */
  .lap { opacity: 0; transform-box: view-box; transform-origin: 200px 200px; }
  .trail { fill: none; stroke: var(--accent); stroke-width: 4; stroke-linecap: round; opacity: .45; }
  .blk { fill: var(--accent); }
  .blk-halo { fill: color-mix(in srgb, var(--accent) 35%, transparent); }
  .armed .lap { animation: lap 6s linear calc(.35s + 7 * .18s + .5s) var(--laps) both; }
  .rp-paused .lap { animation-play-state: paused; }
  @keyframes lap { from { opacity: 1; transform: rotate(0deg); } to { opacity: 1; transform: rotate(360deg); } }
  .replay { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-1) var(--space-3); max-width: 26rem; margin: 0; font-size: var(--type-body-sm-size); line-height: 1.45; text-align: center; color: color-mix(in srgb, var(--text) 55%, var(--text-2)); }
  .rp-on, .rp-day, .rp-btn { display: none; }
  .armed .rp-on { display: inline; }
  .armed .rp-still { display: none; }
  .armed .rp-day:not(:empty) { display: inline-block; padding: 0 var(--space-2); border-radius: var(--r-pill); background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--text); font-variant-numeric: tabular-nums; font-weight: var(--weight-semibold); }
  .armed .rp-btn:not([hidden]) { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-4); border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); border-radius: var(--r-pill); background: color-mix(in srgb, var(--accent) 10%, transparent); color: var(--text); font: inherit; font-weight: var(--weight-semibold); cursor: pointer; }
  .rp-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .art :global(.emblem) { position: absolute; top: 50%; left: 50%; width: 37.5%; height: auto; transform: translate(-50%, -50%); border-radius: 50%;
    /* A teal frame seats the dark-edged emblem in the orbit instead of leaving it a pasted disc on pale paper. */
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 70%, transparent), 0 0 0 9px color-mix(in srgb, var(--accent) 22%, transparent), 0 0 48px color-mix(in srgb, var(--accent) 55%, transparent); }

  /* One-shot motion, armed by the script only when motion is welcome. */
  .armed .aurora { animation: settle 1.6s var(--ease) both; }
  .armed .aurora-bronze { animation-delay: .15s; }
  .armed .seat { animation: seat-in .5s var(--ease) both; animation-delay: calc(.35s + var(--i) * .18s); }
  .armed .spoke { animation: fade-in .5s var(--ease) both; animation-delay: calc(.35s + var(--i) * .18s); }
  .armed .ring-main { stroke-dasharray: 100; animation: close-ring 1.4s var(--ease) .3s both; }
  @keyframes settle { from { opacity: 0; transform: translate3d(1.5rem, -1rem, 0) scale(.9); } to { opacity: 1; transform: none; } }
  @keyframes seat-in { from { opacity: .15; } to { opacity: 1; } }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes close-ring { from { stroke-dashoffset: 100; } to { stroke-dashoffset: 0; } }

  @media (min-width: 640px) { .cta .ui-btn { flex: 0 0 auto; } }
  @media (min-width: 960px) {
    .hero { padding-block: var(--space-16) var(--space-12); }
    .inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); column-gap: var(--space-8); }
    /* The art fills the second column: about 28 rem at 1440, no dead zone between copy and orbit. */
    .art { width: min(100%, 28rem); }
    .trust-row { grid-column: 1 / -1; }
  }
  @media (prefers-reduced-motion: reduce) { .armed .aurora, .armed .seat, .armed .spoke, .armed .ring-main, .armed .lap { animation: none; } }
</style>
