---
// Starlight's head, plus structured data for the page itself: a breadcrumb
// trail (Home > Guides > page) and, for every docs page, a TechArticle with
// its own headline and description. The site-wide graph in astro.config.mjs
// says what Maya2C is; this says what each page is, so a result can show the
// path and the page's own summary instead of the site's.
import Default from "@astrojs/starlight/components/Head.astro";
import Maintenance from "./Maintenance.astro";
import ogPages from "../data/og-pages.json";
import { testnet } from "../data/network-state";
// Emitted by scripts/ingest.mjs: last commit date per page and the FAQ entries (audit W-13).
import seo from "../seo.generated.json";
// Body font, preloaded so text paints in the brand face without a swap on every page.
import interLatin from "@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url";

const route = Astro.locals.starlightRoute;
const { title, description, template } = route.entry.data;
const site = "https://maya2c.dev";
const url = new URL(Astro.url.pathname, site).href;
const parts = Astro.url.pathname.split("/").filter(Boolean);
const SECTIONS: Record<string, string> = { guides: "Guides", reference: "Reference" };

const crumbs = [{ name: "Maya2C", item: `${site}/` }];
if (parts[0] && SECTIONS[parts[0]] && parts.length > 1) {
  crumbs.push({ name: SECTIONS[parts[0]], item: `${site}/${parts[0]}/` });
}
if (parts.length) crumbs.push({ name: title, item: url });

const graph: object[] = [];
if (crumbs.length > 1) {
  graph.push({
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: c.item })),
  });
}
const path = Astro.url.pathname.replace(/\/?$/, "/");
const dateModified = (seo.modified as Record<string, string | null>)[path] ?? null;
if (template !== "splash") {
  graph.push({
    "@type": "TechArticle",
    headline: title,
    ...(description ? { description } : {}),
    ...(dateModified ? { dateModified } : {}),
    url,
    inLanguage: "en",
    isPartOf: { "@id": `${site}/#website` },
    publisher: { "@id": `${site}/#org` },
  });
}
if (path === "/guides/faq/") {
  graph.push({
    "@type": "FAQPage",
    mainEntity: seo.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  });
}
// A card per main page (scripts/gen-og.mjs, committed); otherwise one 1200x630 card per section, in that section's motif.
const slug = parts.join("/");
const pageCard = ogPages.find((p) => p.slug === slug);
const CARDS: Record<string, string> = { guides: "guides", reference: "reference", experience: "experience", support: "support" };
const sectionCard = parts[0] && CARDS[parts[0]] ? `${site}/og/${CARDS[parts[0]]}.png` : `${site}/og-card.png`;
const card = pageCard ? `${site}/og/pages/${slug.replace(/\//g, "-")}.png` : sectionCard;
const cardAlt = pageCard
  ? `${pageCard.title}: Maya2C link preview`
  : parts[0] && CARDS[parts[0]] ? `${title}: ${CARDS[parts[0]]} card for Maya2C` : "Maya2C: post-quantum layer-1 blockchain";
// A page that sets its own og:title in frontmatter `head` (the home page) gets the same text on X-style cards.
const ogTitle = route.entry.data.head?.find((h) => h.tag === "meta" && h.attrs?.property === "og:title")?.attrs?.content;
const shareTitle = typeof ogTitle === "string" ? ogTitle : title;
const ld = graph.length ? JSON.stringify({ "@context": "https://schema.org", "@graph": graph }) : null;
---

<Default />
{/* Link previews. Set per page here, not in astro.config.mjs, so each section shows its own card. */}
<meta property="og:image" content={card} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={cardAlt} />
<meta name="twitter:image" content={card} />
{/* Starlight sets twitter:card but not the text, so a shared link showed no title or summary on X-style cards. */}
<meta name="twitter:title" content={shareTitle} />
{description && <meta name="twitter:description" content={description} />}
<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
{/* The home hero fetches these at once; opening the connections early saves a round trip. Not while paused: nothing is fetched then. */}
{parts.length === 0 && !testnet.paused && (
  <>
    <link rel="preconnect" href="https://explorer.maya2c.dev" crossorigin />
    <link rel="preconnect" href="https://rpc.maya2c.dev" crossorigin />
  </>
)}
{ld &&<script type="application/ld+json" set:html={ld} />}
<Maintenance />
