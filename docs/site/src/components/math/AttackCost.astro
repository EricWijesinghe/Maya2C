<!-- log2(attack work) against a size parameter. The four exponential curves
     are straight lines on this axis; Shor's polynomial curve stays near the
     floor. Formulas are in growth.ts; nothing here is a benchmark. -->
<figure class="attack" data-attack>
  <label>
    Size parameter s = <output data-s-out>128</output>
    <input type="range" min="8" max="512" step="8" value="128" data-s aria-describedby="attack-readout" />
  </label>
  <svg viewBox="0 0 360 240" role="img" aria-label="Plot of log base 2 of attack work against the size parameter. Exponential lines rise steeply; the polynomial Shor line stays low." data-svg></svg>
  <ul class="legend">
    <li><span class="sw brute"></span>brute force, s bits</li>
    <li><span class="sw grover"></span>Grover, s bits (quantum)</li>
    <li><span class="sw sieve"></span>lattice sieving, classical, beta</li>
    <li><span class="sw sieveq"></span>lattice sieving, quantum, beta</li>
    <li><span class="sw shor"></span>Shor, polynomial in s (quantum)</li>
  </ul>
  <p id="attack-readout" aria-live="polite" data-readout></p>
</figure>

<script>
  import { SERIES, log2Cost, type Series } from "./growth";

  const NS = "http://www.w3.org/2000/svg";
  // Colours live in the stylesheet as tokens (one class per series), so the
  // plot follows a theme switch with no redraw. Quantum series are dashed:
  // the legend never relies on colour alone.
  const CLASS: Record<Series, string> = {
    brute: "s-brute",
    grover: "s-grover",
    sieve: "s-sieve",
    sieveQuantum: "s-sieveq",
    shor: "s-shor",
  };
  const W = 360;
  const H = 240;
  const PAD = 28;
  const S_MAX = 512;
  const Y_MAX = 540; // log2 ops; brute force at 512 bits is 512
  const X = (s: number) => PAD + (s / S_MAX) * (W - PAD - 8);
  const Y = (v: number) => H - PAD - (Math.min(v, Y_MAX) / Y_MAX) * (H - PAD - 8);

  const root = document.querySelector<HTMLElement>("[data-attack]");
  if (root) mount(root);

  function mount(figure: HTMLElement) {
    const range = figure.querySelector<HTMLInputElement>("[data-s]")!;
    const out = figure.querySelector<HTMLElement>("[data-s-out]")!;
    const svg = figure.querySelector<SVGSVGElement>("[data-svg]")!;
    const readout = figure.querySelector<HTMLElement>("[data-readout]")!;

    function el(name: string, attrs: Record<string, string>) {
      const node = document.createElementNS(NS, name);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
      svg.appendChild(node);
      return node;
    }

    function drawStatic() {
      el("line", { x1: String(PAD), y1: String(H - PAD), x2: String(W - 8), y2: String(H - PAD), class: "axis" });
      el("line", { x1: String(PAD), y1: "8", x2: String(PAD), y2: String(H - PAD), class: "axis" });
      // 2^128: the classical security target most readers will recognise.
      el("line", { x1: String(PAD), y1: String(Y(128)), x2: String(W - 8), y2: String(Y(128)), class: "ref", "stroke-dasharray": "4 4" });
      el("text", { x: String(W - 10), y: String(Y(128) - 4), "text-anchor": "end", class: "lbl", "font-size": "10" })
        .textContent = "2^128";
      el("text", { x: String(PAD), y: "10", class: "lbl", "font-size": "10" }).textContent = "log2 work";
      el("text", { x: String(W - 8), y: String(H - 8), "text-anchor": "end", class: "lbl", "font-size": "10" })
        .textContent = "s";
      for (const series of SERIES) {
        const points: string[] = [];
        for (let s = 8; s <= S_MAX; s += 8) points.push(`${X(s).toFixed(1)},${Y(log2Cost(series, s)).toFixed(1)}`);
        el("polyline", { points: points.join(" "), fill: "none", class: `series ${CLASS[series]}`, "stroke-width": "2" });
      }
    }

    function update() {
      const s = Number(range.value);
      out.textContent = String(s);
      svg.querySelectorAll("[data-marker]").forEach((n) => n.remove());
      const marker = el("line", { x1: String(X(s)), y1: "8", x2: String(X(s)), y2: String(H - PAD), class: "marker", "stroke-dasharray": "2 3" });
      marker.setAttribute("data-marker", "");
      const v = (series: Series) => log2Cost(series, s).toFixed(1);
      readout.textContent =
        `At s = ${s}: brute force 2^${v("brute")} operations; Grover about 2^${v("grover")}; ` +
        `sieving with beta = ${s} about 2^${v("sieve")} classically or 2^${v("sieveQuantum")} quantum; ` +
        `Shor about ${Math.round(s ** 3).toLocaleString("en-US")} operations (polynomial).`;
    }

    drawStatic();
    range.addEventListener("input", update);
    update();
  }
</script>

<style>
  .attack { margin: 1.5rem 0; max-width: 40rem; }
  .attack label { display: block; margin-bottom: 0.4rem; }
  .attack input[type="range"] { width: 100%; min-height: 44px; }
  /* Two families, one hue each: brute force in bronze, lattice sieving in
     steel; Shor in danger, the attack that breaks today's public-key crypto.
     Solid = classical, dashed = quantum. Every value is a token measured at
     3:1 or more on --surface-2 in both themes (design/visual/site-shell.mjs). */
  .attack { --plot: var(--surface-2); }
  .attack svg { width: 100%; height: auto; background: var(--plot); border: 1px solid var(--border); border-radius: var(--r-md); }
  .attack :global(.series) { stroke-linejoin: round; }
  .attack :global(.s-brute) { stroke: var(--bronze); }
  .attack :global(.s-grover) { stroke: var(--bronze); stroke-dasharray: 6 4; }
  .attack :global(.s-sieve) { stroke: var(--steel); }
  .attack :global(.s-sieveq) { stroke: var(--steel); stroke-dasharray: 6 4; }
  .attack :global(.s-shor) { stroke: var(--danger); stroke-dasharray: 2 3; stroke-width: 2.5; }
  .attack :global(.axis) { stroke: var(--chart-axis); }
  .attack :global(.ref) { stroke: var(--text-3); }
  .attack :global(.marker) { stroke: var(--accent); stroke-width: 1.5; }
  .attack :global(.lbl) { fill: var(--text-2); font-family: var(--mono); }
  .attack .legend { list-style: none; padding: 0; margin: 0.6rem 0; display: grid; gap: 0.2rem; font-size: 0.9rem; }
  .attack .sw { display: inline-block; width: 1.4rem; height: 0; border-top: 3px solid; margin-right: 0.45rem; vertical-align: 0.25rem; }
  .attack .brute { border-color: var(--bronze); }
  .attack .grover { border-color: var(--bronze); border-top-style: dashed; }
  .attack .sieve { border-color: var(--steel); }
  .attack .sieveq { border-color: var(--steel); border-top-style: dashed; }
  .attack .shor { border-color: var(--danger); border-top-style: dotted; }
  .attack p { font-size: 0.92rem; }
</style>
