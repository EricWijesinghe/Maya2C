---
// Horizon ideas (CATALOG section I), grouped by rung: how far each one is today.
// Every row says whether its prior-art search has been run, because the doc
// says a novelty claim needs one and an idea with no search has none.
import { RUNGS, type Ecosystem, type Rung } from "../data/ecosystem";

interface Props {
  eco: Ecosystem;
}
const { eco } = Astro.props;

const RUNG_LABEL: Record<Rung, string> = {
  R0: "buildable with what exists",
  R1: "needs engineering",
  R2: "needs research",
};
---

<section class="horizon not-content" aria-labelledby="horizon-h">
  <h2 id="horizon-h">Horizon ideas</h2>
  <p class="intro">Ideas from science fiction, each starting from a need. Not scheduled; none is a claim of novelty.</p>
  <div class="rungs">
    {RUNGS.map((r) => {
      const ideas = eco.horizon.filter((h) => h.rung === r);
      return (
        <div class="rung">
          <h3><span class={`rg rg-${r}`}>{r}</span> {RUNG_LABEL[r]} <span class="n">({ideas.length})</span></h3>
          <ul>
            {ideas.map((h) => (
              <li class="idea">
                <h4>{h.id}</h4>
                <p class="need">{h.need}</p>
                <p class="builds"><span>Builds on</span> {h.builds}</p>
                <p class="prior">
                  {h.priorArt ? (
                    <a href={h.priorArt}>prior-art note</a>
                  ) : null}
                  {h.searchPending ? <span class="pending">prior-art search not yet run</span> : null}
                  {!h.priorArt && !h.searchPending ? <span class="pending">{h.note}</span> : null}
                </p>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
</section>

<style>
  .horizon { margin: 2.5rem 0; color: var(--lede); }
  .horizon h2 { font: 800 1.3rem/1.2 var(--display); color: var(--text); margin: 0 0 .4rem; }
  .intro { margin: 0 0 1.2rem; color: var(--muted); font-size: .9rem; }
  .rungs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: start; }
  .rung h3 { font: 700 .9rem/1.3 var(--display); color: var(--text); margin: 0 0 .6rem; }
  .rung .n { color: var(--muted); font-weight: 500; }
  .rung ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .7rem; }
  .idea { padding: 1rem 1.1rem; border-radius: var(--r-m); background: var(--glass); border: 1px solid var(--glass-edge); }
  .idea h4 { margin: 0 0 .35rem; font: 700 .95rem var(--mono); color: var(--text); overflow-wrap: anywhere; }
  .need { margin: 0 0 .45rem; font-size: .9rem; }
  .builds, .prior { margin: 0 0 .25rem; font-size: .8rem; color: var(--muted); overflow-wrap: anywhere; }
  .builds span { font-weight: 600; }
  .prior a { color: var(--accent-text); font-weight: 600; }
  .pending { font-style: italic; }
  .rg { font: 800 .7rem var(--mono); padding: .15rem .45rem; border-radius: var(--r-pill); border: 1px solid currentColor; }
  .rg-R0 { color: var(--verified); } .rg-R1 { color: var(--cherenkov-hi); } .rg-R2 { color: var(--gold); }
  @media (max-width: 900px) { .rungs { grid-template-columns: minmax(0, 1fr); } }
</style>
