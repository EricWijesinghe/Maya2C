---
// The network in 3D: validators on an inner shell, peers on an outer one, and
// a pulse from a proposer to the others for every block the explorer streams.
// The counts and the pulses are real; where a node sits is art, and the
// caption says so. Static SVG until the scene loads, and for good when 3D is
// not run (reduced motion, low-end device, no WebGL): see src/scripts/gate3d.ts.
import SourceTip from "./SourceTip.astro";
const ring = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * Math.PI * 2;
  return { x: 200 + Math.cos(a) * 120, y: 150 + Math.sin(a) * 90 };
});
---

<figure class="not-content nc" data-nc>
  <div class="nc-view">
    <svg class="nc-poster" viewBox="0 0 400 300" aria-hidden="true">
      {ring.map((p, i) => ring.slice(i + 1).map((q) => <line x1={p.x} y1={p.y} x2={q.x} y2={q.y} />))}
      {ring.map((p) => <circle cx={p.x} cy={p.y} r="5" />)}
    </svg>
    <canvas data-nc-canvas aria-hidden="true"></canvas>
    <p class="nc-quiet" data-nc-quiet>Paused for the next genesis. Art, not data.</p>
  </div>
  <figcaption>
    <span><b data-nc-val>—</b> validators · <b data-nc-peers>—</b> peers · <b data-nc-blocks>0</b> blocks seen</span>
    <SourceTip text="Counts: get_bft_status (validators) and status.maya2c.dev /api/live (peers). A pulse is a real block from the explorer stream. Where each node sits is abstract art, not a map." />
  </figcaption>
</figure>

<script>
  import { canRun3D, whenNear } from "../scripts/gate3d";
  import { bft, fmt, onBlocks, peers } from "../scripts/live";
  for (const root of document.querySelectorAll<HTMLElement>("[data-nc]")) {
    whenNear(root, async () => {
      const canvas = root.querySelector<HTMLCanvasElement>("[data-nc-canvas]")!;
      const [b, p] = await Promise.all([bft(), peers()]);
      // No live counts: keep the art poster and say so, rather than an empty scene.
      let scene: import("../scripts/scene3d").Constellation | null = null;
      if (b && b.committee > 0) {
        root.querySelector<HTMLElement>("[data-nc-quiet]")!.hidden = true;
        if (canRun3D()) {
          try {
            scene = (await import("../scripts/scene3d")).mountConstellation(canvas);
            root.classList.add("gl");
          } catch { /* the poster stays */ }
        }
      }
      if (b) { root.querySelector("[data-nc-val]")!.textContent = fmt(b.committee); scene?.setValidators(b.committee); }
      if (p && Array.isArray(p.peers)) { root.querySelector("[data-nc-peers]")!.textContent = fmt(p.peers.length); scene?.setPeers(p.peers.length); }
      let seen = 0;
      onBlocks((blk) => { root.querySelector("[data-nc-blocks]")!.textContent = fmt(++seen); scene?.block(blk.height); });
    });
  }
</script>

<style>
  .nc { margin: var(--space-5) 0; }
  /* Fixed aspect ratio: the canvas replaces the poster with no layout shift. */
  .nc-view { position: relative; aspect-ratio: 4 / 3; max-height: 460px; width: 100%; border-radius: var(--r-3); overflow: hidden; background: radial-gradient(60% 60% at 50% 50%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%), var(--bg); border: 1px solid var(--line); }
  .nc-poster { position: absolute; inset: 0; width: 100%; height: 100%; }
  .nc-poster line { stroke: var(--accent); stroke-opacity: .16; }
  .nc-poster circle { fill: var(--accent-text); }
  .nc canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .nc.gl .nc-poster { display: none; }
  .nc-quiet { position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%); margin: 0; padding: 6px 12px; border-radius: 999px; background: var(--glass); border: 1px solid var(--line); font: 500 12.5px/1.3 var(--mono); color: var(--text-2); text-align: center; width: max-content; max-width: calc(100% - 32px); }
  .nc-quiet[hidden] { display: none; }
  .nc figcaption { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-top: 10px; font-size: 14px; color: var(--text-2); }
  .nc figcaption b { color: var(--text); font-variant-numeric: tabular-nums; }
</style>
