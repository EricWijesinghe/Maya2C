---
// The facts band under the homepage hero. Every figure comes from a file the
// build writes (src/data/facts.ts says which); each card names its source and
// links to it. Static HTML: no script, nothing to animate, nothing to hash.
import health from "../../public/health.json";
import progress from "../../public/progress.json";
import { homeFacts } from "../data/facts";

const facts = homeFacts(health, progress);
---

<section class="not-content stat-band" aria-label="Facts from the repository">
  {facts.map((f) => (
    <a class="stat" href={f.href}>
      <span class={f.value.length > 10 ? "num long" : "num"}>{f.value}</span>
      <span class="label">{f.label}</span>
      <span class="source">{f.source}</span>
    </a>
  ))}
</section>

<style>
  .stat-band { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 14px; margin: 28px 0 8px; }
  .stat { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-radius: var(--r-m); border: 1px solid var(--glass-edge); background: var(--glass); text-decoration: none; transition: border-color .3s, transform .45s var(--spring); }
  .stat:hover, .stat:focus-visible { border-color: var(--accent); transform: translateY(-2px); }
  .num { font: 300 clamp(26px, 3.4vw, 38px)/1 var(--display); font-variant-numeric: tabular-nums; color: var(--text); overflow-wrap: anywhere; }
  /* A release tag ("v0.1.0-testnet.4") at full size breaks mid-word in a 240 px card. */
  .num.long { font-size: clamp(20px, 1.9vw, 24px); line-height: 1.3; }
  .label { font: 600 14.5px/1.3 var(--sans); color: var(--lede); }
  .source { font: 500 11.5px/1.4 var(--mono); color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .stat { transition: none; } }
</style>
