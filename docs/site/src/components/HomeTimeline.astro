---
// Where the network stands, as four stops on one line. Dates come from
// data/network-state.ts (copied from the stop report). Re-genesis and mainnet
// carry no date: none is committed, and a guessed one would be a promise.
import { testnet } from "../data/network-state";

const run = testnet.last;
const stops = [
  {
    state: "done", title: "7-day testnet run",
    line: `${run.from} to ${run.to} · ${run.halts} ${run.halts === 1 ? "halt" : "halts"}`,
    href: "/health/",
  },
  {
    state: testnet.paused ? "now" : "done", title: testnet.paused ? "Paused" : "Restarted",
    line: testnet.paused ? `since ${testnet.since}, on purpose` : "the testnet runs again",
    href: "/guides/faq/#is-mainnet-live",
  },
  {
    state: "next", title: "Re-genesis",
    line: "fresh testnet genesis, no date set",
    href: "/reference/launch-checklist/",
  },
  {
    state: "next", title: "Mainnet",
    line: "after the gates pass, no date set",
    href: "/reference/mainnet-v1-plan/",
  },
];
---

<section class="not-content tl" aria-labelledby="tl-title">
  <h2 id="tl-title" class="home-h2">Where the network stands</h2>
  <ol data-timeline>
    {stops.map((s) => (
      <li class={`stop stop-${s.state}`}>
        <a href={s.href} aria-current={s.state === "now" ? "step" : undefined}>
          <span class="pin" aria-hidden="true"></span>
          <span class="t">{s.title}</span>
          <span class="l">{s.line}</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .tl { margin: 0; }
  ol { --rail: var(--border-strong); list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); }
  .stop { position: relative; margin: 0; }
  /* The rail: a line through every pin, solid where the network has been. */
  .stop::before { content: ""; position: absolute; left: 11px; top: 0; bottom: 0; width: 2px; background: var(--rail); }
  .stop:first-child::before { top: 24px; }
  .stop:last-child::before { bottom: calc(100% - 24px); }
  .stop-done::before { background: linear-gradient(var(--accent), var(--bronze)); }
  a { position: relative; display: grid; grid-template-columns: 24px minmax(0, 1fr); column-gap: var(--space-4); align-items: start; min-height: 44px; padding: var(--space-3) var(--space-3) var(--space-3) 0; border-radius: var(--r-md); color: inherit; text-decoration: none; transition: background-color var(--dur-2) var(--ease); }
  a:hover { background: var(--surface-2); }
  .pin { grid-row: span 2; justify-self: center; margin-top: 4px; width: 16px; height: 16px; border-radius: var(--r-pill); border: 2px solid var(--rail); background: var(--bg); }
  .stop-done .pin { border-color: var(--accent); background: var(--accent); }
  .stop-now .pin { border-color: var(--bronze); background: var(--bg); box-shadow: 0 0 0 5px color-mix(in srgb, var(--bronze) 22%, transparent); }
  .t { font: var(--weight-semibold) var(--type-body-lg-size)/1.4 var(--font-sans); color: var(--text); }
  .l { font-size: var(--type-body-sm-size); line-height: 1.45; color: var(--text-2); }
  .stop-next .t { color: var(--text-2); }

  @media (min-width: 760px) {
    ol { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .stop::before { left: 0; right: 0; top: 19px; bottom: auto; width: auto; height: 2px; }
    .stop:first-child::before { left: 50%; top: 19px; }
    .stop:last-child::before { right: 50%; bottom: auto; }
    .stop-done::before { background: linear-gradient(90deg, var(--accent), var(--bronze)); }
    a { grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; row-gap: var(--space-1); padding: var(--space-3) var(--space-2); }
    .pin { grid-row: auto; margin: 0 0 var(--space-2); }
  }
</style>
