---
// A row of clickable orbs: one title, one short line, one link each.
// Owner rule (2026-10-04): graphics over text; click to learn more.
interface Item { title: string; line: string; href: string; live?: boolean }
interface Props { items: Item[] }
const { items } = Astro.props;
---

<div class="not-content orb-row">
  {items.map((i) => (
    <a class={i.live ? "orb live" : "orb"} href={i.href}>
      <b>{i.title}</b>
      <span>{i.line}</span>
      <em>Learn more →</em>
    </a>
  ))}
</div>

<style>
  .orb-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 20px; margin: 28px 0 8px; }
  .orb { aspect-ratio: 1; max-width: 240px; width: 100%; justify-self: center; border-radius: 50%; display: grid; place-content: center; gap: 6px; padding: 22px; text-align: center; text-decoration: none; color: var(--text);
    background: radial-gradient(circle at 34% 28%, var(--orb-hi), var(--orb-lo) 60%);
    border: 1.5px solid var(--glass-edge); box-shadow: 0 30px 60px -40px var(--halo);
    transition: transform .5s var(--spring), border-color .3s, box-shadow .4s; }
  .orb b { font: 400 18px/1.2 var(--display); }
  .orb span { font-size: 13.5px; color: var(--muted); line-height: 1.35; }
  .orb em { font: 600 12.5px var(--sans); font-style: normal; color: var(--accent-text); opacity: 0; transform: translateY(4px); transition: opacity .3s, transform .4s var(--spring); }
  .orb:hover, .orb:focus-visible { transform: scale(1.06); border-color: var(--cherenkov); box-shadow: 0 0 50px -10px rgba(31, 181, 194,.8); }
  .orb:hover em, .orb:focus-visible em { opacity: 1; transform: none; }
  .orb.live { border-color: rgba(69,224,160,.55); }
  @media (hover: none) { .orb em { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .orb, .orb em { transition: none; } }
</style>
