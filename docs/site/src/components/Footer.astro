---
// Starlight's footer (pagination, last-updated), then the project's own:
// the network live, who builds Maya2C, the project's contact (GitHub's private
// advisory form and the repo; security@ returns once its mailbox is verified),
// copyright and licence. Overridden in
// astro.config.mjs (`components.Footer`), so it appears on every page.
import Default from "@astrojs/starlight/components/Footer.astro";
import SourceTip from "./SourceTip.astro";
import { testnet } from "../data/network-state";
import progress from "../../public/progress.json";

const finality = (progress as { finality?: { p50_ms: number } | null }).finality;

const year = new Date().getFullYear();
const REPO = "https://github.com/EricWijesinghe/Maya2C";
---

<Default><slot /></Default>

<footer class="maya-footer" aria-label="About Maya2C">
  <!-- The network, live: what a visitor cares about at the bottom of a page.
       CI and deploy status live on /stats/ (developer transparency), not here. -->
  <div class="maya-footer__pulse" data-fp data-paused={testnet.paused ? "" : undefined} role="group" aria-label={testnet.paused ? "The network, last reading" : "The network, live"}>
    <p class="maya-footer__title">{testnet.paused ? "Network, last reading" : "Network, live"} <SourceTip text="Height: explorer /api/stats. Finality: the newest committed bench (one machine, not a network figure). Peers: status.maya2c.dev /api/live." href="/stats/" /></p>
    <dl>
      <div><dt>Height</dt><dd data-fp-height>{testnet.paused ? `${testnet.last.height.toLocaleString("en-US")} (${testnet.since})` : "—"}</dd></div>
      <div><dt>Finality p50</dt><dd>{finality ? `${(finality.p50_ms / 1000).toFixed(2)} s` : "—"}</dd></div>
      <div><dt>Peers online</dt><dd data-fp-peers>{testnet.paused ? "paused" : "—"}</dd></div>
    </dl>
  </div>
  <div class="maya-footer__about">
    <p class="maya-footer__title">About</p>
    <p>
      Maya2C is built by <a href="https://eric.maya2c.dev" rel="me noopener" target="_blank"><strong>Eric Wijesinghe</strong></a>: a post-quantum
      layer-1 blockchain in Rust, with hybrid ML-DSA + SLH-DSA signatures on
      every transaction.
    </p>
  </div>
  <div class="maya-footer__contact">
    <p class="maya-footer__title">Contact</p>
    {/* The private advisory form first: it reaches the maintainer encrypted and
        tracked. No mailto until the security@ mailbox is verified to receive. */}
    <p><a href={`${REPO}/security/advisories/new`} rel="noopener" target="_blank">Report a vulnerability privately</a></p>
    <p><a href={REPO} rel="noopener" target="_blank">GitHub</a></p>
    <p><a href="/guides/contributors/">Contribute</a></p>
    <p><a href="/guides/security-hall-of-fame/">Security Hall of Fame</a></p>
  </div>
  <p class="maya-footer__legal">
    © {year} Eric Wijesinghe. Code licensed under{" "}
    <a href={`${REPO}/blob/master/LICENSE`}>Apache 2.0</a>.
    Testnet only; the coins have no value.
  </p>
</footer>

<script>
  import { whenNear } from "../scripts/near";
  import { explorerStats, fmt, peers } from "../scripts/live";
  // Fetched only when the footer nears the screen: most visits never get here.
  const fp = document.querySelector<HTMLElement>("[data-fp]");
  // Paused: the hosts are down on purpose, so the dated last reading stays.
  if (fp && !fp.hasAttribute("data-paused")) whenNear(fp, async () => {
    const [s, p] = await Promise.all([explorerStats(), peers()]);
    if (s) fp.querySelector("[data-fp-height]")!.textContent = fmt(s.height);
    if (p && Array.isArray(p.peers)) fp.querySelector("[data-fp-peers]")!.textContent = fmt(p.peers.length);
  });
</script>

<style>
  /* Wraps instead of running into the next column: the paused height carries its date. */
  .maya-footer__pulse dl { margin: 0; display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .maya-footer__pulse dt { font-size: 12px; color: var(--sl-color-gray-3); }
  .maya-footer__pulse dd { white-space: nowrap; margin: 0; font: 500 15px/1.3 var(--sl-font-mono); color: var(--sl-color-white); font-variant-numeric: tabular-nums; }
  .maya-footer__pulse dl > div { display: grid; }
  .maya-footer__pulse .maya-footer__title { display: flex; gap: 8px; align-items: baseline; }
  .maya-footer {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem 2rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .maya-footer p {
    margin: 0 0 0.6rem;
  }
  .maya-footer .maya-footer__title {
    font-weight: 600;
    color: var(--sl-color-white);
    margin-bottom: 0.6rem;
  }
  .maya-footer__legal {
    grid-column: 1 / -1;
    padding-top: 0.75rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .maya-footer a {
    color: var(--sl-color-text-accent);
  }
</style>
