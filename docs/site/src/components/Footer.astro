---
// Starlight's footer (pagination, last-updated), then the project's own, in
// four bands: the mark with one line and who builds it; four link columns by
// reader journey (src/data/site-nav.ts FOOTER, existing pages only); the
// network reading as a chip row; copyright and licence. Overridden in
// astro.config.mjs (`components.Footer`), so it appears on every page.
import Default from "@astrojs/starlight/components/Footer.astro";
import SourceTip from "./SourceTip.astro";
import { testnet } from "../data/network-state";
import { FOOTER, REPO } from "../data/site-nav";
import progress from "../../public/progress.json";

const finality = (progress as { finality?: { p50_ms: number } | null }).finality;

const year = new Date().getFullYear();
---

<Default><slot /></Default>

<footer class="maya-footer not-content" aria-label="About Maya2C">
  <div class="maya-footer__brand">
    <a class="maya-footer__mark" href="/" aria-label="Maya2C home">
      <img src="/brand/orb-sm.svg" width="32" height="32" alt="" loading="lazy" decoding="async" />
      <span translate="no">Maya2C</span>
    </a>
    <p>A post-quantum layer-1 blockchain in Rust, with two signatures on every transaction.</p>
    <p>Built by <a href="https://eric.maya2c.dev" rel="me noopener" target="_blank">Eric Wijesinghe</a> · <a href={REPO} rel="noopener" target="_blank">GitHub</a></p>
  </div>

  <nav class="maya-footer__cols" aria-label="Footer">
    {FOOTER.map((col) => (
      <div>
        <p class="maya-footer__title">{col.title}</p>
        <ul>
          {col.links.map((l) => (
            <li><a href={l.href} {...(l.external ? { rel: "noopener", target: "_blank" } : {})}>{l.label}{l.external && <span class="sr-only"> (opens in a new tab)</span>}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </nav>

  <!-- The network, as chips: what a visitor cares about at the bottom of a page.
       CI and deploy status live on /stats/ (developer transparency), not here. -->
  <div class="maya-footer__pulse" data-fp data-paused={testnet.paused ? "" : undefined} role="group" aria-label={testnet.paused ? "The network, last reading" : "The network, live"}>
    <p class="maya-footer__title">{testnet.paused ? "Last reading" : "Live"} <SourceTip text="Height: explorer /api/stats. Finality: the newest committed bench (one machine, not a network figure). Peers: status.maya2c.dev /api/live." href="/stats/" /></p>
    <dl>
      <div class="chip"><dt>Height</dt><dd data-fp-height>{testnet.paused ? `${testnet.last.height.toLocaleString("en-US")} (${testnet.since})` : "—"}</dd></div>
      {/* A committed bench on one machine, not a network reading: the label says so. */}
      <div class="chip"><dt>Finality p50, bench</dt><dd>{finality ? `${(finality.p50_ms / 1000).toFixed(2)} s` : "—"}</dd></div>
      {/* Paused: a state, not a count, so the label is the network itself. */}
      <div class:list={["chip", { "chip--paused": testnet.paused }]}><dt>{testnet.paused ? "Network" : "Peers online"}</dt><dd data-fp-peers>{testnet.paused ? "paused" : "—"}</dd></div>
    </dl>
  </div>

  <p class="maya-footer__legal">
    © {year} Eric Wijesinghe. Code licensed under{" "}
    <a href={`${REPO}/blob/master/LICENSE`}>Apache 2.0</a>.
    Testnet only; the coins have no value.
  </p>
</footer>

<script>
  import { whenNear } from "../scripts/near";
  import { explorerStats, fmt, peers } from "../scripts/live";
  // Fetched only when the footer nears the screen: most visits never get here.
  const fp = document.querySelector<HTMLElement>("[data-fp]");
  // Paused: the hosts are down on purpose, so the dated last reading stays.
  if (fp && !fp.hasAttribute("data-paused")) whenNear(fp, async () => {
    const [s, p] = await Promise.all([explorerStats(), peers()]);
    if (s) fp.querySelector("[data-fp-height]")!.textContent = fmt(s.height);
    if (p && Array.isArray(p.peers)) fp.querySelector("[data-fp-peers]")!.textContent = fmt(p.peers.length);
  });
</script>

<style>
  .maya-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    /* The forged rule (maya.css), bronze-led here, where the header's is teal-led. */
    background: linear-gradient(90deg, var(--bronze-display), var(--accent) 55%, var(--deco-spark)) top / 100% 2px no-repeat;
    font-size: var(--type-body-sm-size);
    color: var(--text-2);
  }
  .maya-footer p { margin: 0; }
  .maya-footer a { color: var(--text-2); text-decoration: none; }
  .maya-footer a:hover, .maya-footer a:focus-visible { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--accent); }

  .maya-footer__brand { display: grid; gap: var(--space-2); align-content: start; max-width: 32ch; }
  .maya-footer .maya-footer__mark { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; color: var(--text); font: 700 var(--type-title-3-size)/1 var(--font-sans); letter-spacing: -0.015em; }
  .maya-footer .maya-footer__mark:hover { text-decoration: none; }

  /* The footer sits in the content column beside the docs sidebars and full
     width on splash pages, so the columns follow its own width: four across
     wherever they fit, two on a phone. */
  .maya-footer__cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr)); gap: var(--space-6) var(--space-4); }
  .maya-footer__cols ul { list-style: none; margin: 0; padding: 0; display: grid; }
  /* 44 px rows on a phone (the owner's tap-target rule); denser from 60rem. */
  .maya-footer__cols a { display: flex; align-items: center; min-height: 44px; }
  @media (min-width: 60rem) { .maya-footer__cols a { min-height: 32px; } }
  @media (max-width: 59.99rem) {
    .maya-footer__brand a, .maya-footer__legal a, .maya-footer :global(.src-tip__mark) { display: inline-flex; align-items: center; min-height: 44px; }
  }
  .maya-footer .maya-footer__title { margin-bottom: var(--space-2); font-weight: var(--weight-semibold); color: var(--bronze-text); }

  .maya-footer__pulse { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .maya-footer__pulse .maya-footer__title { display: flex; gap: var(--space-2); align-items: baseline; margin: 0; }
  .maya-footer__pulse dl { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip { display: inline-flex; align-items: baseline; gap: var(--space-2); min-height: 32px; padding: var(--space-1) var(--space-3); border: 1px solid var(--border); border-radius: var(--r-pill); background: var(--surface-1); }
  .chip dt { font-size: var(--type-body-sm-size); color: var(--text-2); }
  .chip dd { margin: 0; white-space: nowrap; font: var(--weight-medium) var(--type-body-sm-size)/1.3 var(--font-mono); color: var(--text); font-variant-numeric: tabular-nums; }
  .chip--paused { border-color: color-mix(in srgb, var(--warn) 45%, var(--border)); background: var(--warn-subtle); }
  .chip--paused dd { color: var(--warn); }

  .maya-footer__legal { padding-top: var(--space-4); border-top: 1px solid var(--border); color: var(--text-2); }
</style>
