---
// What the sender of a Maya2C Chat message sees, from the outbox (ADR-074).
// Each stage is a state the app really shows; nothing is simulated.
const stages = [
  { name: "Sending", line: "held in your outbox", tone: "wait" },
  { name: "Waiting", line: "a relay has it, no receipt yet", tone: "wait" },
  { name: "Delivered", line: "the recipient's signed receipt arrived", tone: "done" },
];
---

<figure class="delivery" aria-label="Delivery states of a sent Maya2C Chat message">
  <ol class="track">
    {stages.map((s, i) => (
      <li class={`stage tone-${s.tone}`}>
        <span class="node" aria-hidden="true">{i + 1}</span>
        <b>{s.name}</b>
        <small>{s.line}</small>
      </li>
    ))}
  </ol>
  <div class="branch">
    <span class="fork" aria-hidden="true"></span>
    <span class="stage tone-expired"><b>Expired</b><small>past its time limit, dismissable</small></span>
  </div>
  <figcaption>
    Receipts are optional: off for everyone, or per contact. The recipient still gets the message.
  </figcaption>
</figure>

<style>
  /* Tokens only (lane L04): the literals here failed AA contrast in light mode. */
  .delivery { margin: 0; display: grid; gap: var(--space-4); }
  .track { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-3); position: relative; }
  .track::before { content: ""; position: absolute; left: 22px; right: 22px; top: 21px; height: 2px; background: linear-gradient(90deg, var(--accent), var(--bronze)); opacity: .5; }
  .stage { position: relative; display: grid; gap: var(--space-1); justify-items: start; }
  /* 44 px nodes: the same steps pattern as ContributeFlow. */
  .node { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--surface-2); border: 2px solid var(--accent); color: var(--text); font: var(--weight-semibold) var(--type-body-lg-size)/1 var(--font-mono); }
  .tone-done .node { background: var(--accent-grad-from); color: var(--on-accent); }
  .stage b { font-weight: var(--weight-semibold); }
  .stage small, .delivery figcaption { color: var(--text-2); font-size: var(--type-body-sm-size); line-height: var(--type-body-sm-line); }
  .branch { display: flex; align-items: center; gap: var(--space-3); padding-left: 22px; }
  .fork { width: var(--space-8); height: 0; border-top: 2px dashed var(--bronze); opacity: .7; }
  .tone-expired b { color: var(--bronze); }
  .delivery figcaption { margin: 0; }
</style>
