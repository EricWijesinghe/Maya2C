---
// The chain in the centre and the apps around it. Each app is detached by
// design: it talks to the chain through the gateway or its own protocol and
// never links the node. `status` says what is true today.
const apps = [
  { name: "Maya Chat", note: "PQ messenger", status: "built", href: "/guides/chat" },
  { name: "Wallet", note: "CLI + desktop", status: "built", href: "/guides/wallet" },
  { name: "SDKs", note: "TS · Python · Go", status: "built", href: "https://github.com/EricWijesinghe/Maya2C" },
  { name: "Gateway", note: "REST · GraphQL", status: "built", href: "/guides/api" },
  { name: "Explorer", note: "blocks · accounts", status: "built", href: "https://explorer.maya2c.dev" },
  { name: "Identity", note: "proof of personhood", status: "research", href: "/reference/identity" },
  { name: "Governance", note: "representative", status: "planned", href: "/reference/governance" },
  { name: "AI chat", note: "on-device", status: "planned", href: "/reference/ai-services" },
];
const r = 186;
const placed = apps.map((a, i) => {
  const t = (i / apps.length) * Math.PI * 2 - Math.PI / 2;
  return { ...a, x: 250 + r * Math.cos(t), y: 250 + r * Math.sin(t) };
});
---

<figure class="eco">
  <svg viewBox="0 0 500 500" role="img" aria-labelledby="eco-t">
    <title id="eco-t">The Maya2C chain with the applications built on it, and which of them exist today</title>
    <defs>
      <radialGradient id="eco-core">
        <stop offset="0" stop-color="#b3c8ff" stop-opacity="0.9" />
        <stop offset="1" stop-color="#7c6cff" stop-opacity="0.15" />
      </radialGradient>
    </defs>
    <circle cx="250" cy="250" r={r} class="orbit" />
    {placed.map((a) => <line x1="250" y1="250" x2={a.x} y2={a.y} class={`spoke ${a.status}`} />)}
    <circle cx="250" cy="250" r="62" fill="url(#eco-core)" class="core" />
    <text x="250" y="246" class="core-t">Maya2C</text>
    <text x="250" y="266" class="core-s">post-quantum L1</text>
    {
      placed.map((a) => (
        <a href={a.href} class={`app ${a.status}`}>
          <g>
            <circle cx={a.x} cy={a.y} r="48" />
            <text x={a.x} y={a.y - 3} class="app-t">{a.name}</text>
            <text x={a.x} y={a.y + 13} class="app-s">{a.note}</text>
          </g>
        </a>
      ))
    }
  </svg>
  <figcaption>
    <span class="key built">built and tested</span>
    <span class="key research">research</span>
    <span class="key planned">planned</span>
  </figcaption>
</figure>

<style>
  .eco { margin: 1.5rem auto 2.5rem; max-width: 34rem; }
  svg { width: 100%; height: auto; overflow: visible; }
  .orbit { fill: none; stroke: var(--sl-color-hairline); stroke-dasharray: 3 7; }
  .spoke { stroke-width: 1.5; stroke-dasharray: 5 9; animation: flow 4s linear infinite; }
  .spoke.built { stroke: var(--cherenkov); }
  .spoke.research { stroke: var(--iris-a); opacity: 0.6; }
  .spoke.planned { stroke: var(--muted); opacity: 0.4; animation: none; }
  .core { animation: breathe 5s ease-in-out infinite; transform-origin: 250px 250px; }
  .core-t { fill: var(--text); font-weight: 800; font-size: 20px; text-anchor: middle; }
  .core-s { fill: var(--cherenkov-hi); font-size: 11px; text-anchor: middle; }
  .app { text-decoration: none; cursor: pointer; }
  .app circle { fill: var(--sl-color-bg); stroke-width: 2; transition: transform 0.35s cubic-bezier(.34,1.56,.64,1), filter 0.3s ease; transform-box: fill-box; transform-origin: center; filter: drop-shadow(0 0 0px rgba(91, 140, 255, 0)); }
  .app:hover circle, .app:focus circle { transform: scale(1.15); filter: drop-shadow(0 0 12px rgba(91, 140, 255, 0.6)); }
  .app.research:hover circle, .app.research:focus circle { filter: drop-shadow(0 0 12px rgba(124, 108, 255, 0.5)); }
  .app.built circle { stroke: var(--cherenkov); }
  .app.research circle { stroke: var(--iris-a); stroke-dasharray: 4 3; }
  .app.planned circle { stroke: var(--muted); stroke-dasharray: 2 4; }
  .app-t { fill: var(--text); font-size: 11.5px; font-weight: 700; text-anchor: middle; }
  .app-s { fill: var(--muted); font-size: 8px; text-anchor: middle; }
  figcaption { display: flex; gap: 1.25rem; justify-content: center; flex-wrap: wrap; font-size: 0.85rem; color: var(--muted); }
  .key::before { content: ""; display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 50%; margin-right: 0.4rem; vertical-align: -0.05rem; border: 2px solid; }
  .key.built::before { border-color: var(--cherenkov); }
  .key.research::before { border-color: var(--iris-a); border-style: dashed; }
  .key.planned::before { border-color: var(--muted); border-style: dotted; }
  @keyframes flow { to { stroke-dashoffset: -28; } }
  @keyframes breathe { 50% { transform: scale(1.06); } }
</style>
