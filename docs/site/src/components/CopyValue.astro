---
// A long value (hash, address, multiaddr) that never runs off a phone: the
// middle is elided on screen, the whole value is what a screen reader hears
// and what the Copy button copies. Without JavaScript the button stays
// hidden and the full value is still selectable in the title.
interface Props {
  value: string;
  /** Spoken name, e.g. "genesis SHA-256". */
  label: string;
  head?: number;
  tail?: number;
}
const HEAD = 10;
const TAIL = 8;
const { value, label, head = HEAD, tail = TAIL } = Astro.props;
const short = value.length > head + tail + 1 ? `${value.slice(0, head)}…${value.slice(-tail)}` : value;
---

<span class="cv">
  <code class="cv-value" title={value}><span aria-hidden="true">{short}</span><span class="cv-sr">{value}</span></code>
  <button type="button" class="cv-copy" data-copy={value} aria-label={`Copy ${label}`} hidden>Copy</button>
</span>

<script>
  const COPIED_MS = 1600;
  document.querySelectorAll<HTMLButtonElement>(".cv-copy").forEach((btn) => {
    if (!navigator.clipboard) return;
    btn.hidden = false;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Select it";
      }
      setTimeout(() => (btn.textContent = "Copy"), COPIED_MS);
    });
  });
</script>

<style>
  .cv { display: inline-flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); max-width: 100%; }
  .cv-value { white-space: nowrap; }
  .cv-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .cv-copy { min-height: 44px; min-width: 44px; padding: 0 var(--space-3); border: 1px solid var(--border-strong); border-radius: var(--r-md); background: var(--surface-2); color: var(--text); font: var(--weight-medium) var(--type-body-sm-size)/1 var(--font-sans); cursor: pointer; }
  .cv-copy:hover { background: var(--surface-3); }
  .cv-copy:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
