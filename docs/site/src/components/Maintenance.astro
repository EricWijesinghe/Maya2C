---
// Network notice: one dismissible line at the top of the pages whose content
// depends on the live testnet. It replaced a full-screen "down for
// maintenance" overlay (L02): a blocked page hid the docs, the proof and the
// downloads to say one thing, and on a phone it read as an error.
//
// One pause message per page, in one look: the notice wears the home hero's
// chip (pill, hairline, mono, a dot), and it is skipped on the pages that
// carry their own pause card (/stats/, /health/) and on the home page, whose
// hero chip already says it. On a phone it is one line with a "details" link.
//
// Three states, all pointing at /health/ for the detail:
//   paused       the testnet is stopped on purpose (src/data/network-state.ts).
//                Rendered by the server, so it is there on first paint.
//   halted       not paused, and status.maya2c.dev says no blocks.
//   unavailable  not paused, and status.maya2c.dev does not answer. That is an
//                outage of the status host, not news about the chain, and the
//                notice says so instead of reporting a halt.
// The two live states are set by the script after a poll and hidden again when
// blocks flow, so nobody has to redeploy the site. Dismissing hides it for the
// rest of the browser session; the inline head script copies the dismissal
// onto <html> before paint, so it never flashes.
import { testnet } from "../data/network-state";

// Pages that show live figures or tell the reader to connect to the testnet.
const NETWORK_PAGES = [
  "/",
  "/stats/",
  "/health/",
  "/experience/",
  "/guides/testnet/",
  "/guides/help-run/",
  "/guides/start-mining/",
  "/guides/mining/",
  "/guides/validators/",
];
// Pages that state the pause themselves (hero chip, "Paused on purpose" card).
// A halt is still news there.
const OWN_PAUSE_MESSAGE = ["/", "/stats/", "/health/"];
const path = Astro.url.pathname.replace(/\/?$/, "/");
const show = NETWORK_PAGES.includes(path) && !(testnet.paused && OWN_PAUSE_MESSAGE.includes(path));
const onHealth = path === "/health/";
---

{show && (
  <aside
    class="maya-notice not-content"
    data-notice={testnet.paused ? "paused" : "halted"}
    hidden={!testnet.paused}
    aria-label="Network notice"
    data-pagefind-ignore
  >
    <span class="maya-notice__dot" aria-hidden="true"></span>
    <p class="maya-notice__text" role="status">
      {testnet.paused ? (
        <><b>Testnet paused</b> since <span class="maya-notice__date">{testnet.since}</span><span class="maya-notice__more">; figures here are the last reading</span></>
      ) : (
        <><b data-notice-head>Testnet not producing blocks</b> <span class="maya-notice__more" data-notice-detail>right now</span></>
      )}
      {!onHealth && <> · <a class="maya-notice__go" href="/health/">details</a></>}
    </p>
    <button type="button" class="maya-notice__close" data-notice-close aria-label="Dismiss network notice">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </aside>
)}

<style is:global>
  .maya-notice {
    --tone: var(--bronze-display);
    display: flex; align-items: center; gap: var(--space-2);
    /* Sits in <main> above the content panels: line up with their padding. */
    width: fit-content; max-width: calc(100% - 2 * var(--sl-content-pad-x, var(--space-4)));
    margin: var(--space-3) var(--sl-content-pad-x, var(--space-4)) 0; padding: 0 0 0 var(--space-3);
    border: 1px solid color-mix(in srgb, var(--tone) 40%, var(--border));
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--tone) 8%, var(--surface-1));
    color: var(--text-2);
    font: var(--type-mono-weight) var(--type-body-sm-size)/1.4 var(--font-mono);
  }
  .maya-notice[data-notice="halted"] { --tone: var(--warn); }
  .maya-notice[data-state="unavailable"] { --tone: var(--steel); }
  .maya-notice[hidden],
  :root[data-notice-dismissed="paused"] .maya-notice[data-notice="paused"],
  :root[data-notice-dismissed="halted"] .maya-notice[data-notice="halted"] { display: none; }
  .maya-notice__dot { flex: none; width: 8px; height: 8px; border-radius: var(--r-pill); background: var(--tone); }
  .maya-notice[data-notice="halted"]:not([data-state="unavailable"]) .maya-notice__dot { animation: maya-notice-pulse 1.6s var(--ease) infinite; }
  .maya-notice__text { flex: 1 1 auto; min-width: 0; margin: 0 !important; padding-block: var(--space-2); }
  .maya-notice__text b { color: var(--text); font-weight: var(--weight-medium); }
  .maya-notice__date { white-space: nowrap; font-variant-numeric: var(--font-numeric); }
  .maya-notice__go { color: var(--accent-text); white-space: nowrap; }
  .maya-notice__close {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
    border: 0; border-radius: var(--r-pill); background: transparent; color: var(--text-2); cursor: pointer;
  }
  .maya-notice__close:hover { background: var(--surface-2); color: var(--text); }
  /* Phones: just "Testnet paused since <date> · details" and the close button
     (one line from about 390 px; it wraps once on the narrowest screens rather
     than cutting off the link). */
  @media (max-width: 36rem) {
    .maya-notice { border-radius: var(--r-lg); }
    .maya-notice__more { display: none; }
  }
  /* A ring leaving the dot: the check is live and still finding nothing. */
  @keyframes maya-notice-pulse { from { box-shadow: 0 0 0 0 color-mix(in srgb, var(--tone) 55%, transparent); } to { box-shadow: 0 0 0 8px transparent; } }
  @media (prefers-reduced-motion: reduce) { .maya-notice__dot { animation: none !important; } }
</style>

<script>
  import { testnet } from "../data/network-state";
  const STATUS_URL = "https://status.maya2c.dev/api/status";
  const POLL_MS = 20_000;
  const TIMEOUT_MS = 8_000;

  type Status = { halted_now: boolean; height: number; since_last_block: number };

  const notice = document.querySelector<HTMLElement>(".maya-notice");
  const state = notice?.dataset.notice;
  let timer: ReturnType<typeof setInterval> | undefined;

  notice?.querySelector("[data-notice-close]")?.addEventListener("click", () => {
    notice.hidden = true;
    if (timer) clearInterval(timer);
    document.documentElement.dataset.noticeDismissed = state;
    try { sessionStorage.setItem("maya-notice", state ?? ""); } catch { /* private mode: hidden until reload */ }
  });

  const quiet = (secs: number) =>
    secs < 60 ? `${secs} s` : secs < 3600 ? `${Math.floor(secs / 60)} min` : `${Math.floor(secs / 3600)} h ${Math.floor((secs % 3600) / 60)} min`;

  const valid = (j: unknown): Status | null => {
    const o = j as Partial<Status> | null;
    return o && typeof o.halted_now === "boolean" && Number.isFinite(o.height) && Number.isFinite(o.since_last_block) && o.since_last_block! >= 0
      ? (o as Status) : null;
  };

  async function check(el: HTMLElement) {
    let s: Status | null = null;
    try {
      const r = await fetch(STATUS_URL, { cache: "no-store", signal: AbortSignal.timeout(TIMEOUT_MS) });
      // A partial or malformed answer counts as no answer: never "NaN s".
      if (r.ok) s = valid(await r.json());
    } catch { /* unreachable or not JSON: reported as the status host being down, below */ }
    const head = el.querySelector("[data-notice-head]");
    const detail = el.querySelector("[data-notice-detail]");
    if (!s) {
      // The status host is down; that says nothing about whether blocks flow.
      el.dataset.state = "unavailable";
      if (head) head.textContent = "Network status unavailable";
      if (detail) detail.textContent = "status.maya2c.dev does not answer";
      el.hidden = false;
      return;
    }
    delete el.dataset.state;
    if (head) head.textContent = "Testnet not producing blocks";
    if (detail) detail.textContent = `since block ${s.height.toLocaleString("en-US")}, quiet for ${quiet(s.since_last_block)}`;
    el.hidden = !s.halted_now;
  }

  const dismissed = document.documentElement.dataset.noticeDismissed === state;
  if (notice && state === "halted" && !testnet.paused && !dismissed) {
    check(notice);
    timer = setInterval(() => check(notice), POLL_MS);
  }
</script>
