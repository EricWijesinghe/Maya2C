---
// Network notice: one dismissible strip at the top of the pages whose content
// depends on the live testnet. It replaced a full-screen "down for
// maintenance" overlay (L02): a blocked page hid the docs, the proof and the
// downloads to say one thing, and on a phone it read as an error.
//
// Two states, both pointing at /health/ for the detail:
//   paused  the testnet is stopped on purpose (src/data/network-state.ts).
//           Rendered by the server, so it is there on first paint.
//   halted  not paused, but status.maya2c.dev says no blocks, or does not
//           answer. Shown by the script after a poll; hidden again when
//           blocks flow, so nobody has to redeploy the site.
// Dismissing hides it for the rest of the browser session; the inline head
// script copies the dismissal onto <html> before paint, so it never flashes.
import { testnet } from "../data/network-state";

// Pages that show live figures or tell the reader to connect to the testnet.
const NETWORK_PAGES = [
  "/",
  "/stats/",
  "/health/",
  "/experience/",
  "/guides/testnet/",
  "/guides/help-run/",
  "/guides/start-mining/",
  "/guides/mining/",
  "/guides/validators/",
];
const path = Astro.url.pathname.replace(/\/?$/, "/");
// The home hero already states the pause in its own chip; a second line would
// repeat it above the headline. A halt is still news there.
const show = NETWORK_PAGES.includes(path) && !(testnet.paused && path === "/");
const onHealth = path === "/health/";
---

{show && (
  <aside
    class="maya-notice not-content"
    data-notice={testnet.paused ? "paused" : "halted"}
    hidden={!testnet.paused}
    aria-label="Network notice"
    data-pagefind-ignore
  >
    <span class="maya-notice__dot" aria-hidden="true"></span>
    <p class="maya-notice__text" role="status">
      {testnet.paused ? (
        <><b>Testnet paused</b> since <span class="maya-notice__date">{testnet.since}</span>. Figures on this page are the last reading.</>
      ) : (
        <><b>Testnet not producing blocks</b> <span data-notice-detail>right now</span>.</>
      )}
    </p>
    {!onHealth && <a class="maya-notice__go" href="/health/">Network health</a>}
    <button type="button" class="maya-notice__close" data-notice-close aria-label="Dismiss network notice">
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    </button>
  </aside>
)}

<style is:global>
  .maya-notice {
    --tone: var(--bronze);
    display: flex; align-items: center; gap: var(--space-3);
    /* Sits in <main> above the content panels: line up with their padding. */
    margin: var(--space-3) var(--sl-content-pad-x, var(--space-4)) 0; padding: var(--space-1) var(--space-1) var(--space-1) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--tone) 35%, var(--border));
    border-inline-start: 3px solid var(--tone);
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--tone) 8%, var(--surface-1));
    box-shadow: var(--shadow-sm);
    color: var(--text-2);
    font: var(--type-body-weight) var(--type-body-size)/var(--line-body) var(--font-sans);
  }
  .maya-notice[data-notice="halted"] { --tone: var(--warn); }
  .maya-notice[hidden],
  :root[data-notice-dismissed="paused"] .maya-notice[data-notice="paused"],
  :root[data-notice-dismissed="halted"] .maya-notice[data-notice="halted"] { display: none; }
  .maya-notice__dot { flex: none; width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--tone); }
  .maya-notice[data-notice="halted"] .maya-notice__dot { background: var(--tone); animation: maya-notice-pulse 1.6s var(--ease) infinite; }
  .maya-notice__text { flex: 1 1 auto; min-width: 0; margin: 0 !important; padding-block: var(--space-2); }
  .maya-notice__text b { color: var(--text); font-weight: var(--weight-semibold); }
  .maya-notice__date { white-space: nowrap; font-variant-numeric: var(--font-numeric); }
  .maya-notice__go {
    flex: none; display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-3);
    border-radius: var(--r-md); color: var(--accent-text); font-weight: var(--weight-medium); text-decoration: none; white-space: nowrap;
  }
  .maya-notice__go:hover { background: var(--surface-2); }
  .maya-notice__close {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
    border: 0; border-radius: var(--r-md); background: transparent; color: var(--text-2); cursor: pointer;
  }
  .maya-notice__close:hover { background: var(--surface-2); color: var(--text); }
  /* Phones: the text takes the first row, the two actions share the second. */
  @media (max-width: 36rem) {
    .maya-notice { flex-wrap: wrap; row-gap: 0; padding-inline-start: var(--space-3); }
    .maya-notice__text { flex-basis: calc(100% - 10px - 44px - 2 * var(--space-3)); }
    .maya-notice__close { order: 2; }
    /* A new flex line has no leading gap: 10 px (the dot) lines the label up with the text. */
    .maya-notice__go { order: 3; margin-inline-start: 10px; }
  }
  /* A ring leaving the dot: the check is live and still finding nothing. */
  @keyframes maya-notice-pulse { from { box-shadow: 0 0 0 0 color-mix(in srgb, var(--tone) 55%, transparent); } to { box-shadow: 0 0 0 8px transparent; } }
  @media (prefers-reduced-motion: reduce) { .maya-notice__dot { animation: none !important; } }
</style>

<script>
  import { testnet } from "../data/network-state";
  const STATUS_URL = "https://status.maya2c.dev/api/status";
  const POLL_MS = 20_000;
  const TIMEOUT_MS = 8_000;

  type Status = { halted_now: boolean; height: number; since_last_block: number };

  const notice = document.querySelector<HTMLElement>(".maya-notice");
  const state = notice?.dataset.notice;
  let timer: ReturnType<typeof setInterval> | undefined;

  notice?.querySelector("[data-notice-close]")?.addEventListener("click", () => {
    notice.hidden = true;
    if (timer) clearInterval(timer);
    document.documentElement.dataset.noticeDismissed = state;
    try { sessionStorage.setItem("maya-notice", state ?? ""); } catch { /* private mode: hidden until reload */ }
  });

  const quiet = (secs: number) =>
    secs < 60 ? `${secs} s` : secs < 3600 ? `${Math.floor(secs / 60)} min` : `${Math.floor(secs / 3600)} h ${Math.floor((secs % 3600) / 60)} min`;

  async function check(el: HTMLElement) {
    let s: Status | null = null;
    try {
      const r = await fetch(STATUS_URL, { cache: "no-store", signal: AbortSignal.timeout(TIMEOUT_MS) });
      if (r.ok) s = (await r.json()) as Status;
    } catch { /* unreachable: the host is down, which is itself the news */ }
    const down = !s || Boolean(s.halted_now);
    const detail = el.querySelector("[data-notice-detail]");
    if (detail) detail.textContent = s ? `since block ${s.height.toLocaleString("en-US")}, quiet for ${quiet(s.since_last_block)}` : "and the status service does not answer";
    el.hidden = !down;
  }

  const dismissed = document.documentElement.dataset.noticeDismissed === state;
  if (notice && state === "halted" && !testnet.paused && !dismissed) {
    check(notice);
    timer = setInterval(() => check(notice), POLL_MS);
  }
</script>
