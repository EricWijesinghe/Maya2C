---
// The supply as the chain reports it (get_supply): units in circulation out of
// every unit genesis issued, and the burned part. Mining rewards are paid from
// a genesis reserve, never minted (ADR-068), so "total" does not grow and the
// ring is circulating / total, computed with BigInt from the 256-bit strings.
// A 3D coin and ring when 3D runs; an SVG ring otherwise; dashes when the
// network does not answer.
import { getImage } from "astro:assets";
import emblem from "../assets/emblem.png";
import SourceTip from "./SourceTip.astro";
const face = await getImage({ src: emblem, width: 256, format: "png" });
const R = 54, C = 2 * Math.PI * R;
---

<figure class="not-content sr" data-sr data-face={face.src} style={`--c:${C}`}>
  <div class="sr-view">
    <svg class="sr-poster" viewBox="0 0 140 140" aria-hidden="true">
      <circle class="track" cx="70" cy="70" r={R} />
      <circle class="arc" cx="70" cy="70" r={R} data-sr-arc />
    </svg>
    <img class="sr-face" src={face.src} width="96" height="96" alt="" aria-hidden="true" />
    <canvas data-sr-canvas aria-hidden="true"></canvas>
  </div>
  <figcaption>
    <p class="sr-big"><b data-sr-pct>—</b> in circulation</p>
    <dl class="sr-rows">
      <div><dt>Circulating</dt><dd data-sr-circ>—</dd></div>
      <div><dt>Issued at genesis</dt><dd data-sr-total>—</dd></div>
      <div><dt>Burned</dt><dd data-sr-burn>—</dd></div>
    </dl>
    <SourceTip text="get_supply on rpc.maya2c.dev: total, circulating and burned base units; whole coins rounded down. Rewards come from a genesis reserve (ADR-068)." href="/guides/api/" />
  </figcaption>
</figure>

<script>
  import { canRun3D, whenNear } from "../scripts/gate3d";
  import { coins, shareBp, supply } from "../scripts/live";
  for (const root of document.querySelectorAll<HTMLElement>("[data-sr]")) {
    whenNear(root, async () => {
      let coin: import("../scripts/scene3d").SupplyCoin | null = null;
      if (canRun3D()) {
        try {
          coin = (await import("../scripts/scene3d")).mountSupplyCoin(root.querySelector("[data-sr-canvas]")!, root.dataset.face!);
          root.classList.add("gl");
        } catch { /* the SVG ring stays */ }
      }
      const s = await supply();
      const circ = s ? shareBp(s.circulating, s.total) : null;
      const burn = s ? shareBp(s.burned, s.total) : null;
      if (!s || circ === null) { coin?.setShare(null, null); return; }
      root.querySelector("[data-sr-pct]")!.textContent = `${(circ / 100).toFixed(2)}%`;
      root.querySelector("[data-sr-circ]")!.textContent = coins(s.circulating) ?? "—";
      root.querySelector("[data-sr-total]")!.textContent = coins(s.total) ?? "—";
      root.querySelector("[data-sr-burn]")!.textContent = coins(s.burned) ?? "—";
      root.style.setProperty("--p", String(circ / 10000));
      root.classList.add("go");
      coin?.setShare(circ / 10000, burn === null ? null : burn / 10000);
    });
  }
</script>

<style>
  .sr { margin: 0; display: grid; grid-template-columns: minmax(0, 220px) 1fr; gap: var(--space-5); align-items: center; }
  .sr-view { position: relative; aspect-ratio: 1; width: 100%; }
  .sr-poster, .sr canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sr-face { position: absolute; left: 50%; top: 50%; width: 46%; height: auto; transform: translate(-50%, -50%); }
  .track, .arc { fill: none; stroke-width: 7; }
  .track { stroke: var(--raised); }
  .arc { stroke: var(--accent); stroke-linecap: round; stroke-dasharray: var(--c); stroke-dashoffset: var(--c); transform: rotate(-90deg); transform-origin: 70px 70px; transition: stroke-dashoffset 1.4s cubic-bezier(.22,1,.36,1); }
  .sr.go .arc { stroke-dashoffset: calc(var(--c) * (1 - var(--p, 0))); }
  .sr.gl .sr-poster, .sr.gl .sr-face { display: none; }
  .sr-big { margin: 0 0 var(--space-3); font-size: 15px; color: var(--text-2); }
  .sr-big b { display: block; font: 300 clamp(30px, 4vw, 44px)/1.05 var(--display); color: var(--text); font-variant-numeric: tabular-nums; }
  .sr-rows { margin: 0 0 var(--space-3); display: grid; gap: 6px; }
  .sr-rows div { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--line); padding-bottom: 4px; }
  .sr-rows dt { color: var(--muted); font-size: 13px; }
  .sr-rows dd { margin: 0; font: 500 13px/1.3 var(--mono); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; text-align: end; }
  @media (max-width: 560px) { .sr { grid-template-columns: 1fr; } .sr-view { max-width: 220px; margin-inline: auto; } }
  @media (prefers-reduced-motion: reduce) { .arc { transition: none; } }
</style>
