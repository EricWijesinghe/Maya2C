---
// One transaction, start to finish, as one graphic: every node is a link to
// the guide that explains that step (it replaced the six feature cards, L03).
// The acronyms the hero leaves out live here, next to what they do.
//
// Two drawings of the same five links: a column for phones, a row from 1024 px.
// The hidden one is display:none, so it is out of the tab order and the
// accessibility tree. When the graphic scrolls into view a dot travels the
// path once and lights each step: an illustration of the order of checks,
// not live data, and it never runs under reduced motion.
//
// The finality figure is the newest committed bench (public/progress.json,
// scripts/gen-progress.mjs), labelled as a single-machine run.
import progress from "../../public/progress.json";

const finality = (progress as { finality?: { p50_ms: number; validators: number } | null }).finality ?? null;
const icon = {
  sign: "M7 11V8a5 5 0 0 1 10 0v3M5 11h14v10H5zM12 15v2",
  check: "M12 3 4 6v6c0 4.4 3.4 8 8 9 4.6-1 8-4.6 8-9V6zM9 12l2 2 4-4",
  gossip: "M4 12h4m8 0h4M8 8l4 4-4 4m8-8-4 4 4 4",
  order: "M6 5a1.5 1.5 0 1 0 0 .01M18 5a1.5 1.5 0 1 0 0 .01M12 19a1.5 1.5 0 1 0 0 .01M6 6.5l5 11M18 6.5l-5 11M7.5 5h9",
  final: "M5 12.5 10 17.5 19 7",
};
const steps = [
  { key: "sign", title: "Sign", lines: ["ML-DSA-65 + SLH-DSA", "both over the same bytes"], href: "/guides/signatures/", tone: "teal" },
  { key: "check", title: "Check", lines: ["both must verify,", "then nonce, balance, fee"], href: "/guides/transactions/", tone: "teal" },
  { key: "gossip", title: "Gossip", lines: ["ML-KEM-1024, with", "ML-KEM-768 as fallback"], href: "/reference/pq-transport/", tone: "steel" },
  { key: "order", title: "Order", lines: ["DAG-BFT: n − f of the", "committee certify it"], href: "/guides/consensus/", tone: "bronze" },
  {
    key: "final", title: "Final", tone: "bronze",
    // Qualified as the consensus guide states it: safety holds while at most f of n validators are faulty.
    lines: finality ? ["holds unless over f of n", "validators are faulty;", `p50 ${finality.p50_ms.toLocaleString("en-US")} ms, one machine`] : ["holds unless over f of n", "validators are faulty;", "finality bench: MISSING"],
    href: "/guides/consensus/#what-finality-means-here",
  },
];
const H = { w: 1000, h: 262, x: (i: number) => 100 + i * 200, y: 76, r: 40 };
const V = { w: 360, h: 540, x: 44, y: (i: number) => 52 + i * 106, r: 30 };
---

<figure class="not-content txp" data-txp aria-labelledby="txp-title">
  <figcaption>
    <h2 id="txp-title" class="home-h2">What happens to a transaction</h2>
    <p class="home-lede">Five steps from your wallet to a final block. Each one opens its guide.</p>
  </figcaption>

  <svg class="row" viewBox={`0 0 ${H.w} ${H.h}`} role="group" aria-label="Transaction path" style={`--travel:${H.x(4) - H.x(0)}px, 0`}>
    <defs>
      <linearGradient id="txp-rail-h" gradientUnits="userSpaceOnUse" x1={H.x(0)} y1={H.y} x2={H.x(4)} y2={H.y}><stop offset="0" class="s-teal" /><stop offset=".5" class="s-steel" /><stop offset="1" class="s-bronze" /></linearGradient>
    </defs>
    <line class="rail" x1={H.x(0)} y1={H.y} x2={H.x(4)} y2={H.y} stroke="url(#txp-rail-h)" />
    {steps.map((s, i) => (
      <a href={s.href} class={`node tone-${s.tone}`} style={`--i:${i}`}>
        <rect class="hit" x={H.x(i) - 96} y="8" width="192" height={H.h - 12} rx="14" />
        <circle class="halo" cx={H.x(i)} cy={H.y} r={H.r + 12} />
        <circle class="disc" cx={H.x(i)} cy={H.y} r={H.r} />
        <path class="ico" d={icon[s.key as keyof typeof icon]} transform={`translate(${H.x(i) - 15.6} ${H.y - 15.6}) scale(1.3)`} />
        {s.key === "sign" && <g class="sigs" aria-hidden="true"><circle class="sig sig-a" cx={H.x(i) + 30} cy={H.y - 30} r="9" /><circle class="sig sig-b" cx={H.x(i) + 42} cy={H.y - 12} r="9" /></g>}
        <text class="t" x={H.x(i)} y={H.y + 82} text-anchor="middle">{s.title}</text>
        {s.lines.map((l, k) => <text class="l" x={H.x(i)} y={H.y + 108 + k * 21} text-anchor="middle">{l}</text>)}
      </a>
    ))}
    <circle class="packet" cx={H.x(0)} cy={H.y} r="7" />
  </svg>

  <svg class="col" viewBox={`0 0 ${V.w} ${V.h}`} role="group" aria-label="Transaction path" style={`--travel:0, ${V.y(4) - V.y(0)}px`}>
    <defs>
      <linearGradient id="txp-rail-v" gradientUnits="userSpaceOnUse" x1={V.x} y1={V.y(0)} x2={V.x} y2={V.y(4)}><stop offset="0" class="s-teal" /><stop offset=".5" class="s-steel" /><stop offset="1" class="s-bronze" /></linearGradient>
    </defs>
    <line class="rail" x1={V.x} y1={V.y(0)} x2={V.x} y2={V.y(4)} stroke="url(#txp-rail-v)" />
    {steps.map((s, i) => (
      <a href={s.href} class={`node tone-${s.tone}`} style={`--i:${i}`}>
        <rect class="hit" x="0" y={V.y(i) - 50} width={V.w} height="100" rx="14" />
        <circle class="halo" cx={V.x} cy={V.y(i)} r={V.r + 9} />
        <circle class="disc" cx={V.x} cy={V.y(i)} r={V.r} />
        <path class="ico" d={icon[s.key as keyof typeof icon]} transform={`translate(${V.x - 12} ${V.y(i) - 12})`} />
        {s.key === "sign" && <g class="sigs" aria-hidden="true"><circle class="sig sig-a" cx={V.x + 23} cy={V.y(i) - 22} r="7" /><circle class="sig sig-b" cx={V.x + 31} cy={V.y(i) - 8} r="7" /></g>}
        <text class="t" x="96" y={V.y(i) - 10}>{s.title}<tspan class="go" dx="8" aria-hidden="true">→</tspan></text>
        {s.lines.map((l, k) => <text class="l" x="96" y={V.y(i) + 14 + k * 19}>{l}</text>)}
      </a>
    ))}
    <circle class="packet" cx={V.x} cy={V.y(0)} r="6" />
  </svg>
</figure>

<script>
  // Arm the one-shot walk only when motion is welcome; without JS, or under
  // reduced motion, every step is simply lit.
  const fig = document.querySelector<HTMLElement>("[data-txp]");
  if (fig && !matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
    fig.classList.add("armed");
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { fig.classList.add("run"); io.disconnect(); }
    }, { threshold: 0.25 });
    io.observe(fig);
  }
</script>

<style>
  .txp { margin: 0; }
  figcaption { margin: 0; }
  svg { display: block; width: 100%; height: auto; overflow: visible; }
  .row { display: none; }
  .col { max-width: 30rem; }
  @media (min-width: 1024px) { .row { display: block; } .col { display: none; } }

  .s-teal { stop-color: var(--accent); }
  .s-steel { stop-color: var(--steel); }
  .s-bronze { stop-color: var(--bronze); }
  /* userSpaceOnUse on the rail gradients: a line has a zero-height box, so a bounding-box gradient paints nothing. */
  .rail { stroke-width: 3; stroke-linecap: round; }

  .node { --tone: var(--accent); cursor: pointer; outline: none; }
  .tone-steel { --tone: color-mix(in srgb, var(--steel) 55%, var(--accent)); }
  .tone-bronze { --tone: var(--bronze); }
  .hit { fill: transparent; stroke: transparent; stroke-width: 2; transition: fill var(--dur-2) var(--ease); }
  .node:hover .hit { fill: color-mix(in srgb, var(--tone) 10%, transparent); }
  .node:focus-visible .hit { stroke: var(--accent); }
  .halo { fill: color-mix(in srgb, var(--tone) 22%, transparent); }
  .disc { fill: color-mix(in srgb, var(--tone) 12%, var(--surface-1)); stroke: var(--tone); stroke-width: 2.5; }
  .ico { fill: none; stroke: var(--tone); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .t { font: var(--weight-semibold) 20px var(--font-sans); fill: var(--text); }
  .col .t { font-size: 18px; }
  .l { font: var(--weight-regular) 15px var(--font-sans); fill: var(--text-2); }
  .col .l { font-size: 14px; }
  .go { fill: var(--tone); }
  .packet { fill: var(--accent); opacity: 0; filter: drop-shadow(0 0 6px var(--accent)); }
  /* The two signatures (ML-DSA teal, SLH-DSA bronze) on the Sign step. */
  .sig { stroke: var(--surface-1); stroke-width: 2.5; }
  .sig-a { fill: var(--accent); }
  .sig-b { fill: var(--bronze); }

  /* The one-shot walk: steps start dim, light as the dot reaches them, then stay lit. */
  .armed .disc { stroke: var(--text-3); }
  .armed .sig { opacity: 0; }
  .armed.run .sig { animation: land .5s var(--ease) both; }
  .armed.run .sig-a { animation-delay: .1s; }
  .armed.run .sig-b { animation-delay: .35s; }
  .armed .ico { stroke: var(--text-3); }
  .armed .halo { opacity: 0; }
  .armed.run .disc, .armed.run .ico { stroke: var(--tone); transition: stroke .45s var(--ease) calc(var(--i) * .65s); }
  .armed.run .halo { animation: light-halo .45s var(--ease) both; animation-delay: calc(var(--i) * .65s); }
  .armed.run .packet { animation: travel 2.6s var(--ease) both; }
  @keyframes light-halo { to { opacity: 1; } }
  @keyframes land { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: none; } }
  @keyframes travel { 0% { opacity: 1; transform: translate(0, 0); } 92% { opacity: 1; transform: translate(var(--travel)); } 100% { opacity: 0; transform: translate(var(--travel)); } }
</style>
