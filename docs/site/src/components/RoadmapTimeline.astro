---
// Interactive roadmap: month lanes of tappable cards, category filters, and
// lane progress counted from each item's status. Data: src/data/roadmap-items.ts.
// Months are targets, not promises; "In review" always carries a real PR link.
import { LANES, CATEGORIES, STATUS_LABEL, REPO_PR, roadmapItems, type Category } from "../data/roadmap-items";
const cats = Object.keys(CATEGORIES) as Category[];
const inLane = (id: string) => roadmapItems.filter((i) => i.lane === id);
const n = (id: string, s: string) => inLane(id).filter((i) => i.status === s).length;
---

<section class="not-content rt" data-rt aria-label="Roadmap timeline">
  <p class="rt-note">Months are targets, not promises. Status is what is true today.</p>
  <div class="rt-filters" role="group" aria-label="Filter by category">
    <button type="button" data-cat="all" aria-pressed="true">All <b>{roadmapItems.length}</b></button>
    {cats.map((c) => (
      <button type="button" data-cat={c} aria-pressed="false">{CATEGORIES[c]} <b>{roadmapItems.filter((i) => i.cat === c).length}</b></button>
    ))}
  </div>

  <ol class="rt-lanes">
    {LANES.map((l) => (
      <li class="lane" data-lane={l.id}>
        <header>
          <h2>{l.title}</h2>
          <p class="sub">{l.sub}</p>
          <div class="bar" role="img" aria-label="Lane progress">
            <i class="seg shipped" style="--w:0%"></i><i class="seg review" style="--w:0%"></i>
          </div>
          <p class="count" data-count data-s={n(l.id, "shipped")} data-r={n(l.id, "review")} data-t={inLane(l.id).length}></p>
        </header>
        <ul class="cards">
          {inLane(l.id).map((i) => (
            <li data-cat={i.cat}>
              <article class={`card ${i.status}`}>
                <button type="button" class="head" aria-expanded="false" aria-controls={`rt-${i.id}`}>
                  <span class="nm">{i.name}</span>
                  <span class={`chip ${i.status}`}>{STATUS_LABEL[i.status]}</span>
                  <span class="cat">{CATEGORIES[i.cat]}</span>
                </button>
                <div class="body" id={`rt-${i.id}`} hidden>
                  <p>{i.what}</p>
                  <p class="oth"><strong>Elsewhere:</strong> {i.others}</p>
                  {i.postGenesis && <p class="pg">Ships after genesis, behind an activation height.</p>}
                  {i.pr && <a class="go" href={`${REPO_PR}${i.pr}`} rel="noopener">Open PR #{i.pr}</a>}
                </div>
              </article>
            </li>
          ))}
        </ul>
        <p class="empty" hidden>Nothing in this lane for that category.</p>
      </li>
    ))}
  </ol>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-rt]")) {
    const filters = [...root.querySelectorAll<HTMLButtonElement>(".rt-filters button")];
    const lanes = [...root.querySelectorAll<HTMLElement>(".lane")];

    const refresh = (cat: string) => {
      for (const lane of lanes) {
        const items = [...lane.querySelectorAll<HTMLElement>(".cards > li")];
        let total = 0, shipped = 0, review = 0;
        for (const li of items) {
          const show = cat === "all" || li.dataset.cat === cat;
          li.hidden = !show;
          if (!show) continue;
          total++;
          const card = li.querySelector(".card")!;
          if (card.classList.contains("shipped")) shipped++;
          else if (card.classList.contains("review")) review++;
        }
        lane.querySelector<HTMLElement>(".empty")!.hidden = total > 0;
        const pct = (x: number) => (total ? (x / total) * 100 : 0).toFixed(1) + "%";
        const [s, r] = lane.querySelectorAll<HTMLElement>(".seg");
        s.style.setProperty("--w", pct(shipped));
        r.style.setProperty("--w", pct(review));
        lane.querySelector<HTMLElement>("[data-count]")!.textContent =
          `${shipped} shipped, ${review} in review, ${total - shipped - review} not started, of ${total}`;
      }
    };

    filters.forEach((f) => f.addEventListener("click", () => {
      filters.forEach((x) => x.setAttribute("aria-pressed", String(x === f)));
      refresh(f.dataset.cat!);
    }));

    root.querySelectorAll<HTMLButtonElement>(".head").forEach((b) => b.addEventListener("click", () => {
      const open = b.getAttribute("aria-expanded") !== "true";
      b.setAttribute("aria-expanded", String(open));
      root.querySelector<HTMLElement>("#" + b.getAttribute("aria-controls"))!.hidden = !open;
    }));

    // Fill the bars once the lanes scroll into view so the growth is visible.
    const run = () => refresh("all");
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { run(); io.disconnect(); } });
      lanes.forEach((l) => io.observe(l));
    } else run();
    // Text counts are useful even before the bars animate.
    lanes.forEach((l) => {
      const c = l.querySelector<HTMLElement>("[data-count]")!;
      const { s, r, t } = c.dataset;
      c.textContent = `${s} shipped, ${r} in review, ${Number(t) - Number(s) - Number(r)} not started, of ${t}`;
    });
  }
</script>

<style>
  .rt { margin: 1.5rem auto 2.5rem; max-width: 62rem; }
  .rt-note { text-align: center; color: var(--muted); font-size: 0.85rem; margin: 0 0 0.75rem; }
  .rt-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 1.25rem; }
  .rt-filters button { background: var(--surface-1); border: 1px solid var(--border-control, var(--text-3)); color: var(--text); border-radius: 999px; padding: 0.4rem 0.9rem; font: inherit; font-size: 0.85rem; cursor: pointer; min-height: 44px; }
  .rt-filters button[aria-pressed="true"] { border-color: var(--cherenkov); box-shadow: 0 0 0 1px var(--cherenkov) inset; }
  .rt-filters b { color: var(--cherenkov-hi); margin-left: 0.25rem; }

  .rt-lanes { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.5rem; }
  .lane { margin: 0; padding-left: 1.1rem; border-left: 2px solid var(--glass-edge); position: relative; }
  .lane::before { content: ""; position: absolute; left: -7px; top: 0.35rem; width: 12px; height: 12px; border-radius: 50%; background: var(--cherenkov); box-shadow: 0 0 0 3px var(--bg), var(--shadow-sm); }
  /* The lit dot is a dark-theme effect; on paper the ring and shadow carry it. */
  :global(:root[data-theme="dark"]) .lane::before { box-shadow: 0 0 0 3px var(--bg), 0 0 0.9rem var(--halo); }
  .lane header h2 { margin: 0; font-size: 1.15rem; border: 0; padding: 0; }
  .sub { margin: 0.1rem 0 0.5rem; color: var(--muted); font-size: 0.85rem; }
  .bar { display: flex; height: 0.5rem; border-radius: 999px; background: var(--well); overflow: hidden; max-width: 22rem; }
  .seg { display: block; height: 100%; width: var(--w); transition: width 1.1s cubic-bezier(.22, .8, .3, 1); }
  .seg.shipped { background: var(--verified); }
  .seg.review { background: var(--cherenkov); }
  .count { margin: 0.35rem 0 0.75rem; font-size: 0.78rem; color: var(--lede); }

  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; grid-template-columns: minmax(0, 1fr); }
  .cards > li { margin: 0; min-width: 0; }
  .cards > li[hidden] { display: none; }
  .card { background: var(--surface-1); border: 1px solid var(--glass-edge); border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-sm); }
  .card.shipped { border-color: color-mix(in srgb, var(--success) 50%, var(--border)); }
  .card.review { border-color: color-mix(in srgb, var(--accent) 55%, var(--border)); }
  .card.design { border-style: dashed; border-color: color-mix(in srgb, var(--bronze) 60%, var(--border)); }
  .card.queued { border-style: dotted; border-color: var(--muted); }
  .head { all: unset; box-sizing: border-box; width: 100%; min-height: 44px; display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.6rem; padding: 0.6rem 0.85rem; cursor: pointer; color: var(--text); transition: background 0.25s; }
  .head:hover { background: var(--nav-hover); }
  .head:focus-visible { outline: 2px solid var(--cherenkov-hi); outline-offset: -2px; }
  .nm { font-weight: 700; font-size: 0.95rem; flex: 1 1 10rem; overflow-wrap: anywhere; }
  .cat { font-size: 0.72rem; color: var(--muted); }
  .chip { font-size: 0.7rem; padding: 0.1rem 0.55rem; border-radius: 999px; border: 1px solid; white-space: nowrap; }
  .chip.shipped { color: var(--verified); border-color: var(--verified); }
  .chip.review { color: var(--cherenkov-hi); border-color: var(--cherenkov); }
  .chip.design { color: var(--gold); border-color: var(--gold); }
  .chip.queued { color: var(--muted); border-color: var(--muted); }
  .body { padding: 0 0.85rem 0.8rem; animation: rise 0.3s ease-out; }
  .body p { margin: 0.3rem 0; font-size: 0.88rem; }
  .oth, .pg { color: var(--lede); font-size: 0.82rem !important; }
  .pg { color: var(--gold); }
  .go { display: inline-flex; align-items: center; margin-top: 0.4rem; min-height: 44px; padding: 0 1rem; border-radius: 999px; background: var(--accent-fill); color: var(--on-accent) !important; font-weight: 700; text-decoration: none; }
  .empty { color: var(--muted); font-size: 0.85rem; }

  @media (min-width: 640px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 980px) { .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { .seg { transition: none; } .body { animation: none; } .head { transition: none; } }
</style>
