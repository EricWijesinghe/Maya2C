---
// Three steps to mining, then the reasons to trust it, each one checkable.
// Steps mirror guides/start-mining; "3 steps", not "3 minutes": building the
// miner from source takes longer, and the one-click Hub is not published yet.
const repo = "https://github.com/EricWijesinghe/Maya2C";
const steps = [
  { n: 1, title: "Check your GPU", line: "One command lists your card and its memory.", code: "maya2c-gpu-miner --list" },
  { n: 2, title: "Get the miner", line: "Build it from the open source today; the one-click Hub is not published yet.", code: "cargo build --release -p maya2c-gpu-miner --features gpu" },
  { n: 3, title: "Start, and stop when you like", line: "It mines to your own key, in a window you can see.", code: "maya2c-gpu-miner --benchmark" },
];
const trust = [
  { title: "Open source", line: "Every line is public under Apache-2.0.", href: repo },
  { title: "Post-quantum, simply", line: "Two NIST-standard signatures on every transaction: break both to forge one.", href: "/guides/signatures/" },
  { title: "External audit pending", line: "Self-review and pre-audit packets are published; no external audit is done yet.", href: "/reference/security-audit/" },
  { title: "Visible and opt-in", line: "Nothing runs hidden, nothing starts on its own.", href: "/guides/start-mining/#safety" },
];
---

<section class="not-content mp" aria-label="Start mining in three steps">
  <ol class="mp-steps">
    {steps.map((s) => (
      <li class="ui-card mp-step" data-tilt>
        <span class="mp-n" aria-hidden="true">{s.n}</span>
        <p class="mp-title">{s.title}</p>
        <p class="mp-line">{s.line}</p>
        <code class="mp-code">{s.code}</code>
      </li>
    ))}
  </ol>
  <p class="mp-cta"><a class="ui-btn ui-btn--primary mp-btn" href="/guides/start-mining/">Start mining</a><span>Free, open source, Windows and Linux.</span></p>
  <ul class="mp-trust">
    {trust.map((t) => (
      <li><a class="ui-card mp-card" href={t.href} data-tilt><b>{t.title}</b><span>{t.line}</span></a></li>
    ))}
  </ul>
</section>

<style>
  .mp { display: grid; gap: var(--space-5); margin: var(--space-5) 0; }
  .mp-steps, .mp-trust { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .mp-steps li, .mp-trust li { margin: 0; }
  .mp-step { position: relative; display: grid; gap: 8px; align-content: start; padding: var(--space-5) var(--space-4) var(--space-4); }
  .mp-n { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font: 700 16px/1 var(--display); background: var(--accent); color: var(--on-accent); }
  .mp-title { margin: 0; font: 600 17px/1.25 var(--display); color: var(--text); }
  .mp-line { margin: 0; font-size: 14px; color: var(--text-2); }
  .mp-code { font-size: 12px; overflow-wrap: anywhere; color: var(--accent-text); }
  .mp-cta { margin: 0; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; color: var(--text-2); font-size: 14px; }
  .mp-btn { min-height: 52px; padding-inline: 32px; font-size: 17px; text-decoration: none; }
  .mp-card { display: grid; gap: 6px; height: 100%; padding: var(--space-4); text-decoration: none; color: var(--text-2); font-size: 14px; }
  .mp-card b { color: var(--text); font: 600 16px/1.25 var(--display); }
  .mp-card:hover b, .mp-card:focus-visible b { color: var(--accent-text); }
</style>
