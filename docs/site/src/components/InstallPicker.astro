---
// The CUDA-style OS picker: computer › version or chip › (per guide: processor,
// method), and a numbered walkthrough that changes with the choices. Each
// guide's rows and steps live in src/data/ (install-matrix.ts, build-matrix.ts).
//
// Every combination is rendered here at build time and the script only shows
// one, so no HTML is built in the browser (the site's CSP allows no
// unhashed script, and nothing here needs one) and the page reads correctly
// without JavaScript: the default walkthrough is visible. The choice lives in
// the URL (?os=linux&v=fedora&arch=arm64&m=manual), so a helper can send a
// friend a link that opens on their computer's steps.
import { buildGuide } from "../data/build-matrix";
import { joinGuide } from "../data/install-matrix";

interface Props {
  /** `join`: install a testnet node (Help run). `build`: build from source (Quickstart). */
  guide: "join" | "build";
}
const { guide: guideId } = Astro.props;
const guide = { join: joinGuide, build: buildGuide }[guideId];
const DEFAULT = guide.defaultKey;
const { combos, rows } = guide;

const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
// `**bold**` and `` `code` `` only; the text is ours, escaped first anyway.
const inline = (s: string) =>
  esc(s)
    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
    .replace(/`(.+?)`/g, "<code>$1</code>");
const rowId = (name: string, group?: string) => `ip-${guideId}-${name}-${group ?? "all"}`;
---

<section class="ip not-content" data-guide={guideId} data-default={DEFAULT} aria-label="Choose your computer">
  <div class="ip-rows">
    {
      rows.map((r) => (
        <div class="ip-row" data-row={r.name} data-group={r.group ?? ""} hidden={r.group ? r.group !== "windows" : false}>
          <span class="ip-label" id={rowId(r.name, r.group)}>{r.label}</span>
          <div class="ip-opts" role="radiogroup" aria-labelledby={rowId(r.name, r.group)}>
            {r.choices.map((c, i) => (
              <button type="button" role="radio" class="ip-opt" data-value={c.id} aria-checked={i === 0 ? "true" : "false"}>
                <span class="ip-opt-name">{c.label}</span>
                {c.hint && <span class="ip-opt-hint">{c.hint}</span>}
              </button>
            ))}
          </div>
          {r.help && <p class="ip-help" set:html={inline(r.help)} />}
        </div>
      ))
    }
  </div>

  <div class="ip-bar">
    <div class="ip-progress" aria-live="polite">
      <div class="ip-meter"><span class="ip-meter-fill"></span></div>
      <span class="ip-count">0 of 0 steps done</span>
    </div>
    <label class="ip-guided"><input type="checkbox" class="ip-guided-toggle" /> One step at a time</label>
  </div>

  {
    combos.map(({ key, w }) => (
      <div class="ip-walk" data-combo={key} hidden={key !== DEFAULT} data-tab={w.tab} data-pagefind-ignore={key !== DEFAULT ? "" : undefined}>
        {w.unavailable ? (
          <p class="ip-unavailable" set:html={inline(w.unavailable)} />
        ) : (
          <ol class="ip-steps">
            {w.steps.map((s, i) => (
              <li class="ip-step" data-step={i}>
                <div class="ip-step-head">
                  <span class="ip-num" aria-hidden="true">{i + 1}</span>
                  <h3 class="ip-step-title">{s.title}</h3>
                  <label class="ip-done"><input type="checkbox" class="ip-done-box" /> Done</label>
                </div>
                {s.body?.map((p) => <p set:html={inline(p)} />)}
                {s.command && (
                  <div class="ip-cmd">
                    <pre><code data-lang={s.lang}>{s.command}</code></pre>
                    <button type="button" class="ip-copy" aria-label={`Copy: ${s.title}`}>Copy</button>
                  </div>
                )}
                {s.after && <p class="ip-after" set:html={inline(s.after)} />}
                <div class="ip-nav">
                  {i > 0 && <button type="button" class="ip-back">Back</button>}
                  {i < w.steps.length - 1 ? (
                    <button type="button" class="ip-next">Next step</button>
                  ) : (
                    <span class="ip-last">{guide.lastStepNote}</span>
                  )}
                </div>
              </li>
            ))}
          </ol>
        )}
      </div>
    ))
  }
</section>

<script>
  import { initInstallPicker } from "../scripts/install-picker";
  document.querySelectorAll<HTMLElement>(".ip").forEach(initInstallPicker);
</script>

<style>
  /* Restyled on the kit (U3, 2026-11-13; the design critique called the
     tinted panel and pill buttons out of place): a flat surface, segmented
     choices, and the walkthrough as a numbered rail. Tokens only. */
  .ip { margin-block: var(--space-6); padding: var(--space-5); border: 1px solid var(--border); border-radius: var(--r-lg); background: var(--surface-1); box-shadow: var(--shadow-inset); }
  /* not-content opts out of Starlight's prose spacing; the few text styles needed are here. */
  .ip :where(p) { margin: 0; line-height: 1.6; color: var(--text-2); font-size: var(--type-body-size); }
  .ip :where(p code, .ip-help code) { font-family: var(--font-mono); font-size: .85em; padding: .1em .35em; border-radius: var(--r-xs); background: var(--surface-2); border: 1px solid var(--border); }
  .ip :where(strong) { color: var(--text); }
  .ip-rows { display: grid; gap: var(--space-4); }
  .ip-row[hidden] { display: none; }
  .ip-label { display: block; margin-bottom: var(--space-2); font: var(--type-label-weight) var(--type-label-size)/var(--type-label-line) var(--type-label-font); color: var(--text-2); }
  .ip-opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: var(--space-2); }
  .ip-opt { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-height: 44px; padding: var(--space-2) var(--space-3); border: 1px solid var(--border-strong); border-radius: var(--r-md); background: var(--surface-2); color: var(--text); font: inherit; text-align: left; cursor: pointer; transition: border-color var(--dur-1) var(--ease), background-color var(--dur-1) var(--ease); }
  .ip-opt:hover { background: var(--surface-3); }
  .ip-opt[aria-checked="true"] { border-color: var(--accent); background: var(--accent-subtle); box-shadow: 0 0 0 1px var(--accent) inset; }
  .ip-opt:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ip-opt-name { font-weight: var(--weight-medium); font-size: var(--type-body-size); }
  .ip-opt-hint { font-size: var(--type-body-sm-size); color: var(--text-2); }
  .ip-help { margin-top: var(--space-2) !important; font-size: var(--type-body-sm-size) !important; }

  .ip-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3); margin: var(--space-5) 0 var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--border); }
  .ip-progress { display: flex; align-items: center; gap: var(--space-3); flex: 1 1 14rem; }
  .ip-meter { flex: 1; height: 4px; border-radius: var(--r-pill); background: var(--surface-3); overflow: hidden; }
  .ip-meter-fill { display: block; height: 100%; width: 0; background: var(--accent); transition: width var(--dur-3) var(--ease); }
  .ip-count { font-size: var(--type-body-sm-size); color: var(--text-2); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .ip-guided { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--type-body-sm-size); color: var(--text-2); cursor: pointer; white-space: nowrap; }
  .ip input[type="checkbox"] { accent-color: var(--accent); }

  .ip-walk[hidden] { display: none; }
  /* The rail: one hairline behind the numbers, from the first step to the last. */
  .ip-steps { list-style: none; padding: 0; margin: 0; display: grid; position: relative; }
  .ip-step { position: relative; margin: 0; padding: 0 0 var(--space-6) calc(28px + var(--space-4)); }
  .ip-step::before { content: ""; position: absolute; left: 13px; top: 28px; bottom: 0; width: 1px; background: var(--border-strong); }
  .ip-step:last-child { padding-bottom: 0; }
  .ip-step:last-child::before { display: none; }
  .ip-step-head { display: flex; align-items: center; gap: var(--space-3); min-height: 28px; }
  .ip-num { position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 28px; height: 28px; border-radius: var(--r-pill); border: 1px solid var(--border-strong); background: var(--surface-2); color: var(--text); font: var(--weight-semibold) var(--type-body-sm-size)/1 var(--font-mono); }
  .ip-step.is-done .ip-num { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .ip-step.is-done .ip-step-title { color: var(--text-2); }
  .ip-step-title { margin: 0 !important; flex: 1; font: var(--weight-semibold) var(--type-body-lg-size)/1.35 var(--font-sans) !important; color: var(--text); }
  .ip-done { display: inline-flex; align-items: center; gap: var(--space-1); font-size: var(--type-body-sm-size); color: var(--text-2); cursor: pointer; white-space: nowrap; }
  .ip-step > p { margin-top: var(--space-2); }
  .ip-after { font-size: var(--type-body-sm-size) !important; }
  .ip-cmd { position: relative; margin-top: var(--space-3); }
  .ip-cmd pre { margin: 0; padding: var(--space-3) 5rem var(--space-3) var(--space-4); border-radius: var(--r-md); background: var(--surface-2); border: 1px solid var(--border); overflow-x: auto; white-space: pre-wrap; word-break: break-all; }
  .ip-cmd code { font: var(--type-mono-size)/1.6 var(--font-mono); color: var(--text); background: none; padding: 0; border: 0; }
  .ip-copy { position: absolute; top: var(--space-2); right: var(--space-2); height: var(--control-h-sm); padding: 0 var(--space-2); border: 1px solid var(--border-strong); border-radius: var(--r-sm); background: var(--surface-1); color: var(--text-2); font: var(--weight-medium) var(--type-body-sm-size)/1 var(--font-sans); cursor: pointer; transition: color var(--dur-1) var(--ease), background-color var(--dur-1) var(--ease); }
  .ip-copy:hover { color: var(--text); background: var(--surface-3); }
  .ip-copy.is-copied { color: var(--success); border-color: color-mix(in srgb, var(--success) 40%, transparent); }
  .ip-nav { display: none; margin-top: var(--space-3); gap: var(--space-2); align-items: center; flex-wrap: wrap; }
  .ip-nav button { height: var(--control-h); padding: 0 var(--space-3); border-radius: var(--r-md); border: 1px solid var(--border-strong); background: var(--surface-2); color: var(--text); font: var(--weight-medium) var(--type-body-size)/1 var(--font-sans); cursor: pointer; }
  .ip-nav .ip-next { border-color: var(--accent-grad-to); background: linear-gradient(180deg, var(--accent-grad-from), var(--accent-grad-to)); color: var(--on-accent); }
  .ip-last { font-size: var(--type-body-sm-size); color: var(--text-2); }
  .ip.is-guided .ip-step { display: none; }
  .ip.is-guided .ip-step.is-current { display: block; padding-bottom: 0; }
  .ip.is-guided .ip-step.is-current::before { display: none; }
  .ip.is-guided .ip-nav { display: flex; }
  .ip-unavailable { padding: var(--space-3) var(--space-4); border-radius: var(--r-md); border: 1px solid color-mix(in srgb, var(--warn) 40%, var(--border)); background: color-mix(in srgb, var(--warn) 7%, var(--surface-1)); color: var(--text) !important; }
  @media (max-width: 560px) { .ip { padding: var(--space-4); } .ip-opts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
