{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./target/**)",
      "Read(./**/target/**)",
      "Read(./wallet-gui/ui/dist/**)",
      "Read(./dashboard/dist/**)",
      "Read(./docs/site/dist/**)",
      "Read(./docs/site/node_modules/**)",
      "Read(./node_modules/**)",
      "Read(./.git/**)",
      "Read(./fuzz/corpus/**)",
      "Read(./fuzz/artifacts/**)",
      "Read(./logo-assets/**)",
      "Read(./data/**)",
      "Read(./.terraform/**)",
      "Read(./Cargo.lock)",
      "Read(./**/*.lock)",
      "Read(./**/*.log)",
      "Read(./**/*.png)",
      "Read(./**/*.jpg)",
      "Read(./**/*.ico)",
      "Read(./**/*.wasm)"
    ],
    "allow": [
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(rg:*)",
      "Bash(ast-grep:*)",
      "Bash(scc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(sed -n:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(find:*)"
    ]
  }
}