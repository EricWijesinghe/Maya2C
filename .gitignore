# Rust build output.
/target/
/apps/wallet-gui/src-tauri/target/
# The fuzz crate is its own workspace root, so it builds into its own tree.
/fuzz/target/

# Fuzzing artifacts.
#
# `corpus/` is deliberately tracked: seeds are generated by the real encoders
# (`cargo run --bin gen_corpus`) and minimized crash inputs are promoted into it
# by hand, so it is reviewable in a diff and it is what keeps a fixed bug from
# coming back. `artifacts/` is the opposite â€” raw crash inputs the fuzzer dumps
# as it finds them. Those are uploaded from CI and promoted deliberately.
/fuzz/artifacts/
/fuzz/coverage/

# Terraform.
#
# `.terraform/` is a provider cache — it holds a ~700 MB vendored provider
# binary per platform, and `terraform init` rebuilds it from the lock file on
# any machine. `.terraform.lock.hcl` is the opposite: it pins the provider
# versions everyone resolves to and belongs in version control, so it is
# deliberately not ignored here.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Terraform variable files routinely carry account ids, project names, and
# occasionally credentials. The example file is the one meant to be shared.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Node identities. A seed's key file is the identity every bootnode address in
# the fleet points at; it belongs in a secret store, never in a repository.
node_key
*.node_key
/seeds/

# Local chain state written by deploy.sh and docker-compose.
/data/
genesis.json
# Except the public testnet genesis the site serves for joiners.
!docs/site/public/testnet/genesis.json

# rustc internal compiler error dumps.
rustc-ice-*.txt

# Editor and OS noise.
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code workspace
.claude/settings.local.json
.claude/memory.json
.serena/
*.bak-*

# The browser dashboard is its own workspace (Leptos only targets wasm32),
# so it has its own target dir, and `trunk` writes the bundle to dist/.
/apps/dashboard/target/
/apps/dashboard/dist/

# The wallet frontend is a nested Cargo workspace, so `/target/` above does not
# reach it and its build output has been committed: 4978 files that churn on
# every `trunk build`. This stops it growing; the already-tracked files need an
# explicit `git rm -r --cached apps/wallet-gui/ui/target` to actually leave the repo.
/apps/wallet-gui/ui/target/
/apps/wallet-gui/ui/dist/

# The docs site is a Node project inside docs/. Its content collection is
# generated from docs/*.md by scripts/ingest.mjs on every build.
/docs/site/node_modules/
/docs/site/dist/
/docs/site/.astro/

# Crates with their own `[workspace]` table build into their own `target/`.
# Listed one by one rather than as a blanket `target/`, because
# `target-contracts/` is a different directory and is tracked on purpose.
/apps/ledger-maya2c/target/
/contracts/token-swap/target/
/apps/dashboard/target/
/hal/ebpf-net/programs/target/
# Within target-contracts/ only the built modules are kept (tests load them
# without a wasm toolchain); cargo's scratch directories are not.
/target-contracts/wasm32-unknown-unknown/release/.fingerprint/
/target-contracts/wasm32-unknown-unknown/release/deps/

# The example firmware is its own workspace.
/hal/iot-firmware/target/

# Session handoff notes are per-machine working state.
/.claude/session-handoff.md

# Written by scripts/configure_environment.sh. The .age file is encrypted, but
# it is still per-operator state and never belongs in the repository; the two
# generated configs carry operator-specific (non-secret) values.
.env.production*
infra/terraform/terraform.tfvars
infra/ansible/inventory/production.ini

# cargo-mutants output (reports/08-security.md quotes the summary)
mutants.out/
mutants.out.old/
/dist/

# Python bytecode, written by every local SDK test run.
__pycache__/
*.pyc
