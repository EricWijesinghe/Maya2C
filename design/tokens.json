{
  "$comment": "Forged Light 2 (ADR-136, docs/design/forged-light-2.md §3). The single source of the design tokens: `cargo xtask design-tokens` writes tokens.css into every surface and `--check` fails CI when a copy drifts. Keys under each group are custom-property names without the leading `--`; nested groups join with `-` (type.type-body.size -> --type-body-size). Keys starting with `$` are comments. A new colour role is a change here with a contrast pair below, never a literal in a surface's stylesheet.",

  "theme": {
    "$comment": "Dark is the brand's home theme and the default when the OS states no preference.",
    "dark": {
      "bg": "#050b0f",
      "surface": "#0c171d",
      "raised": "#12232b",
      "line": "rgb(150 226 232 / 0.14)",
      "text": "#eef3f3",
      "text-2": "#b9c6ca",
      "muted": "#8a9ca3",
      "accent": "#2cc3cf",
      "accent-text": "#8ff0f5",
      "on-accent": "#04171b",
      "bronze": "#d9b97a",
      "bronze-text": "#e8cf98",
      "success": "#4fe3a5",
      "warning": "#f0bc63",
      "danger": "#ff7a6b",
      "info": "#8fb4ff",
      "glass": "rgb(12 23 29 / 0.72)",
      "shadow-1": "0 1px 2px rgb(0 0 0 / .4)",
      "shadow-2": "0 24px 60px -28px rgb(0 0 0 / .8)"
    },
    "light": {
      "bg": "#f5f8f8",
      "surface": "#ffffff",
      "raised": "#e9f0f1",
      "line": "rgb(14 116 128 / 0.16)",
      "text": "#0b1a1f",
      "text-2": "#324449",
      "muted": "#5a6b71",
      "accent": "#0a7682",
      "accent-text": "#085f69",
      "on-accent": "#ffffff",
      "bronze": "#7d5a22",
      "bronze-text": "#6b4b16",
      "success": "#0b7a52",
      "warning": "#8c5204",
      "danger": "#b4291a",
      "info": "#2f55b8",
      "glass": "rgb(255 255 255 / 0.78)",
      "shadow-1": "0 1px 2px rgb(10 40 46 / .08)",
      "shadow-2": "0 24px 60px -30px rgb(10 60 70 / .3)"
    }
  },

  "global": {
    "font": {
      "font-display": "\"Manrope Variable\", \"Manrope\", system-ui, sans-serif",
      "font-body": "\"Inter Variable\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "font-mono": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, Consolas, monospace"
    },
    "type": {
      "$comment": "One scale for every surface; `size-phone` is the phone step where the spec gives one. No text under 12 px; label is the only uppercase style; weight 300 is retired.",
      "type-display-1": { "size": "56px", "size-phone": "40px", "line": "1.04", "weight": "720", "font": "var(--font-display)" },
      "type-display-2": { "size": "40px", "size-phone": "30px", "line": "1.1", "weight": "650", "font": "var(--font-display)" },
      "type-title-1": { "size": "28px", "line": "1.2", "weight": "650", "font": "var(--font-display)" },
      "type-title-2": { "size": "20px", "line": "1.3", "weight": "620", "font": "var(--font-display)" },
      "type-body-lg": { "size": "17px", "line": "1.7", "weight": "400", "font": "var(--font-body)" },
      "type-body": { "size": "15px", "line": "1.55", "weight": "400", "font": "var(--font-body)" },
      "type-body-sm": { "size": "13px", "line": "1.5", "weight": "400", "font": "var(--font-body)" },
      "type-label": { "size": "12px", "line": "1.2", "weight": "600", "font": "var(--font-body)", "tracking": ".08em" },
      "type-mono": { "size": "13px", "line": "1.5", "weight": "450", "font": "var(--font-mono)" },
      "type-num": { "weight": "600", "font": "var(--font-display)" }
    },
    "space": {
      "space-1": "4px",
      "space-2": "8px",
      "space-3": "12px",
      "space-4": "16px",
      "space-5": "24px",
      "space-6": "32px",
      "space-7": "48px",
      "space-8": "64px",
      "space-9": "96px",
      "gutter": "max(16px, 4vw)",
      "content-max": "1180px",
      "docs-column": "72ch",
      "wallet-column": "34rem"
    },
    "radius": {
      "r-1": "8px",
      "r-2": "12px",
      "r-3": "20px",
      "r-pill": "999px"
    },
    "elevation": {
      "$comment": "flat = surface + line (every card); raised = hover and selected; floating = glass + shadow-2 (header, popovers, the one hero card per screen).",
      "elevation-flat": "none",
      "elevation-raised": "var(--shadow-1)",
      "elevation-floating": "var(--shadow-2)",
      "glass-blur": "blur(16px)"
    },
    "motion": {
      "dur-1": "120ms",
      "dur-2": "240ms",
      "dur-3": "480ms",
      "dur-pulse": "2.4s",
      "ease-out": "cubic-bezier(.22, 1, .36, 1)",
      "ease-spring": "cubic-bezier(.34, 1.56, .64, 1)",
      "loop": "infinite"
    },
    "chart": {
      "$comment": "Series in order. Status colours are never series colours. Fills are the stroke at chart-fill-alpha.",
      "chart-1": "var(--accent)",
      "chart-2": "var(--bronze)",
      "chart-3": "var(--text-2)",
      "chart-4": "var(--success)",
      "chart-5": "var(--info)",
      "chart-fill-alpha": "18%",
      "chart-grid": "var(--line)",
      "chart-axis": "var(--muted)"
    }
  },

  "reduced-motion": {
    "$comment": "prefers-reduced-motion: reduce. Durations become 1 ms, not 0 and not `animation: none`, so end states still apply; loops run once.",
    "dur-1": "1ms",
    "dur-2": "1ms",
    "dur-3": "1ms",
    "dur-pulse": "1ms",
    "loop": "1"
  },

  "contrast-pairs": {
    "$comment": "[foreground, background, use]: every pair a component renders, checked in both themes by the xtask test (WCAG 2.x). use is text (4.5:1), large-text or non-text (3:1).",
    "pairs": [
      ["text", "bg", "text"],
      ["text", "surface", "text"],
      ["text", "raised", "text"],
      ["text-2", "bg", "text"],
      ["text-2", "surface", "text"],
      ["text-2", "raised", "text"],
      ["muted", "bg", "text"],
      ["muted", "surface", "text"],
      ["muted", "raised", "text"],
      ["accent-text", "bg", "text"],
      ["accent-text", "surface", "text"],
      ["accent-text", "raised", "text"],
      ["bronze-text", "bg", "text"],
      ["bronze-text", "surface", "text"],
      ["success", "bg", "text"],
      ["success", "surface", "text"],
      ["warning", "bg", "text"],
      ["warning", "surface", "text"],
      ["danger", "bg", "text"],
      ["danger", "surface", "text"],
      ["info", "bg", "text"],
      ["info", "surface", "text"],
      ["on-accent", "accent", "text"],
      ["on-accent", "bronze", "text"],
      ["accent", "bg", "non-text"],
      ["accent", "surface", "non-text"],
      ["bronze", "bg", "non-text"]
    ]
  }
}
