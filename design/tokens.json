{
  "$comment": "Forged Light 2, revised 2026-11-13 to the developer-tool look (ADR-136). The single source of the design tokens: `cargo xtask design-tokens` writes tokens.css into every surface and `--check` fails CI when a copy drifts. Keys under each group are custom-property names without the leading `--`; nested groups join with `-` (type.type-body.size -> --type-body-size). Keys starting with `$` are comments. A new colour role is a change here with a contrast pair below, never a literal in a surface's stylesheet.",

  "theme": {
    "$comment": "Dark is the brand's home theme and the default when the OS states no preference. surface-1 is a card, surface-2 a raised control or hover row, surface-3 a pressed or selected one. text-3 measures 3.4 to 4.2:1, so it is for hints, placeholders and large text only, never body copy. accent-text is the link and accent-label colour: the light accent is 3.5 to 4.0:1, enough for rings and fills, not for text. The accent-grad stops are the primary button and are the same in both themes.",
    "dark": {
      "bg": "#08090b",
      "surface-1": "#0e1013",
      "surface-2": "#14171b",
      "surface-3": "#1b1f24",
      "border": "rgb(255 255 255 / 0.08)",
      "border-strong": "rgb(255 255 255 / 0.14)",
      "text": "#edeef0",
      "text-2": "#a1a7b0",
      "text-3": "#6b727c",
      "accent": "#3bc9b5",
      "accent-hover": "#5fe0cd",
      "accent-subtle": "rgb(59 201 181 / 0.12)",
      "accent-text": "#3bc9b5",
      "accent-grad-from": "#3bc9b5",
      "accent-grad-to": "#2faf9e",
      "accent-highlight": "rgb(255 255 255 / 0.18)",
      "on-accent": "#08090b",
      "bronze": "#c8935a",
      "steel": "#8a9bb0",
      "success": "#3fb950",
      "warn": "#d29922",
      "danger": "#f85149",
      "glass": "rgb(14 16 19 / 0.8)",
      "shadow-sm": "0 1px 2px rgb(0 0 0 / 0.4)",
      "shadow-md": "0 1px 2px rgb(0 0 0 / 0.4), 0 8px 24px -8px rgb(0 0 0 / 0.5)",
      "shadow-lg": "0 2px 4px rgb(0 0 0 / 0.4), 0 24px 48px -12px rgb(0 0 0 / 0.6)",
      "shadow-inset": "inset 0 1px 0 rgb(255 255 255 / 0.06)"
    },
    "light": {
      "bg": "#fbfbfc",
      "surface-1": "#ffffff",
      "surface-2": "#f6f7f9",
      "surface-3": "#eef0f3",
      "border": "rgb(0 0 0 / 0.08)",
      "border-strong": "rgb(0 0 0 / 0.14)",
      "text": "#0b0d10",
      "text-2": "#4b5563",
      "text-3": "#6b7280",
      "accent": "#0e8f80",
      "accent-hover": "#0a7468",
      "accent-subtle": "rgb(14 143 128 / 0.1)",
      "accent-text": "#0a7468",
      "accent-grad-from": "#3bc9b5",
      "accent-grad-to": "#2faf9e",
      "accent-highlight": "rgb(255 255 255 / 0.18)",
      "on-accent": "#08090b",
      "bronze": "#9a6a33",
      "steel": "#5b6b80",
      "success": "#1a7f37",
      "warn": "#9a6700",
      "danger": "#cf222e",
      "glass": "rgb(255 255 255 / 0.8)",
      "shadow-sm": "0 1px 2px rgb(0 0 0 / 0.13)",
      "shadow-md": "0 1px 2px rgb(0 0 0 / 0.13), 0 8px 24px -8px rgb(0 0 0 / 0.17)",
      "shadow-lg": "0 2px 4px rgb(0 0 0 / 0.13), 0 24px 48px -12px rgb(0 0 0 / 0.2)",
      "shadow-inset": "inset 0 1px 0 rgb(255 255 255 / 0.02)"
    }
  },

  "global": {
    "font": {
      "$comment": "Inter for everything (variable, self-hosted, opsz axis); JetBrains Mono for code, addresses, hashes and figures. Manrope is retired.",
      "font-sans": "\"Inter Variable\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "font-mono": "\"JetBrains Mono Variable\", \"JetBrains Mono\", ui-monospace, Consolas, monospace",
      "font-numeric": "tabular-nums"
    },
    "type": {
      "$comment": "One scale for every surface: 12/13/14/16/20/24/32/40/56. Weights 400/500/600 only. Body 1.5, headings 1.2; display sizes track -0.02em. `size-phone` is the phone step, taken from the same scale.",
      "type-display-1": { "size": "56px", "size-phone": "40px", "line": "1.2", "weight": "600", "font": "var(--font-sans)", "tracking": "-0.02em" },
      "type-display-2": { "size": "40px", "size-phone": "32px", "line": "1.2", "weight": "600", "font": "var(--font-sans)", "tracking": "-0.02em" },
      "type-title-1": { "size": "32px", "size-phone": "24px", "line": "1.2", "weight": "600", "font": "var(--font-sans)", "tracking": "-0.02em" },
      "type-title-2": { "size": "24px", "line": "1.2", "weight": "600", "font": "var(--font-sans)", "tracking": "-0.01em" },
      "type-title-3": { "size": "20px", "line": "1.2", "weight": "600", "font": "var(--font-sans)", "tracking": "-0.01em" },
      "type-body-lg": { "size": "16px", "line": "1.5", "weight": "400", "font": "var(--font-sans)" },
      "type-body": { "size": "14px", "line": "1.5", "weight": "400", "font": "var(--font-sans)" },
      "type-body-sm": { "size": "13px", "line": "1.5", "weight": "400", "font": "var(--font-sans)" },
      "type-label": { "size": "12px", "line": "1.5", "weight": "500", "font": "var(--font-sans)" },
      "type-mono": { "size": "13px", "line": "1.5", "weight": "400", "font": "var(--font-mono)" },
      "weight-regular": "400",
      "weight-medium": "500",
      "weight-semibold": "600",
      "line-body": "1.5",
      "line-heading": "1.2",
      "tracking-display": "-0.02em"
    },
    "space": {
      "$comment": "4 px base; the step number is px / 4.",
      "space-1": "4px",
      "space-2": "8px",
      "space-3": "12px",
      "space-4": "16px",
      "space-5": "20px",
      "space-6": "24px",
      "space-8": "32px",
      "space-10": "40px",
      "space-12": "48px",
      "space-16": "64px",
      "space-20": "80px",
      "space-24": "96px",
      "gutter": "max(16px, 4vw)",
      "content-max": "1180px",
      "docs-column": "72ch",
      "wallet-column": "34rem",
      "control-h": "34px",
      "control-h-sm": "28px"
    },
    "radius": {
      "$comment": "Nothing above 12 px. The pill is for status dots and chips only, never a button or card.",
      "r-xs": "4px",
      "r-sm": "6px",
      "r-md": "8px",
      "r-lg": "12px",
      "r-pill": "999px"
    },
    "elevation": {
      "$comment": "flat = surface + border (every card); raised = shadow-md + shadow-inset on hover and selected; floating = glass + shadow-lg (header and the command palette only).",
      "elevation-flat": "none",
      "elevation-raised": "var(--shadow-md)",
      "elevation-floating": "var(--shadow-lg)",
      "glass-blur": "blur(12px)"
    },
    "motion": {
      "$comment": "Short, linear-feeling, no spring or overshoot.",
      "dur-1": "120ms",
      "dur-2": "180ms",
      "dur-3": "240ms",
      "ease": "cubic-bezier(.2, 0, 0, 1)"
    },
    "chart": {
      "$comment": "Series in order. Status colours are never series colours. Fills are the stroke at chart-fill-alpha.",
      "chart-1": "var(--accent)",
      "chart-2": "var(--steel)",
      "chart-3": "var(--bronze)",
      "chart-4": "var(--text-2)",
      "chart-5": "var(--text-3)",
      "chart-fill-alpha": "16%",
      "chart-grid": "var(--border)",
      "chart-axis": "var(--text-3)"
    }
  },

  "reduced-motion": {
    "$comment": "prefers-reduced-motion: reduce zeroes every duration; end states still apply.",
    "dur-1": "0ms",
    "dur-2": "0ms",
    "dur-3": "0ms"
  },

  "contrast-pairs": {
    "$comment": "[foreground, background, use]: every pair a component renders, checked in both themes by the xtask test (WCAG 2.x). use is text (4.5:1), large-text or non-text (3:1). Translucent roles (border, accent-subtle, glass) are not measurable on their own and are not listed.",
    "pairs": [
      ["text", "bg", "text"],
      ["text", "surface-1", "text"],
      ["text", "surface-2", "text"],
      ["text", "surface-3", "text"],
      ["text-2", "bg", "text"],
      ["text-2", "surface-1", "text"],
      ["text-2", "surface-2", "text"],
      ["text-2", "surface-3", "text"],
      ["accent-text", "bg", "text"],
      ["accent-text", "surface-1", "text"],
      ["accent-text", "surface-2", "text"],
      ["accent-text", "surface-3", "text"],
      ["steel", "bg", "text"],
      ["steel", "surface-1", "text"],
      ["steel", "surface-2", "text"],
      ["bronze", "bg", "text"],
      ["bronze", "surface-1", "text"],
      ["success", "bg", "text"],
      ["success", "surface-1", "text"],
      ["success", "surface-2", "text"],
      ["warn", "bg", "text"],
      ["warn", "surface-1", "text"],
      ["warn", "surface-2", "text"],
      ["danger", "bg", "text"],
      ["danger", "surface-1", "text"],
      ["danger", "surface-2", "text"],
      ["on-accent", "accent", "text"],
      ["on-accent", "accent-grad-from", "text"],
      ["on-accent", "accent-grad-to", "text"],
      ["text-3", "bg", "large-text"],
      ["text-3", "surface-1", "large-text"],
      ["text-3", "surface-2", "large-text"],
      ["text-3", "surface-3", "large-text"],
      ["accent", "bg", "non-text"],
      ["accent", "surface-1", "non-text"],
      ["accent", "surface-2", "non-text"],
      ["accent", "surface-3", "non-text"]
    ]
  }
}
